{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "transform": [
        {"type": "calc", "as": "v", "expr": {"*": [{"+": ["@value"]}, 0.1]}},
        {"type": "mean", "column": "v", "as": "avg"}
    ],
    "source": "Source: <a href=\"https://www.ecad.eu/\">ECA&amp;D</a>, the original charts on <a href=\"https://ecad.abteil.org/\">ecad.abteil.org</a>",
    "height": 150,
    "margins": {"top": 26, "right": 36, "bottom": 24, "left": 62},
    "locale": {"base": "en", "number": {"currency": ["", " °C"]}},
    "globals": {"year": "2023"},
    "controls": [
        {
            "type": "slider",
            "global": "year",
            "name": "Year",
            "id": "year",
            "values": {"column": "date"}
        }
    ],
    "dims": {
        "x": {
            "column": "date",
            "format": "d",
            "scale": {"pad": [0, 0]},
            "axis": {"position": "top", "ticks": 5},
            "grid": true
        },
        "y": {
            "column": "v",
            "format": "$.1f",
            "scale": {"pad": [0, 0]},
            "axis": {"ticks": 3},
            "grid": true
        },
        "avg": {"column": "avg", "scale": {"of": "y"}, "hover": {"format": "$.1f"}}
    },
    "marks": [
        {"type": "line", "id": "line", "stroke": "#444", "stroke-width": 1.5},
        {
            "type": "line",
            "id": "avg",
            "y": "avg",
            "stroke": "#9cb806",
            "stroke-width": 1.5,
            "stroke-opacity": 0.5
        }
    ],
    "annotations": [
        {
            "type": "line",
            "x": "@year",
            "label": "{year}",
            "props": {"stroke": "#444", "stroke-width": 2}
        }
    ]
}
