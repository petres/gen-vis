{
    "options": {
        "coord": "polar",
        "height": { "steps": ["@totalWidth", { "0": 440, "700": 640 }] },
        "margins": { "top": 34, "right": 40, "bottom": 34, "left": 40 },
        "locale": { "base": "en", "number": { "currency": ["", " °C"] } },
        "footer": "Source: <a href=\"https://www.ecad.eu/\">ECA&amp;D</a>, the original charts on <a href=\"https://ecad.abteil.org/\">ecad.abteil.org</a>",
        "hover": {
            "filter": { "year": "@year" },
            "side": "center",
            "title": "<span style=\"font-weight: normal\">{date},</span><br>{title}",
            "row": "<div style=\"display: grid; grid-template-columns: auto auto; column-gap: 14px; text-align: center; margin-top: 3px\"><span style=\"font-weight: normal; font-size: 11px\">{year}</span><span style=\"font-weight: normal; font-size: 11px\">avg.</span><span>{t}</span><span style=\"font-weight: normal\">{mean}</span></div><div style=\"text-align: center; margin-top: 4px\"><span style=\"font-weight: normal; font-size: 11px\">diff.</span><br>{diff}</div>"
        }
    },
    "globals": { "year": "2023", "smooth": "avg15", "type": "rel", "r": "diff", "c": "zero", "hi": "hiRel", "lo": "loRel" },
    "transform": [
        { "type": "year", "column": "date", "as": "year" },
        { "type": "align", "column": "date", "as": "day" },
        { "type": "calc", "as": "t", "expr": { "*": [{ "+": ["@{smooth}"] }, 0.1] } },
        { "type": "mean", "column": "t", "by": "day", "as": "clim" },
        { "type": "calc", "as": "diff", "expr": { "-": ["@t", "@clim"] } },
        { "type": "calc", "as": "zero", "expr": { "*": [{ "+": ["@clim"] }, 0] } },
        { "type": "calc", "as": "hi", "expr": { "max": ["@t", "@clim"] } },
        { "type": "calc", "as": "lo", "expr": { "min": ["@t", "@clim"] } },
        { "type": "calc", "as": "hiRel", "expr": { "max": ["@diff", "@zero"] } },
        { "type": "calc", "as": "loRel", "expr": { "min": ["@diff", "@zero"] } }
    ],
    "formElements": [
        { "id": "year", "name": "Year", "ref": "year", "type": "select", "values": { "column": "year" } },
        { "id": "smooth", "name": "Mean of", "ref": "smooth", "type": "select", "values": [
            { "id": "avg365", "name": "a year", "value": "avg365" },
            { "id": "avg31", "name": "a month", "value": "avg31" },
            { "id": "avg15", "name": "2 weeks", "value": "avg15" },
            { "id": "avg7", "name": "a week", "value": "avg7" },
            { "id": "value", "name": "a day", "value": "value" }
        ] },
        { "id": "type", "name": "Values", "ref": "type", "type": "radio", "values": [
            { "id": "abs", "name": "absolute", "value": "abs", "globals": { "r": "t", "c": "clim", "hi": "hi", "lo": "lo" },
                "patch": { "mapping": { "y": { "axis": { "format": "$.0f" } } } } },
            { "id": "rel", "name": "relative to the mean", "value": "rel", "globals": { "r": "diff", "c": "zero", "hi": "hiRel", "lo": "loRel" },
                "patch": { "mapping": { "y": { "axis": { "format": "+$.0f" } } } } }
        ] }
    ],
    "mapping": {
        "x": {
            "column": "day", "domain": ["2020-01-01", "2021-01-01"],
            "scale": { "type": "utc" },
            "axis": { "ticks": 12, "format": "%B", "grid": true, "padding": 6,
                "labels": { "curved": "between", "props": { "font-weight": "bold", "font-size": 12 } } },
            "hover": { "format": "%e %B" }
        },
        "y": {
            "column": "{r}",
            "type": "numeric",
            "scale": { "range": [{ "*": ["@radius", 0.22] }, "@radius"] },
            "axis": { "ticks": 6, "grid": true, "format": "+$.0f",
                "labels": { "props": { "font-size": 10, "fill": "#555", "stroke-width": 4, "stroke-opacity": 0.6 } } }
        },
        "clim": { "column": "{c}", "scale": { "of": "y" } },
        "hi": { "column": "{hi}", "scale": { "of": "y" } },
        "lo": { "column": "{lo}", "scale": { "of": "y" } },
        "t": { "column": "t", "hover": { "format": "$.1f" } },
        "mean": { "column": "clim", "hover": { "format": "$.1f" } },
        "diff": { "column": "diff", "hover": { "format": "+$.1f" } },
        "year": { "column": "year", "fromData": true },
        "date": { "column": "date", "hover": { "format": "%A" } }
    },
    "plot": [
        {
            "id": "years",
            "type": "line",
            "by": "year",
            "props": { "stroke": "#999", "stroke-opacity": 0.12 }
        },
        {
            "id": "above",
            "type": "area",
            "filter": { "year": "@year" },
            "props": { "fill": "#f23c06", "d": { "innerRadius": "@clim:scaled", "outerRadius": "@hi:scaled" }, "fill-opacity": 0.25 }
        },
        {
            "id": "below",
            "type": "area",
            "filter": { "year": "@year" },
            "props": { "fill": "#35d3da", "d": { "innerRadius": "@lo:scaled", "outerRadius": "@clim:scaled" }, "fill-opacity": 0.25 }
        },
        {
            "id": "mean", "type": "line", "filter": { "year": "@year" },
            "props": { "stroke": "#9cb806", "stroke-width": 2, "stroke-opacity": 0.8, "d": { "radius": "@clim:scaled" } }
        },
        {
            "id": "selected", "type": "line", "filter": { "year": "@year" },
            "props": { "stroke": "#444", "stroke-width": 1.5 }
        },
        {
            "id": "mean-points",
            "type": "circle",
            "filter": { "year": "@year" },
            "by": "year",
            "props": { "radius": "@clim:scaled", "r": 0, "fill": "#9cb806", "fill-opacity": 0.8 },
            "highlight": { "mode": "row", "r": 4 }
        },
        {
            "id": "points",
            "type": "circle",
            "filter": { "year": "@year" },
            "by": "year",
            "props": { "r": 0, "fill": "#444", "fill-opacity": 0.8 },
            "highlight": { "mode": "row", "r": 4 }
        }
    ]
}
