{
    "options": {
        "coord": "polar",
        "height": { "prop": "steps", "ref": "totalWidth", "steps": [{ "cut": 0, "value": 440 }, { "cut": 700, "value": 640 }] },
        "margins": { "top": 34, "right": 40, "bottom": 34, "left": 40 },
        "locale": { "base": "en", "number": { "currency": ["", " °C"] } },
        "footer": "Source: <a href=\"https://www.ecad.eu/\">ECA&amp;D</a>, the original charts on <a href=\"https://ecad.abteil.org/\">ecad.abteil.org</a>",
        "hover": {
            "filter": { "year": "@year" },
            "side": "center",
            "title": "<span style=\"font-weight: normal\">{date},</span><br>{title}",
            "row": "<div style=\"display: grid; grid-template-columns: auto auto; column-gap: 14px; text-align: center; margin-top: 3px\"><span style=\"font-weight: normal; font-size: 11px\">{year}</span><span style=\"font-weight: normal; font-size: 11px\">avg.</span><span>{t}</span><span style=\"font-weight: normal\">{mean}</span></div><div style=\"text-align: center; margin-top: 4px\"><span style=\"font-weight: normal; font-size: 11px\">diff.</span><br>{diff}</div>"
        }
    },
    "globals": { "year": "2023", "smooth": "avg15", "type": "rel", "r": "diff", "c": "zero", "hi": "hiRel", "lo": "loRel" },
    "transform": [
        { "type": "year", "column": "date", "as": "year" },
        { "type": "align", "column": "date", "as": "day" },
        { "type": "calc", "op": "multiply", "columns": ["{smooth}"], "scale": 0.1, "as": "t" },
        { "type": "mean", "column": "t", "by": "day", "as": "clim" },
        { "type": "calc", "op": "subtract", "columns": ["t", "clim"], "as": "diff" },
        { "type": "calc", "op": "multiply", "columns": ["clim"], "scale": 0, "as": "zero" },
        { "type": "calc", "op": "max", "columns": ["t", "clim"], "as": "hi" },
        { "type": "calc", "op": "min", "columns": ["t", "clim"], "as": "lo" },
        { "type": "calc", "op": "max", "columns": ["diff", "zero"], "as": "hiRel" },
        { "type": "calc", "op": "min", "columns": ["diff", "zero"], "as": "loRel" }
    ],
    "formElements": [
        { "id": "year", "name": "Year", "ref": "year", "type": "select", "values": { "column": "year" } },
        { "id": "smooth", "name": "Mean of", "ref": "smooth", "type": "select", "values": [
            { "id": "avg365", "name": "a year", "value": "avg365" },
            { "id": "avg31", "name": "a month", "value": "avg31" },
            { "id": "avg15", "name": "2 weeks", "value": "avg15" },
            { "id": "avg7", "name": "a week", "value": "avg7" },
            { "id": "value", "name": "a day", "value": "value" }
        ] },
        { "id": "type", "name": "Values", "ref": "type", "type": "radio", "values": [
            { "id": "abs", "name": "absolute", "value": "abs", "globals": { "r": "t", "c": "clim", "hi": "hi", "lo": "lo" },
                "patch": { "mapping": { "y": { "axis": { "format": "$.0f" } } } } },
            { "id": "rel", "name": "relative to the mean", "value": "rel", "globals": { "r": "diff", "c": "zero", "hi": "hiRel", "lo": "loRel" },
                "patch": { "mapping": { "y": { "axis": { "format": "+$.0f" } } } } }
        ] }
    ],
    "mapping": {
        "x": {
            "column": "day", "type": "date",
            "scale": { "type": "utc", "orientation": "angular", "domain": ["2020-01-01", "2021-01-01"] },
            "axis": { "position": "angular", "ticks": 12, "format": "%B", "grid": true, "padding": 6,
                "labels": { "props": { "font-weight": "bold", "font-size": 12 } } },
            "hover": { "format": "%e %B" }
        },
        "y": {
            "column": "{r}", "type": "numeric",
            "scale": { "orientation": "radial", "range": [{ "prop": "relative", "ref": "radius", "ratio": 0.22 }, "@radius"] },
            "axis": { "position": "radial", "ticks": 6, "grid": true, "format": "+$.0f",
                "labels": { "props": { "font-size": 10, "fill": "#555", "stroke-width": 4, "stroke-opacity": 0.6 } } }
        },
        "clim": { "column": "{c}", "type": "numeric", "scale": { "of": "y" } },
        "hi": { "column": "{hi}", "type": "numeric", "scale": { "of": "y" } },
        "lo": { "column": "{lo}", "type": "numeric", "scale": { "of": "y" } },
        "t": { "column": "t", "type": "numeric", "hover": { "format": "$.1f" } },
        "mean": { "column": "clim", "type": "numeric", "hover": { "format": "$.1f" } },
        "diff": { "column": "diff", "type": "numeric", "hover": { "format": "+$.1f" } },
        "year": { "column": "year", "type": "categorical", "props": { "fromData": true } },
        "date": { "column": "date", "type": "date", "hover": { "format": "%A" } }
    },
    "plot": [
        {
            "id": "years", "type": "polar:line", "categories": ["year"],
            "props": { "fill": "none", "stroke": "#999", "stroke-opacity": 0.12, "d": { "angle": "@x:scaled", "radius": "@y:scaled" } }
        },
        {
            "id": "above", "type": "polar:area", "filter": { "year": "@year" },
            "props": { "fill": "#f23c06", "fill-opacity": 0.25, "d": { "angle": "@x:scaled", "innerRadius": "@clim:scaled", "outerRadius": "@hi:scaled" } }
        },
        {
            "id": "below", "type": "polar:area", "filter": { "year": "@year" },
            "props": { "fill": "#35d3da", "fill-opacity": 0.25, "d": { "angle": "@x:scaled", "innerRadius": "@lo:scaled", "outerRadius": "@clim:scaled" } }
        },
        {
            "id": "mean", "type": "polar:line", "filter": { "year": "@year" },
            "props": { "fill": "none", "stroke": "#9cb806", "stroke-width": 2, "stroke-opacity": 0.8, "d": { "angle": "@x:scaled", "radius": "@clim:scaled" } }
        },
        {
            "id": "selected", "type": "polar:line", "filter": { "year": "@year" },
            "props": { "fill": "none", "stroke": "#444", "stroke-width": 1.5, "d": { "angle": "@x:scaled", "radius": "@y:scaled" } }
        },
        {
            "id": "mean-points", "type": "polar:circle", "filter": { "year": "@year" }, "categories": ["year"], "highlight": "row",
            "props": { "angle": "@x:scaled", "radius": "@clim:scaled", "r": 0, "fill": "#9cb806", "fill-opacity": 0.8, "highlight-r": 4 }
        },
        {
            "id": "points", "type": "polar:circle", "filter": { "year": "@year" }, "categories": ["year"], "highlight": "row",
            "props": { "angle": "@x:scaled", "radius": "@y:scaled", "r": 0, "fill": "#444", "fill-opacity": 0.8, "highlight-r": 4 }
        }
    ]
}
