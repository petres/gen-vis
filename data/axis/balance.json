{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "balance.csv",
    "title": "Erträge nach Teilen",
    "subtitle": "in Mio. €, die Achse der Jahre bei 0, ihre Beschriftung am Rand",
    "source": "Erfundene Daten, Beispiel von axis.at",
    "height": 300,
    "margins": {"top": 10, "right": 10, "bottom": 30, "left": 40},
    "locale": {"base": "de"},
    "dims": {
        "x": {
            "column": "year",
            "type": "categorical",
            "axis": {"position": "bottom", "at": 0, "values": [2010, 2015, 2020, 2025]}
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "domain": [null, null],
            "nice": true,
            "axis": {"position": "left", "ticks": 6},
            "grid": true
        },
        "part": {
            "column": "part",
            "categories": {"Markt": "#4C78A8", "Förderung": "#F58518"},
            "legend": {"symbol": "rect"},
            "hover": {}
        }
    },
    "marks": {"type": "bar", "by": "part", "stack": true},
    "hover": {"columns": []}
}
