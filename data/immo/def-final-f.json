                "ticks": 6,
                "format": "c",
                "position": "bottom"
            }
        },
        "y": {
            "column": "price.m2.v",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "domain": [
                    0,
                    null
                ],
                "orientation": "vertical"
            },
            "axis": {
                "ticks": 8,
                "position": "left",
                "grid": true,
                "format": ".1f"
            },
            "hover": {
                "format": ".2f"
            }
        },
        "quali": {
            "column": "quali",
            "categories": {
                "A": {},
                "B": {},
                "C": {},
                "D": {},
                "NA": {},
                "Alle": {}
            }
        },
        "werr": {
            "column": "werr.label",
