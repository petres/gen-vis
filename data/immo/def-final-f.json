                "pub": {
                    "name": "öffentlich",
                    "stroke-dasharray": 2
                },
                "priv": {
                    "name": "privat",
                    "stroke-dasharray": 4
                },
                "NA": {
                    "stroke-dasharray": "2 4"
                },
                "Alle": {
                    "visible": true
                }
            },
            "hover": {}
        },
        "bundesland": {
            "column": "xnuts2.label",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": "@stroke-width"
                            }
                        }
                    ]
                }
            },
            "common": {
                "stroke-width": 1.5,
                "visible": false
            },
            "categories": {
                "Wien": {
                    "color": "#1E4F77",
                    "name": "Wien"
                },
                "Niederösterreich": {
                    "color": "#BBD7EE",
                    "name": "Niederösterreich"
                },
                "Burgenland": {
                    "color": "#5BC5F2",
                    "name": "Burgenland"
                },
                "Oberösterreich": {
                    "color": "#559BD5",
                    "name": "Oberösterreich"
                },
                "Salzburg": {
                    "color": "#C7DF71",
                    "name": "Salzburg"
                },
                "Steiermark": {
                    "color": "#4B9847",
                    "name": "Steiermark"
                },
                "Kärnten": {
                    "color": "#9CE1F8",
                    "name": "Kärnten"
                },
                "Tirol": {
                    "color": "#72BB6F",
                    "name": "Tirol"
                },
                "Vorarlberg": {
                    "color": "#3F766B",
                    "name": "Vorarlberg"
                },
                "NA": {
                    "color": "#ABD6A9",
                    "name": "NA"
                },
                "Alle": {
                    "color": "#000",
                    "visible": true
                }
            },
            "hover": {}
        }
