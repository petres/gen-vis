{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "ind-full-final.csv",
    "title": "Mietpreis",
    "subtitle": "Preis in €/m²",
    "source": "Q: Mikrozensus.",
    "height": 400,
    "margins": {"top": 20, "right": 20, "bottom": 50, "left": 40},
    "globals": {"quali": "Alle", "werr": "Alle", "wfrist": "Alle"},
    "controls": [
        {
            "type": "select",
            "global": "quali",
            "name": "Ausstattung",
            "id": "quali",
            "values": [
                {"id": "A", "name": "A", "value": "A"},
                {"id": "B", "name": "B", "value": "B"},
                {"id": "C", "name": "C", "value": "C"},
                {"id": "D", "name": "D", "value": "D"},
                {"id": "NA", "name": "NA", "value": "NA"},
                {"id": "Alle", "name": "Alle", "value": "Alle"}
            ]
        },
        {
            "type": "select",
            "global": "werr",
            "name": "Errichtung",
            "id": "werr",
            "values": [
                {"id": "1918 und davor", "name": "1918 und davor", "value": "1918 und davor"},
                {"id": "1919 - 1944", "name": "1919 - 1944", "value": "1919 - 1944"},
                {"id": "1945 - 1960", "name": "1945 - 1960", "value": "1945 - 1960"},
                {"id": "1961 - 1970", "name": "1961 - 1970", "value": "1961 - 1970"},
                {"id": "1971 - 1980", "name": "1971 - 1980", "value": "1971 - 1980"},
                {"id": "1981 - 1990", "name": "1981 - 1990", "value": "1981 - 1990"},
                {"id": "1991 - 2000", "name": "1991 - 2000", "value": "1991 - 2000"},
                {"id": "2001 - 2010", "name": "2001 - 2010", "value": "2001 - 2010"},
                {"id": "2011 - 2020", "name": "2011 - 2020", "value": "2011 - 2020"},
                {"id": "NA", "name": "NA", "value": "NA"},
                {"id": "Alle", "name": "Alle", "value": "Alle"}
            ]
        },
        {
            "type": "select",
            "global": "wfrist",
            "name": "Befristung",
            "id": "wfrist",
            "values": [
                {"id": "unbefristet", "name": "unbefristet", "value": "unbefristet"},
                {"id": "befristet", "name": "befristet", "value": "befristet"},
                {"id": "NA", "name": "NA", "value": "NA"},
                {"id": "Alle", "name": "Alle", "value": "Alle"}
            ]
        }
    ],
    "filter": {"quali": "@globals.quali", "werr": "@globals.werr", "wfrist": "@globals.wfrist"},
    "dims": {
        "x": {"column": "year", "format": "c", "axis": {"ticks": 6}},
        "y": {
            "column": "price.m2.v",
            "axis": {"ticks": 8, "format": ".1f"},
            "hover": {"format": ".2f"},
            "zero": true,
            "grid": true
        },
        "quali": {
            "column": "quali",
            "categories": {"A": {}, "B": {}, "C": {}, "D": {}, "NA": {}, "Alle": {}}
        },
        "werr": {
            "column": "werr.label",
            "categories": {
                "1918 und davor": {},
                "1919 - 1944": {},
                "1945 - 1960": {},
                "1961 - 1970": {},
                "1971 - 1980": {},
                "1981 - 1990": {},
                "1991 - 2000": {},
                "2001 - 2010": {},
                "2011 - 2020": {},
                "NA": {},
                "Alle": {}
            }
        },
        "wfrist": {
            "column": "wfrist.label",
            "categories": {"unbefristet": {}, "befristet": {}, "NA": {}, "Alle": {}}
        },
        "wrecht": {
            "column": "wrecht.miete",
            "common": {"visible": true},
            "categories": {
                "gbv": {"name": "GBV", "stroke-dasharray": null},
                "pub": {"name": "öffentlich", "stroke-dasharray": 2},
                "priv": {"name": "privat", "stroke-dasharray": 4},
                "NA": {"stroke-dasharray": "2 4"},
                "Alle": {"visible": true}
            },
            "hover": {}
        },
        "bundesland": {
            "column": "xnuts2.label",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": "@stroke-width"
                            }
                        }
                    ]
                }
            },
            "common": {"stroke-width": 1.5, "visible": false},
            "categories": {
                "Wien": {"color": "#1E4F77", "name": "Wien"},
                "Niederösterreich": {"color": "#BBD7EE", "name": "Niederösterreich"},
                "Burgenland": {"color": "#5BC5F2", "name": "Burgenland"},
                "Oberösterreich": {"color": "#559BD5", "name": "Oberösterreich"},
                "Salzburg": {"color": "#C7DF71", "name": "Salzburg"},
                "Steiermark": {"color": "#4B9847", "name": "Steiermark"},
                "Kärnten": {"color": "#9CE1F8", "name": "Kärnten"},
                "Tirol": {"color": "#72BB6F", "name": "Tirol"},
                "Vorarlberg": {"color": "#3F766B", "name": "Vorarlberg"},
                "NA": {"color": "#ABD6A9", "name": "NA"},
                "Alle": {"color": "#000", "visible": true}
            },
            "hover": {}
        }
    },
    "hover": {"columns": []},
    "marks": [
        {"type": "line", "by": ["quali", "werr", "bundesland", "wfrist"], "stroke-width": "2"},
        {
            "type": "point",
            "by": ["quali", "werr", "bundesland", "wfrist"],
            "fill": "@color",
            "r": "3"
        }
    ],
    "facets": {"by": "wrecht", "cols": 3, "scales": ["x", "y"]}
}
