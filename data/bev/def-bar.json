{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "transform": { "type": "index", "column": "Einwohner", "as": "index", "by": "Bundesland", "base": { "Jahr": "2002" } },
    "title": "Wachstum seit 2002",
    "subtitle": "Veränderung der Bevölkerung bis {year} in %, nach Bundesland",
    "source": "Q: Statistik Austria",
    "height": 330,
    "locale": { "base": "de", "number": { "currency": ["", " %"] } },
    "transition": 400,
    "hover": { "box": false, "marker": false, "area": "facet" },
    "globals": { "year": "2022" },
    "controls": [{ "type": "slider", "global": "year", "name": "Jahr", "values": { "column": "Jahr" }, "inImage": false }],
    "filter": { "year": "@globals.year" },
    "dims": {
        "year": "Jahr",
        "x": {
            "column": "index", "include": [100, 110], "pad": 0.03, "grid": true,
            "axis": { "position": "top", "tickSpacing": 90, "labels": { "props": { "text": "=format(@x - 100, '+$.0f')" } } }
        },
        "y": {
            "column": "Bundesland",
            "scale": { "padding": 0.3, "order": { "by": "x", "descending": true } },
            "axis": { "labels": { "props": { "font-weight": "@weight", "text": "@name" } } },
            "fromData": true,
            "common": { "color": "#4C9F70", "weight": "normal" },
            "categories": { "ÖSTERREICH": { "name": "Österreich", "color": "#1F3A33", "weight": "bold" } }
        }
    },
    "marks": [
        { "type": "bar", "by": "y", "x0": 100, "highlight": { "opacity": 1 }, "others": { "opacity": 0.5 } },
        { "type": "label", "by": "y", "anchor": "end", "text": "=format(@x - 100, '+$.1f')", "font-size": 11, "font-weight": "@weight", "fill": "#333",
          "highlight": { "opacity": 1 }, "others": { "opacity": 0.5 } }
    ],
    "annotations": { "type": "line", "x": 100, "props": { "stroke": "#333" } }
}
