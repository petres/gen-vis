{
    "data": "data.csv",
    "options": {
        "height": 330,
        "margins": {"top": 26, "right": 60, "bottom": 6, "left": 120},
        "title": "Wachstum seit 2002",
        "subtitle": "Veränderung der Bevölkerung bis {year} in %, nach Bundesland",
        "footer": "Q: Statistik Austria",
        "locale": { "base": "de", "number": { "currency": ["", " %"] } },
        "transition": 400,
        "hover": { "box": false, "marker": false, "area": "facet" }
    },
    "transform": { "type": "index", "column": "Einwohner", "as": "index", "by": "Bundesland", "base": { "Jahr": "2002" } },
    "globals": { "year": "2022" },
    "filter": { "year": "@year" },
    "formElements": [{
        "id": "year", "name": "Jahr", "ref": "year", "type": "slider", "inImage": false,
        "values": { "column": "Jahr" }
    }],
    "mapping": {
        "year": { "column": "Jahr", "type": "numeric" },
        "x": {
            "column": "index",
            "type": "numeric",
            "scale": { "orientation": "horizontal", "include": [100, 110], "domainRel": [-0.03, 0.03] },
            "axis": {
                "position": "top", "grid": true, "tickSpacing": 90,
                "labels": { "props": { "text": { "prop": "format", "of": { "prop": "relative", "ref": "x", "offset": -100 }, "format": "+$.0f" } } }
            }
        },
        "y": {
            "column": "Bundesland",
            "type": "categorical",
            "scale": { "type": "band", "orientation": "vertical", "range": [0, "@height"], "padding": 0.3, "order": { "by": "x", "descending": true } },
            "axis": { "position": "left", "labels": { "props": { "font-weight": "@weight", "text": "@name" } } },
            "props": {
                "fromData": true,
                "common": { "fill": "#4C9F70", "weight": "normal" },
                "categories": { "ÖSTERREICH": { "name": "Österreich", "fill": "#1F3A33", "weight": "bold" } }
            }
        }
    },
    "annotations": [
        { "type": "line", "x": 100, "props": { "stroke": "#333" } }
    ],
    "plot": [
        {
            "id": "bars",
            "type": "cartesian:bar",
            "categories": ["y"],
            "props": { "x0": "@x:scaled:100", "x1": "@x:scaled", "y": "@y:scaled", "fill": "@fill", "highlight-opacity": 1, "others-opacity": 0.5 }
        },
        {
            "id": "values",
            "type": "svg:text",
            "categories": ["y"],
            "props": {
                "x": "@x:scaled", "dx": 5, "y": "@y:scaled:center", "dominant-baseline": "central", "font-size": 11,
                "font-weight": "@weight", "fill": "#333", "highlight-opacity": 1, "others-opacity": 0.5,
                "text": { "prop": "format", "of": { "prop": "relative", "ref": "x", "offset": -100 }, "format": "+$.1f" }
            }
        }
    ]
}
