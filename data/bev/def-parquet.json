{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "def.json",
    "data": "data.parquet",
    "title": "Bevölkerung",
    "subtitle": "nach Bundesland, gestapelt, aus einer Parquet-Datei",
    "filter": "@land != 'ÖSTERREICH'",
    "dims": {
        "x": { "pad": 0 },
        "y": { "pad": [0, 0.05] },
        "land": { "legend": { "symbol": { "type": "rect", "size": 14 } }, "categories": { "ÖSTERREICH": { "legend": false } } }
    },
    "marks": {
        "type": "area", "by": "land", "stack": true, "curve": "monotoneX", "layer": "below",
        "fill-opacity": 0.85, "stroke": "white", "stroke-width": 0.8, "highlight": { "fill-opacity": 1 }, "others": { "fill-opacity": 0.35 }
    }
}
