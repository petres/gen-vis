{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": "def.json",
    "data": "data.parquet",
    "options": {
        "title": "Bevölkerung",
        "subtitle": "nach Bundesland, gestapelt, aus einer Parquet-Datei",
        "margins": {"top": 10, "right": 10, "bottom": 30, "left": 80}
    },
    "filter": { "land": { "not": "ÖSTERREICH" } },
    "mapping": {
        "x": { "scale": { "domainRel": [0, 0] } },
        "y": { "stacked": true, "scale": { "domainRel": [0, 0.05] } },
        "land": { "legend": { "symbol": { "type": "rect", "size": 14 } }, "categories": { "ÖSTERREICH": { "legend": false } } }
    },
    "plot": [
        {
            "type": "area",
            "by": "land",
            "curve": "monotoneX",
            "layer": "below",
            "props": {
                "fill": "@color",
                "d": { "y0": "@y:start:scaled", "y1": "@y:end:scaled" },
                "fill-opacity": 0.85,
                "stroke": "white",
                "stroke-width": 0.8
            },
            "highlight": { "fill-opacity": 1 },
            "others": { "fill-opacity": 0.35 }
        }
    ]
}
