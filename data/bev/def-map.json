{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Bevölkerung",
    "subtitle": "nach Bundesland, die Fläche der Kreise entspricht der Einwohnerzahl",
    "source": "Q: Statistik Austria; Grenzen: © EuroGeographics",
    "height": 380,
    "coord": "geo",
    "geo": { "data": "../geo/austria.json", "key": "name", "join": "land" },
    "globals": { "year": "2022" },
    "controls": [{ "type": "select", "global": "year", "name": "Jahr", "values": ["2002", "2007", "2012", "2017", "2022"] }],
    "filter": { "year": "@globals.year" },
    "dims": {
        "year": "Jahr",
        "land": "Bundesland",
        "pop": { "column": "Einwohner", "domain": [0, 2000000], "scale": { "type": "sqrt", "range": [0, 34] }, "hover": { "format": ",.0f" } }
    },
    "marks": [
        { "type": "base", "fill": "#E6EEF4", "stroke": "white", "stroke-width": 1.5 },
        { "type": "point", "by": "land", "r": "pop", "fill": "#1E4F77", "fill-opacity": 0.65, "stroke": "white", "stroke-width": 1, "highlight": { "fill-opacity": 0.9 } },
        { "type": "text", "by": "land", "place": "centroid", "text": "@land", "font-size": 11, "fill": "#222", "halo": true }
    ]
}
