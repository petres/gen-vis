{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Bevölkerung",
    "subtitle": "nach Bundesland, die Fläche der Kreise entspricht der Einwohnerzahl",
    "source": "Q: Statistik Austria; Grenzen: © EuroGeographics",
    "height": 380,
    "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
    "coord": "geo",
    "globals": {"year": "2022"},
    "controls": [
        {
            "type": "select",
            "global": "year",
            "name": "Jahr",
            "id": "year",
            "values": [
                {"id": "2002", "name": "2002", "value": "2002"},
                {"id": "2007", "name": "2007", "value": "2007"},
                {"id": "2012", "name": "2012", "value": "2012"},
                {"id": "2017", "name": "2017", "value": "2017"},
                {"id": "2022", "name": "2022", "value": "2022"}
            ]
        }
    ],
    "filter": {"year": "@globals.year"},
    "dims": {
        "year": {"column": "Jahr", "type": "categorical"},
        "land": {
            "column": "Bundesland",
            "categories": {
                "ÖSTERREICH": {"visible": false},
                "Wien": {},
                "Niederösterreich": {},
                "Burgenland": {},
                "Oberösterreich": {},
                "Salzburg": {},
                "Steiermark": {},
                "Kärnten": {},
                "Tirol": {},
                "Vorarlberg": {}
            }
        },
        "pop": {
            "column": "Einwohner",
            "domain": [0, 2000000],
            "scale": {"type": "sqrt", "range": [0, 34]},
            "hover": {"format": ",.0f"}
        }
    },
    "hover": {"columns": []},
    "marks": [
        {"type": "base", "fill": "#E6EEF4", "stroke": "white", "stroke-width": 1.5},
        {
            "type": "point",
            "by": "land",
            "r": "@pop:scaled",
            "fill": "#1E4F77",
            "fill-opacity": 0.65,
            "stroke": "white",
            "stroke-width": 1,
            "highlight": {"fill-opacity": 0.9}
        },
        {
            "type": "text",
            "by": "land",
            "place": "centroid",
            "text": "@name",
            "font-size": 11,
            "text-anchor": "middle",
            "dy": "0.35em",
            "fill": "#222",
            "stroke": "white",
            "stroke-width": 3,
            "paint-order": "stroke"
        }
    ],
    "geo": {"data": "../geo/austria.json", "key": "name", "join": "land"}
}
