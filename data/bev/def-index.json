{
    "data": "data.csv",
    "options": {
        "height": 300,
        "margins": {"top": 10, "right": 20, "bottom": 30, "left": 50},
        "title": "Bevölkerung",
        "subtitle": "Index, {base} = 100, nach Bundesland",
        "footer": "Q: Statistik Austria"
    },
    "globals": { "base": "2002" },
    "transform": {
        "type": "index", "column": "Einwohner", "as": "index", "by": "Bundesland",
        "base": { "Jahr": "{base}" }
    },
    "formElements": [{
        "id": "base", "name": "Basisjahr", "ref": "base", "type": "slider", "inImage": false,
        "values": { "column": "Jahr" }
    }],
    "annotations": [
        { "type": "line", "y": 100, "props": { "stroke-dasharray": "3 3" } }
    ],
    "mapping": {
        "x": { "column": "Jahr", "type": "numeric", "format": "c", "scale": { "domainRel": [0, 0], "inset": 6 }, "axis": { "tickSpacing": 80 }, "hover": {} },
        "y": { "column": "index", "type": "numeric", "nice": true, "axis": { "grid": true, "ticks": 5, "format": ",.0f" }, "hover": { "format": ",.1f" } },
        "land": {
            "column": "Bundesland",
            "fromData": true,
            "scheme": "Tableau10",
            "common": { "stroke-width": 1.5 },
            "categories": { "ÖSTERREICH": { "name": "Gesamt", "color": "#000", "stroke-width": 3 } },
            "legend": { "symbol": "line" },
            "hover": {}
        }
    },
    "plot": {
        "type": "cartesian:line",
        "by": "land",
        "props": {
            "stroke": "@color",
            "stroke-width": "@stroke-width",
            "fill": "none",
            "d": { "x": "@x:scaled", "y": "@y:scaled" }
        },
        "highlight": { "stroke-width": 4 }
    }
}
