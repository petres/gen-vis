{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "transform": {
        "type": "index",
        "column": "Einwohner",
        "as": "index",
        "by": "Bundesland",
        "base": {"Jahr": "{base}"}
    },
    "title": "Bevölkerung",
    "subtitle": "Index, {base} = 100, nach Bundesland",
    "source": "Q: Statistik Austria",
    "height": 300,
    "margins": {"top": 10, "right": 20, "bottom": 30, "left": 50},
    "globals": {"base": "2002"},
    "controls": [
        {
            "type": "slider",
            "global": "base",
            "name": "Basisjahr",
            "id": "base",
            "values": {"column": "Jahr"},
            "inImage": false
        }
    ],
    "dims": {
        "x": {
            "column": "Jahr",
            "format": "c",
            "scale": {"inset": 6, "pad": [0, 0]},
            "axis": {"tickSpacing": 80},
            "hover": {}
        },
        "y": {
            "column": "index",
            "nice": true,
            "axis": {"ticks": 5, "format": ",.0f"},
            "hover": {"format": ",.1f"},
            "grid": true
        },
        "land": {
            "column": "Bundesland",
            "fromData": true,
            "scheme": "Tableau10",
            "common": {"stroke-width": 1.5},
            "categories": {"ÖSTERREICH": {"name": "Gesamt", "color": "#000", "stroke-width": 3}},
            "legend": {"symbol": "line"},
            "hover": {}
        }
    },
    "marks": {
        "type": "line",
        "by": "land",
        "stroke-width": "@stroke-width",
        "highlight": {"stroke-width": 4}
    },
    "annotations": [{"type": "line", "y": 100, "props": {"stroke-dasharray": "3 3"}}]
}
