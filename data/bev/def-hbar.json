{
    "data": "data.csv",
    "options": {
        "height": 320,
        "margins": {"top": 5, "right": 70, "bottom": 25, "left": 120},
        "title": "Bevölkerung {year}",
        "subtitle": "nach Bundesland, nach der Einwohnerzahl sortiert",
        "footer": "Q: Statistik Austria"
    },
    "globals": { "year": "2022" },
    "filter": { "year": "@year" },
    "formElements": [{
        "id": "year", "name": "Jahr", "ref": "year", "type": "slider", "inImage": false,
        "values": { "column": "Jahr" }
    }],
    "mapping": {
        "year": "Jahr",
        "x": {
            "column": "Einwohner",
            "domain": [0, null],
            "format": ",.0f",
            "axis": { "grid": true, "tickSpacing": 110 },
            "hover": {}
        },
        "y": {
            "column": "Bundesland",
            "scale": { "range": [0, "@height"], "padding": 0.25, "order": { "by": "x", "descending": true } },
            "fromData": true,
            "categories": { "ÖSTERREICH": { "visible": false } }
        }
    },
    "plot": [
        { "type": "bar", "by": "y", "props": { "x1": "@x:scaled", "y": "@y:scaled", "fill": "#1E4F77" }, "highlight": { "fill": "#5BC5F2" } },
        {
            "type": "svg:text",
            "by": "y",
            "props": {
                "x": "@x:scaled", "dx": 4, "y": "@y:scaled:center", "dominant-baseline": "middle",
                "font-size": 11, "text": "@x:formatted"
            }
        }
    ]
}
