{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Bevölkerung {year}",
    "subtitle": "nach Bundesland, nach der Einwohnerzahl sortiert",
    "source": "Q: Statistik Austria",
    "height": 320,
    "margins": {"top": 5, "right": 70, "bottom": 25, "left": 120},
    "globals": {"year": "2022"},
    "controls": [
        {
            "type": "slider",
            "global": "year",
            "name": "Jahr",
            "id": "year",
            "values": {"column": "Jahr"},
            "inImage": false
        }
    ],
    "filter": {"year": "@globals.year"},
    "dims": {
        "year": "Jahr",
        "x": {
            "column": "Einwohner",
            "format": ",.0f",
            "axis": {"tickSpacing": 110},
            "hover": {},
            "zero": true,
            "grid": true
        },
        "y": {
            "column": "Bundesland",
            "scale": {"range": [0, "@height"], "padding": 0.25, "order": {"by": "x", "descending": true}},
            "fromData": true,
            "categories": {"ÖSTERREICH": {"visible": false}}
        }
    },
    "marks": [
        {
            "type": "bar",
            "by": "y",
            "orient": "horizontal",
            "fill": "#1E4F77",
            "highlight": {"fill": "#5BC5F2"}
        },
        {
            "type": "text",
            "by": "y",
            "dx": 4,
            "dominant-baseline": "middle",
            "font-size": 11,
            "text": "@x:formatted",
            "fill": null
        }
    ],
    "hover": {"columns": []}
}
