{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Bevölkerung",
    "subtitle": "nach Bundesland",
    "source": "Q: Statistik Austria",
    "height": 300,
    "dims": {
        "x": { "column": "Jahr", "format": "c", "tickSpacing": 77 },
        "y": { "column": "Einwohner", "format": ",.0f", "zero": true, "pad": [0, 0.2], "ticks": 5, "grid": true },
        "land": {
            "column": "Bundesland",
            "scheme": "Tableau10",
            "common": { "stroke-width": 2.5 },
            "legend": { "props": { "class": "@class" } },
            "categories": {
                "ÖSTERREICH": { "name": "Gesamt", "color": "#1E4F77", "stroke-width": 4, "visible": false, "class": "bold" },
                "Wien": {}, "Niederösterreich": {}, "Burgenland": {}, "Oberösterreich": {}, "Salzburg": {},
                "Steiermark": {}, "Kärnten": {}, "Tirol": {}, "Vorarlberg": {}
            }
        }
    },
    "marks": [
        { "type": "line", "by": "land", "stroke-width": "@stroke-width", "opacity": 0.7, "highlight": { "opacity": 1, "stroke-width": 3 } },
        { "type": "point", "by": "land", "r": 4, "opacity": 0.7, "highlight": { "r": 5, "opacity": 1 } }
    ]
}
