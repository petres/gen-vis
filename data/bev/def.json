{
    "data": "data.csv",
    "options": {
        "height": 300,
        "margins": {"top": 10, "right": 10, "bottom": 40, "left": 80},
        "title": "Bevölkerung",
        "subtitle": "nach Bundesland",
        "footer": "Q: Statistik Austria"
    },
    "mapping": {
        "x": {
            "column": "Jahr",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "domainAbs": [-0.5, 0.5],
                "orientation": "horizontal"
            },
            "axis": {
                "ticks": { "*": ["@innerWidth", 0.013] },
                "position": "bottom",
                "format": "c"
            },
            "hover": {
                "format": "c"
            }
        },
        "y": {
            "column": "Einwohner",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "domain": [0, null],
                "domainRel": [0, 0.2],
                "orientation": "vertical"
            },
            "axis": {
                "ticks": 5,
                "position": "left",
                "grid": true,
                "format": ",.0f"
            },
            "hover": {
                "format": ",.0f"
            }
        },
        "land": {
            "column": "Bundesland",
            "legend": {
                "props": {
                    "class": "@class"
                },
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 16, "y1": 8, "y2": 8,
                            "stroke": "@color", "stroke-width": "@stroke-width"
                        }
                    }, {
                        "type": "circle",
                        "props": {
                            "cx": 8, "cy": 8, "r": 3,
                            "fill": "@color"
                        }
                    }]
                }
            },
            "scheme": "Tableau10",
            "common": {
                "stroke-width": 2.5
            },
            "categories": {
                "ÖSTERREICH":       { "color": "#1E4F77", "stroke-width": 4, "name": "Gesamt", "visible": false, "class": "bold" },
                "Wien":             {},
                "Niederösterreich": {},
                "Burgenland":       {},
                "Oberösterreich":   {},
                "Salzburg":         {},
                "Steiermark":       {},
                "Kärnten":          {},
                "Tirol":            {},
                "Vorarlberg":       {}
            },
            "hover": {
            }
        }
    },
    "plot": [
        {
            "type": "cartesian:line",
            "by": "land",
            "props": {
                "stroke-width": "@stroke-width",
                "fill": "none",
                "opacity": 0.7,
                "stroke": "@color",
                "d": {
                    "x": "@x:scaled",
                    "y": "@y:scaled"
                }
            },
            "highlight": { "opacity": 1, "stroke-width": 3 }
        },
        {
            "type": "svg:circle",
            "by": "land",
            "props": {
                "fill": "@color",
                "opacity": 0.7,
                "cx": "@x:scaled",
                "cy": "@y:scaled",
                "r": 4
            },
            "highlight": { "r": 5, "opacity": 1 }
        }
    ]
}
