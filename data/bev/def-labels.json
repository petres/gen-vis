{
    "parent": "def.json",
    "options": {
        "margins": { "top": 10, "right": 130, "bottom": 40, "left": 80 },
        "subtitle": "nach Bundesland, mit Beschriftungen und einer Marke von {mark} Einwohnern"
    },
    "globals": { "mark": 1500000 },
    "plot": [
        {
            "type": "cartesian:line",
            "categories": ["land"],
            "props": {
                "stroke-width": "@stroke-width", "fill": "none", "opacity": 0.7, "stroke": "@color",
                "d": { "x": "@x:scaled", "y": "@y:scaled" },
                "highlight-opacity": 1, "highlight-stroke-width": 3
            }
        },
        {
            "type": "svg:text",
            "categories": ["land"],
            "select": { "max": "x" },
            "dodge": 12,
            "layer": "above",
            "props": { "x": "@x:scaled", "y": "@y:scaled", "dx": 6, "dominant-baseline": "middle", "font-size": 11, "text": "@name", "fill": "@color" }
        },
        {
            "type": "svg:text",
            "data": [{ "y": "@mark", "label": "Marke" }],
            "props": { "x": "@x:scaled:max", "y": "@y:scaled", "dy": -4, "text-anchor": "end", "font-size": 11, "fill": "#888", "text": "@label" }
        }
    ],
    "annotations": [
        { "type": "line", "y": "@mark", "props": { "stroke": "#888", "stroke-dasharray": "3 3" } },
        { "type": "band", "x": [2020, 2021], "label": "Pandemie" }
    ]
}
