{
    "parent": "def.json",
    "options": {
        "margins": { "top": 10, "right": 130, "bottom": 40, "left": 80 },
        "subtitle": "nach Bundesland, mit den Namen der Linien, einer Marke und einer Annotation"
    },
    "globals": { "mark": 1500000 },
    "plot": [
        {
            "type": "line",
            "by": "land",
            "props": {
                "stroke-width": "@stroke-width",
                "opacity": 0.7,
                "stroke": "@color"
            },
            "highlight": { "opacity": 1, "stroke-width": 3 }
        },
        {
            "type": "text",
            "by": "land",
            "select": { "max": "x" },
            "dodge": 12,
            "layer": "above",
            "props": { "dx": 6, "dominant-baseline": "middle", "font-size": 11, "text": "@name" }
        },
        {
            "type": "text",
            "data": [{ "y": "@mark", "label": "Marke" }],
            "props": { "x": "@x:scaled:min", "dx": 4, "dy": -4, "font-size": 11, "fill": "#888", "text": "@label" }
        }
    ],
    "annotations": [
        { "type": "line", "y": "@mark", "props": { "stroke": "#888", "stroke-dasharray": "3 3" } },
        { "type": "band", "x": [2020, 2021], "label": "Pandemie" }
    ]
}
