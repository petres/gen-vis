{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "def.json",
    "subtitle": "nach Bundesland, mit den Namen der Linien, einer Marke und einer Annotation",
    "globals": { "mark": 1500000 },
    "marks": [
        { "type": "line", "by": "land", "stroke-width": "@stroke-width", "opacity": 0.7, "highlight": { "opacity": 1, "stroke-width": 3 } },
        { "type": "text", "by": "land", "select": { "max": "x" }, "anchor": "end", "dx": 6, "dodge": 12, "layer": "above", "font-size": 11, "text": "@name" },
        { "type": "text", "data": [{ "y": "@mark", "label": "Marke" }], "x": "@x:scaled:min", "dx": 4, "dy": -4, "font-size": 11, "fill": "#888", "text": "@label" }
    ],
    "annotations": [
        { "type": "line", "y": "@mark", "props": { "stroke": "#888", "stroke-dasharray": "3 3" } },
        { "type": "band", "x": [2020, 2021], "label": "Pandemie" }
    ]
}
