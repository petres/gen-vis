{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Bevölkerung",
    "subtitle": "nach Bundesland",
    "source": "Q: Statistik Austria",
    "height": 420,
    "coord": "polar",
    "dims": {
        "x": {
            "column": "Bundesland", "grid": true, "axis": { "padding": 4 },
            "categories": {
                "Wien": {}, "Niederösterreich": {}, "Burgenland": {}, "Steiermark": {}, "Kärnten": {},
                "Tirol": {}, "Vorarlberg": {}, "Salzburg": {}, "Oberösterreich": {}
            }
        },
        "y": {
            "column": "Einwohner", "zero": true, "pad": [0, 0.05], "ticks": 4, "grid": true,
            "axis": { "angle": 40, "gridShape": "polygon", "format": ".2s" },
            "hover": { "format": ",.0f" }
        },
        "year": { "column": "Jahr", "legend": {}, "categories": { "2002": "#BBD7EE", "2012": "#559BD5", "2022": "#1E4F77" } }
    },
    "marks": [
        { "type": "line", "by": "year", "curve": "linearClosed", "stroke-width": 2.5, "highlight": { "stroke-width": 4 } },
        { "type": "point", "by": "year", "r": 3.5, "highlight": { "r": 5 } }
    ]
}
