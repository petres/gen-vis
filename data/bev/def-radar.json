{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Bevölkerung",
    "subtitle": "nach Bundesland",
    "source": "Q: Statistik Austria",
    "height": 420,
    "margins": {"top": 30, "right": 90, "bottom": 30, "left": 90},
    "coord": "polar",
    "dims": {
        "land": {
            "column": "Bundesland",
            "scale": {"orientation": "angular"},
            "axis": {"padding": 4},
            "categories": {
                "ÖSTERREICH": {"visible": false},
                "Wien": {},
                "Niederösterreich": {},
                "Burgenland": {},
                "Steiermark": {},
                "Kärnten": {},
                "Tirol": {},
                "Vorarlberg": {},
                "Salzburg": {},
                "Oberösterreich": {}
            },
            "grid": true
        },
        "y": {
            "column": "Einwohner",
            "scale": {"pad": [0, 0.05]},
            "axis": {"ticks": 4, "angle": 40, "gridShape": "polygon", "format": ".2s"},
            "hover": {"format": ",.0f"},
            "zero": true,
            "grid": true
        },
        "year": {
            "column": "Jahr",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": 2.5
                            }
                        }
                    ]
                }
            },
            "categories": {"2002": "#BBD7EE", "2012": "#559BD5", "2022": "#1E4F77"},
            "hover": {}
        }
    },
    "marks": [
        {
            "type": "line",
            "by": "year",
            "curve": "linearClosed",
            "x": "land",
            "stroke-width": 2.5,
            "highlight": {"stroke-width": 4}
        },
        {"type": "point", "by": "year", "r": 3.5, "angle": "@land:scaled", "highlight": {"r": 5}}
    ],
    "hover": {"columns": []}
}
