{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "_radar.json",
    "title": "Radar der Wettbewerbsfähigkeit: Zeitvergleich",
    "subtitle": "Die Prozentränge von {country} in den Jahren, unter den Ländern der EU, Norwegen, Island, der Schweiz und dem Vereinigten Königreich",
    "hover": {"row": "{year}: <b>{y}</b>", "columns": ["y"]},
    "globals": {"country": "Österreich"},
    "controls": [
        {
            "type": "select",
            "global": "country",
            "name": "Land",
            "id": "country",
            "values": {"column": "countryName"}
        }
    ],
    "filter": {"countryName": "@globals.country"},
    "dims": {
        "countryName": "countryName",
        "year": {
            "column": "year",
            "hover": {},
            "legend": {
                "position": "bottom",
                "symbol": {
                    "size": 14,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {"x": 1, "y": 1, "width": 12, "height": 12, "fill": "@color"}
                        }
                    ]
                }
            },
            "fromData": true,
            "order": "ascending",
            "scheme": "Tableau10",
            "common": {"visible": false},
            "categories": {
                "2019": {"visible": true, "color": "#C3423F"},
                "2020": {"visible": true, "color": "#559BD5"}
            }
        }
    },
    "marks": [
        {
            "type": "area",
            "id": "areas",
            "by": "year",
            "curve": "linearClosed",
            "fill-opacity": 0.08,
            "d": {"innerRadius": 0},
            "highlight": {"fill-opacity": 0.2}
        },
        {
            "type": "line",
            "id": "lines",
            "by": "year",
            "curve": "linearClosed",
            "stroke-width": 2.5,
            "highlight": {"stroke-width": 4}
        },
        {"type": "point", "id": "points", "by": "year", "r": 5, "highlight": {"r": 6}}
    ]
}
