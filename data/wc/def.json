{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Ausstattungsqualität",
    "subtitle": "Anteil der Wohnungen und Häuser mit WC im Wohnungsverband, 1971 bis 2001",
    "source": "<strong>Q:</strong> Statistik Austria (2021c)",
    "height": "=steps(@totalWidth, {0: 300, 700: 380})",
    "margins": {"top": 34, "right": 118, "bottom": 28, "left": 44},
    "dims": {
        "x": {
            "column": "Jahr",
            "format": "d",
            "scale": {"inset": [6, 6], "pad": [0, 0]},
            "axis": {"values": [1971, 1981, 1991, 2001]},
            "hover": {}
        },
        "y": {
            "column": "Anteil",
            "domain": [0.4, 1],
            "scale": {"pad": [0, 0]},
            "axis": {"ticks": 4, "format": ".0%"},
            "hover": {"format": ".1%"},
            "grid": true
        },
        "type": {
            "column": "Wohnungssegment",
            "scheme": "Tableau10",
            "common": {"width": 2},
            "categories": {
                "Hauseigentum": {},
                "Wohnungseigentum": {},
                "GBV Miete": {},
                "Kommunale Miete": {},
                "Private Miete": {},
                "Sonstiges": {},
                "Alle Haushalte": {"color": "#111", "width": 3.5}
            },
            "hover": {}
        },
        "einheit": {"column": "Einheit", "categories": {"Österreich": {}, "Wien": {}}}
    },
    "marks": [
        {
            "type": "line",
            "id": "lines",
            "by": "type",
            "stroke-width": "@width",
            "highlight": {"stroke-width": 4},
            "others": {"stroke-opacity": 0.25}
        },
        {
            "type": "point",
            "id": "points",
            "by": "type",
            "fill": "@color",
            "highlight": {"r": 4.5},
            "others": {"opacity": 0.25}
        },
        {
            "type": "text",
            "id": "labels",
            "by": "type",
            "select": "last",
            "dodge": 12,
            "dx": 8,
            "dominant-baseline": "central",
            "font-size": 11,
            "text": "@name",
            "highlight": {"font-weight": "bold"},
            "others": {"opacity": 0.3}
        }
    ],
    "facets": {"by": "einheit", "cols": "=steps(@totalWidth, {0: 1, 700: 2})", "scales": ["y"]}
}
