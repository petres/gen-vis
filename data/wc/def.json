{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Ausstattungsqualität",
    "subtitle": "Anteil der Wohnungen und Häuser mit WC im Wohnungsverband, 1971 bis 2001",
    "source": "<strong>Q:</strong> Statistik Austria (2021c)",
    "height": "=steps(@totalWidth, {0: 300, 700: 380})",
    "dims": {
        "x": { "column": "Jahr", "format": "d", "pad": 0, "scale": { "inset": 6 }, "axis": { "values": [1971, 1981, 1991, 2001] } },
        "y": { "column": "Anteil", "domain": [0.4, 1], "ticks": 4, "grid": true, "axis": { "format": ".0%" }, "hover": { "format": ".1%" } },
        "type": {
            "column": "Wohnungssegment",
            "scheme": "Tableau10",
            "common": { "width": 2 },
            "order": "rows",
            "fromData": "rows",
            "categories": { "Alle Haushalte": { "color": "#111", "width": 3.5 } }
        },
        "einheit": "Einheit"
    },
    "facets": { "by": "einheit", "cols": "=steps(@totalWidth, {0: 1, 700: 2})", "scales": ["y"] },
    "marks": [
        { "type": "line", "by": "type", "stroke-width": "@width", "highlight": { "stroke-width": 4 }, "others": { "stroke-opacity": 0.25 } },
        { "type": "point", "by": "type", "highlight": { "r": 4.5 }, "others": { "opacity": 0.25 } },
        { "type": "text", "by": "type", "select": "last", "anchor": "end", "dx": 8, "dodge": 12, "font-size": 11, "text": "@name",
          "highlight": { "font-weight": "bold" }, "others": { "opacity": 0.3 } }
    ]
}
