{
    "parent": "_group.json",
    "data": "d2-series.csv",
    "options": {
        "class": "fti fti-series",
        "locale": { "base": "en", "number": { "currency": ["", "%"] } },
        "height": 220,
        "margins": { "top": 24, "right": 20, "bottom": 40, "left": 50 },
        "title": "Efficiency",
        "subtitle": "Aggregated indicator over time, Austria relative to the comparison group",
        "footer": "Source: <a href=\"https://fti-monitor.forwit.at/en/B/D.2\">FTI Monitor D.2</a>, FORWIT",
        "hover": { "box": false, "marker": false }
    },
    "mapping": {
        "x": {
            "column": "year",
            "scale": { "domainRel": [0, 0], "inset": [10, 30] },
            "hover": { "format": "d" },
            "axis": false
        },
        "y": {
            "column": "{group}",
            "format": "$.0f",
            "scale": { "include": 100 },
            "axis": { "ticks": 3, "grid": true },
            "hover": {}
        },
        "color": {
            "column": "{group}",
            "domain": [74.5, 89.5, 99.5, 109.5],
            "scale": {
                "type": "threshold",
                "closed": "right",
                "range": ["#EA4B55", "#F59036", "#F9EB00", "#AFD24B", "#3CAF55"]
            }
        },
        "type": {
            "column": "type",
            "categories": {
                "total": { "name": "Total", "dash": "none", "fill": "white", "r": 5 },
                "input": { "name": "Input", "dash": "2 2", "fill": "#F5F6FA", "r": 4 },
                "output": { "name": "Output", "dash": "6 3", "fill": "#888", "r": 4 }
            },
            "legend": { "position": "bottom", "symbol": { "size": 24, "elements": [
                { "type": "line", "props": { "x1": 0, "x2": 24, "y1": 12, "y2": 12, "stroke": "#888", "stroke-dasharray": "@dash" } },
                { "type": "circle", "props": { "cx": 12, "cy": 12, "r": "@r", "fill": "@fill", "stroke": "#888", "stroke-width": 1.5 } }
            ] } },
            "hover": {}
        }
    },
    "plot": [
        { "id": "lines", "type": "line", "by": "type", "props": { "stroke": "#888", "stroke-dasharray": "@dash" } },
        { "id": "points", "type": "point", "by": "type", "filter": { "type": { "not": "total" } }, "props": { "r": "@r", "fill": "@fill", "stroke": "#888" } },
        {
            "id": "total",
            "type": "point",
            "by": "type",
            "filter": { "type": "total" },
            "props": { "r": "@r", "fill": "white", "stroke": "@color:scaled", "stroke-width": 3 }
        },
        {
            "id": "last",
            "type": "point",
            "by": "type",
            "select": "last",
            "filter": { "type": "total" },
            "layer": "above",
            "props": {
                "r": 17,
                "fill": "white",
                "stroke": "@color:scaled",
                "stroke-width": 5
            },
            "others": { "visibility": "hidden" }
        },
        {
            "id": "last-value",
            "type": "svg:text",
            "by": "type",
            "select": "last",
            "filter": { "type": "total" },
            "layer": "above",
            "props": {
                "x": "@x:scaled",
                "y": "@y:scaled",
                "text-anchor": "middle",
                "dominant-baseline": "central",
                "font-size": 11,
                "font-weight": "bold",
                "text": "@y:formatted"
            },
            "others": { "visibility": "hidden" }
        },
        {
            "id": "last-year",
            "type": "svg:text",
            "by": "type",
            "select": "last",
            "filter": { "type": "total" },
            "layer": "above",
            "props": {
                "x": "@x:scaled",
                "y": "@y:scaled",
                "dy": 30,
                "text-anchor": "middle",
                "dominant-baseline": "central",
                "font-size": 11,
                "text": "@x:formatted"
            },
            "others": { "visibility": "hidden" }
        },
        {
            "id": "ring",
            "type": "point",
            "by": "x",
            "filter": { "type": "total" },
            "layer": "above",
            "props": {
                "r": 17,
                "fill": "white",
                "stroke": "@color:scaled",
                "stroke-width": 5,
                "visibility": "hidden"
            },
            "highlight": { "visibility": "visible" }
        },
        {
            "id": "ring-value",
            "type": "svg:text",
            "by": "x",
            "filter": { "type": "total" },
            "layer": "above",
            "props": {
                "x": "@x:scaled",
                "y": "@y:scaled",
                "text-anchor": "middle",
                "dominant-baseline": "central",
                "font-size": 11,
                "font-weight": "bold",
                "text": "@y:formatted",
                "visibility": "hidden"
            },
            "highlight": { "visibility": "visible" }
        },
        {
            "id": "ring-year",
            "type": "svg:text",
            "by": "x",
            "filter": { "type": "total" },
            "layer": "above",
            "props": {
                "x": "@x:scaled",
                "y": "@y:scaled",
                "dy": 30,
                "text-anchor": "middle",
                "dominant-baseline": "central",
                "font-size": 11,
                "text": "@x:formatted",
                "visibility": "hidden"
            },
            "highlight": { "visibility": "visible" }
        }
    ],
    "annotations": [
        { "type": "line", "y": 100, "props": { "stroke": "#444", "stroke-dasharray": "2 3" } }
    ]
}
