{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "_group.json",
    "data": "d2-series.csv",
    "title": "Efficiency",
    "subtitle": "Aggregated indicator over time, Austria relative to the comparison group",
    "source": "Source: <a href=\"https://fti-monitor.forwit.at/en/B/D.2\">FTI Monitor D.2</a>, FORWIT",
    "height": 220,
    "margins": {"top": 24, "right": 20, "bottom": 40, "left": 50},
    "locale": {"base": "en", "number": {"currency": ["", "%"]}},
    "class": "fti fti-series",
    "hover": {"box": false, "marker": false},
    "dims": {
        "x": {
            "column": "year",
            "scale": {"inset": [10, 30], "pad": [0, 0]},
            "hover": {"format": "d"},
            "axis": false
        },
        "y": {
            "column": "{group}",
            "format": "$.0f",
            "scale": {"include": 100},
            "axis": {"ticks": 3},
            "grid": true
        },
        "color": {
            "column": "{group}",
            "domain": [74.5, 89.5, 99.5, 109.5],
            "scale": {
                "type": "threshold",
                "closed": "right",
                "range": ["#EA4B55", "#F59036", "#F9EB00", "#AFD24B", "#3CAF55"]
            }
        },
        "type": {
            "column": "type",
            "categories": {
                "total": {"name": "Total", "dash": "none", "fill": "white", "r": 5},
                "input": {"name": "Input", "dash": "2 2", "fill": "#F5F6FA", "r": 4},
                "output": {"name": "Output", "dash": "6 3", "fill": "#888", "r": 4}
            },
            "legend": {
                "position": "bottom",
                "symbol": {
                    "size": 24,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 24,
                                "y1": 12,
                                "y2": 12,
                                "stroke": "#888",
                                "stroke-dasharray": "@dash"
                            }
                        },
                        {
                            "type": "circle",
                            "props": {
                                "cx": 12,
                                "cy": 12,
                                "r": "@r",
                                "fill": "@fill",
                                "stroke": "#888",
                                "stroke-width": 1.5
                            }
                        }
                    ]
                }
            }
        }
    },
    "marks": [
        {"type": "line", "id": "lines", "by": "type", "stroke": "#888", "stroke-dasharray": "@dash"},
        {
            "type": "point",
            "id": "points",
            "by": "type",
            "filter": "@type != 'total'",
            "r": "@r",
            "fill": "@fill",
            "stroke": "#888"
        },
        {
            "type": "point",
            "id": "total",
            "by": "type",
            "filter": "@type == 'total'",
            "r": "@r",
            "fill": "white",
            "stroke": "@color:scaled",
            "stroke-width": 3
        },
        {
            "type": "point",
            "id": "last",
            "by": "type",
            "select": "last",
            "layer": "above",
            "filter": "@type == 'total'",
            "r": 17,
            "fill": "white",
            "stroke": "@color:scaled",
            "stroke-width": 5,
            "others": {"visibility": "hidden"}
        },
        {
            "type": "text",
            "id": "last-value",
            "by": "type",
            "select": "last",
            "layer": "above",
            "filter": "@type == 'total'",
            "text-anchor": "middle",
            "dominant-baseline": "central",
            "font-size": 11,
            "font-weight": "bold",
            "text": "@y:formatted",
            "fill": null,
            "others": {"visibility": "hidden"}
        },
        {
            "type": "text",
            "id": "last-year",
            "by": "type",
            "select": "last",
            "layer": "above",
            "filter": "@type == 'total'",
            "dy": 30,
            "text-anchor": "middle",
            "dominant-baseline": "central",
            "font-size": 11,
            "text": "@x:formatted",
            "fill": null,
            "others": {"visibility": "hidden"}
        },
        {
            "type": "point",
            "id": "ring",
            "by": "x",
            "layer": "above",
            "filter": "@type == 'total'",
            "r": 17,
            "fill": "white",
            "stroke": "@color:scaled",
            "stroke-width": 5,
            "visibility": "hidden",
            "highlight": {"visibility": "visible"}
        },
        {
            "type": "text",
            "id": "ring-value",
            "by": "x",
            "layer": "above",
            "filter": "@type == 'total'",
            "text-anchor": "middle",
            "dominant-baseline": "central",
            "font-size": 11,
            "font-weight": "bold",
            "text": "@y:formatted",
            "fill": null,
            "visibility": "hidden",
            "highlight": {"visibility": "visible"}
        },
        {
            "type": "text",
            "id": "ring-year",
            "by": "x",
            "layer": "above",
            "filter": "@type == 'total'",
            "dy": 30,
            "text-anchor": "middle",
            "dominant-baseline": "central",
            "font-size": 11,
            "text": "@x:formatted",
            "fill": null,
            "visibility": "hidden",
            "highlight": {"visibility": "visible"}
        }
    ],
    "annotations": [{"type": "line", "y": 100, "props": {"stroke": "#444", "stroke-dasharray": "2 3"}}]
}
