{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "_group.json",
    "subtitle": "Sub-indicators, Austria relative to the comparison group (= 100)",
    "margins": {"top": 34, "right": 50, "bottom": 6, "left": "=steps(@totalWidth, {0: 200, 760: 320})"},
    "locale": {"base": "en", "number": {"currency": ["", "%"]}},
    "class": "fti fti-bars",
    "message": "=steps(@totalWidth, {0: 'The display is too narrow, please rotate your device.', 480: null})",
    "hover": {"box": false, "marker": false, "area": "facet", "columns": []},
    "dims": {
        "x": {
            "column": "{group}",
            "axis": {
                "position": "top",
                "values": [0, 20, 40, 60, 80, 100, 120, 140, 160, 180, 200],
                "format": "d",
                "labels": {"props": {"font-size": 13, "font-weight": "bold"}}
            },
            "hover": {"format": ".1f"},
            "zero": true
        },
        "y": {
            "column": "label",
            "type": "categorical",
            "scale": {
                "padding": 0.45,
                "step": 23,
                "range": [0, "@height"],
                "groups": {"by": "group", "padding": 1}
            },
            "axis": {
                "padding": 19,
                "labels": {
                    "by": ["level"],
                    "props": {
                        "font-size": 13,
                        "font-weight": "@weight",
                        "fill": "#222",
                        "max-width": "=steps(@totalWidth, {0: 170, 760: 290})"
                    }
                }
            }
        },
        "group": "group",
        "color": {
            "column": "{group}",
            "domain": [74.5, 89.5, 99.5, 109.5],
            "scale": {
                "type": "threshold",
                "closed": "right",
                "range": ["#EA4B55", "#F59036", "#F9EB00", "#AFD24B", "#3CAF55"]
            }
        },
        "level": {
            "column": "level",
            "categories": {
                "header": {"bar": "#C2C2C2", "barHover": "#9A9A9A", "weight": "bold"},
                "item": {"bar": "#DCDCDC", "barHover": "#A6A6A6", "weight": "normal"}
            }
        },
        "io": {
            "column": "io",
            "categories": {
                "input": {"name": "Input", "fill": "white"},
                "output": {"name": "Output", "fill": "black"},
                "none": {"legend": false}
            },
            "legend": {
                "position": "bottom",
                "symbol": {
                    "type": "circle",
                    "size": 14,
                    "props": {"fill": "@fill", "stroke": "black", "stroke-width": 1.5}
                }
            }
        }
    },
    "marks": [
        {
            "type": "bar",
            "id": "bars",
            "by": "level",
            "orient": "horizontal",
            "fill": "@bar",
            "highlight": {"mode": "row", "fill": "@barHover"}
        },
        {
            "type": "svg:line",
            "id": "axis",
            "by": "group",
            "select": "first",
            "x1": "@x:scaled:0",
            "x2": "@x:scaled:0",
            "y1": "@y:group:start",
            "y2": "@y:group:end",
            "stroke": "black",
            "stroke-width": 1.5
        },
        {
            "type": "point",
            "id": "dots",
            "by": "level",
            "r": 7.5,
            "fill": "@color:scaled",
            "highlight": {"mode": "row", "r": 11}
        },
        {
            "type": "point",
            "id": "holes",
            "by": "level",
            "filter": "@level == 'header'",
            "r": 4.5,
            "fill": "white",
            "highlight": {"mode": "row", "r": 0}
        },
        {
            "type": "point",
            "id": "io",
            "by": "io",
            "filter": "@io != 'none'",
            "cx": "@x:scaled:0 + -14",
            "r": 5,
            "fill": "@fill",
            "stroke": "black",
            "stroke-width": 1.5
        },
        {
            "type": "text",
            "id": "value",
            "by": "level",
            "dx": 15,
            "dominant-baseline": "central",
            "font-size": 13,
            "font-weight": "bold",
            "text": "=format(@x, '$.0f')",
            "fill": null,
            "visibility": "hidden",
            "highlight": {"mode": "row", "visibility": "visible"}
        }
    ],
    "annotations": [{"type": "line", "x": 100, "props": {"stroke": "#BBB", "stroke-width": 1.5}}]
}
