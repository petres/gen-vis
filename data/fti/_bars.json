{
    "parent": "_group.json",
    "options": {
        "class": "fti fti-bars",
        "locale": { "base": "en", "number": { "currency": ["", "%"] } },
        "margins": {
            "top": 34,
            "right": 50,
            "bottom": 6,
            "left": { "steps": ["@totalWidth", { "0": 200, "760": 320 }] }
        },
        "message": { "steps": ["@totalWidth", { "0": "The display is too narrow, please rotate your device.", "480": null }] },
        "subtitle": "Sub-indicators, Austria relative to the comparison group (= 100)",
        "hover": { "box": false, "marker": false, "area": "facet" }
    },
    "mapping": {
        "x": {
            "column": "{group}",
            "domain": [0, null],
            "axis": {
                "position": "top", "values": [0, 20, 40, 60, 80, 100, 120, 140, 160, 180, 200], "format": "d",
                "labels": { "props": { "font-size": 13, "font-weight": "bold" } }
            },
            "hover": { "format": ".1f" }
        },
        "y": {
            "column": "label",
            "type": "categorical",
            "scale": { "padding": 0.45, "step": 23, "range": [0, "@height"], "groups": { "by": "group", "padding": 1 } },
            "axis": {
                "padding": 19,
                "labels": {
                    "categories": ["level"],
                    "props": {
                        "font-size": 13,
                        "font-weight": "@weight",
                        "fill": "#222",
                        "max-width": { "steps": ["@totalWidth", { "0": 170, "760": 290 }] }
                    }
                }
            }
        },
        "group": "group",
        "color": {
            "column": "{group}",
            "domain": [74.5, 89.5, 99.5, 109.5],
            "scale": {
                "type": "threshold",
                "closed": "right",
                "range": ["#EA4B55", "#F59036", "#F9EB00", "#AFD24B", "#3CAF55"]
            }
        },
        "level": {
            "column": "level",
            "categories": {
                "header": { "bar": "#C2C2C2", "barHover": "#9A9A9A", "weight": "bold" },
                "item": { "bar": "#DCDCDC", "barHover": "#A6A6A6", "weight": "normal" }
            }
        },
        "io": {
            "column": "io",
            "categories": {
                "input": { "name": "Input", "fill": "white" },
                "output": { "name": "Output", "fill": "black" },
                "none": { "legend": false }
            },
            "legend": { "position": "bottom", "symbol": { "type": "circle", "size": 14, "props": { "fill": "@fill", "stroke": "black", "stroke-width": 1.5 } } }
        }
    },
    "plot": [
        {
            "id": "bars",
            "type": "bar",
            "by": "level",
            "props": { "x1": "@x:scaled", "y": "@y:scaled", "fill": "@bar" },
            "highlight": { "mode": "row", "fill": "@barHover" }
        },
        {
            "id": "axis",
            "type": "svg:line",
            "by": "group",
            "select": "first",
            "props": { "x1": "@x:scaled:0", "x2": "@x:scaled:0", "y1": "@y:group:start", "y2": "@y:group:end", "stroke": "black", "stroke-width": 1.5 }
        },
        {
            "id": "dots",
            "type": "point",
            "by": "level",
            "props": { "cy": "@y:scaled:center", "r": 7.5, "fill": "@color:scaled" },
            "highlight": { "mode": "row", "r": 11 }
        },
        {
            "id": "holes",
            "type": "point",
            "by": "level",
            "filter": { "level": "header" },
            "props": { "cy": "@y:scaled:center", "r": 4.5, "fill": "white" },
            "highlight": { "mode": "row", "r": 0 }
        },
        {
            "id": "io",
            "type": "point",
            "by": "io",
            "filter": { "io": { "not": "none" } },
            "props": {
                "cx": { "+": ["@x:scaled:0", -14] },
                "cy": "@y:scaled:center",
                "r": 5,
                "fill": "@fill",
                "stroke": "black",
                "stroke-width": 1.5
            }
        },
        {
            "id": "value",
            "type": "svg:text",
            "by": "level",
            "props": {
                "x": "@x:scaled",
                "dx": 15,
                "y": "@y:scaled:center",
                "dominant-baseline": "central",
                "font-size": 13,
                "font-weight": "bold",
                "text": { "format": ["@x", "$.0f"] },
                "visibility": "hidden"
            },
            "highlight": { "mode": "row", "visibility": "visible" }
        }
    ],
    "annotations": [
        { "type": "line", "x": 100, "props": { "stroke": "#BBB", "stroke-width": 1.5 } }
    ]
}
