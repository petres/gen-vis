{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Spritpreis",
    "subtitle": "Diesel und Benzin, Durchschnitt der Tankstellen je Bundesland, in €/l",
    "source": "<strong>Quelle:</strong> Tankstellenpreise <a target='_blank' href='https://spritpreisrechner.at'>spritpreisrechner.at</a>",
    "height": 150,
    "locale": { "base": "de", "number": { "currency": ["", " €"] } },
    "dims": {
        "x": { "column": "date", "axis": { "values": ["2021-01-01", "2021-07-01", "2022-01-01"], "format": "%b %y" }, "hover": { "format": "%e. %b %Y" } },
        "y": { "column": "priceMean", "domain": [0.9, null], "nice": true, "ticks": 3, "grid": true, "axis": { "format": ".1f" }, "hover": { "format": "$.3f" } },
        "type": { "column": "fuelType", "legend": {}, "categories": { "DIE": { "name": "Diesel", "color": "#B5432B" }, "SUP": { "name": "Benzin", "color": "#2B6CB5" } } },
        "nuts": {
            "column": "nuts2",
            "categories": {
                "NA": { "name": "Österreich" }, "W": { "name": "Wien" }, "N": { "name": "Niederösterreich" }, "B": { "name": "Burgenland" },
                "O": { "name": "Oberösterreich" }, "Sa": { "name": "Salzburg" }, "St": { "name": "Steiermark" }, "K": { "name": "Kärnten" },
                "T": { "name": "Tirol" }, "V": { "name": "Vorarlberg" }
            }
        }
    },
    "facets": { "by": "nuts", "cols": "=steps(@totalWidth, {0: 2, 700: 3})", "scales": "shared" },
    "marks": { "type": "line", "by": "type", "stroke-width": 1.6, "highlight": { "stroke-width": 2.5 }, "others": { "stroke-opacity": 0.3 } }
}
