{
    "data": "data.csv",
    "options": {
        "coord": "geo",
        "height": 300,
        "margins": {
            "top": 10,
            "right": 10,
            "bottom": 10,
            "left": 10
        },
        "title": "Spritpreis",
        "subtitle": "Durchschnitt der Tankstellen nach Bundesland, in €/l, die Farben sind die des Stichtags",
        "footer": "<strong>Quelle:</strong> Tankstellenpreise <a target='_blank' href='https://spritpreisrechner.at'>spritpreisrechner.at</a>; Grenzen: © EuroGeographics"
    },
    "geo": {
        "data": "../geo/austria.json",
        "key": "code",
        "join": "nuts"
    },
    "globals": {
        "date": "2022-06-01"
    },
    "filter": {
        "date": "@date"
    },
    "formElements": [
        {
            "id": "date",
            "name": "Stichtag",
            "ref": "date",
            "type": "select",
            "values": [
                {
                    "id": "2021-01-01",
                    "name": "1. Jänner 2021",
                    "value": "2021-01-01"
                },
                {
                    "id": "2021-04-01",
                    "name": "1. April 2021",
                    "value": "2021-04-01"
                },
                {
                    "id": "2021-07-01",
                    "name": "1. Juli 2021",
                    "value": "2021-07-01"
                },
                {
                    "id": "2021-10-01",
                    "name": "1. Oktober 2021",
                    "value": "2021-10-01"
                },
                {
                    "id": "2022-01-01",
                    "name": "1. Jänner 2022",
                    "value": "2022-01-01"
                },
                {
                    "id": "2022-03-01",
                    "name": "1. März 2022",
                    "value": "2022-03-01"
                },
                {
                    "id": "2022-06-01",
                    "name": "1. Juni 2022",
                    "value": "2022-06-01"
                }
            ]
        }
    ],
    "mapping": {
        "date": "date",
        "type": {
            "column": "fuelType",
            "categories": {
                "DIE": {
                    "name": "Diesel"
                },
                "SUP": {
                    "name": "Benzin"
                }
            }
        },
        "nuts": "nuts2",
        "price": {
            "column": "priceMean",
            "scale": {
                "type": "sequential",
                "interpolator": "YlOrRd"
            },
            "legend": {
                "format": "$,.2f"
            },
            "hover": {
                "format": "$,.3f"
            },
            "name": "Preis in €/l"
        }
    },
    "facets": {
        "dim": "type",
        "cols": {
            "steps": ["@totalWidth", { "0": 1, "700": 2 }]
        }
    },
    "plot": [
        {
            "type": "geo:base",
            "props": {
                "fill": "#EEE",
                "stroke": "white"
            }
        },
        {
            "type": "geo:region",
            "by": "nuts",
            "props": {
                "fill": "@price:scaled",
                "stroke": "white",
                "stroke-width": 1
            },
            "highlight": { "stroke": "#333", "stroke-width": 2 }
        }
    ]
}
