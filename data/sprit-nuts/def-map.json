{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Spritpreis",
    "subtitle": "Durchschnitt der Tankstellen nach Bundesland, in €/l, die Farben sind die des Stichtags",
    "source": "<strong>Quelle:</strong> Tankstellenpreise <a target='_blank' href='https://spritpreisrechner.at'>spritpreisrechner.at</a>; Grenzen: © EuroGeographics",
    "height": 300,
    "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
    "coord": "geo",
    "globals": {"date": "2022-06-01"},
    "controls": [
        {
            "type": "select",
            "global": "date",
            "name": "Stichtag",
            "id": "date",
            "values": [
                {"id": "2021-01-01", "name": "1. Jänner 2021", "value": "2021-01-01"},
                {"id": "2021-04-01", "name": "1. April 2021", "value": "2021-04-01"},
                {"id": "2021-07-01", "name": "1. Juli 2021", "value": "2021-07-01"},
                {"id": "2021-10-01", "name": "1. Oktober 2021", "value": "2021-10-01"},
                {"id": "2022-01-01", "name": "1. Jänner 2022", "value": "2022-01-01"},
                {"id": "2022-03-01", "name": "1. März 2022", "value": "2022-03-01"},
                {"id": "2022-06-01", "name": "1. Juni 2022", "value": "2022-06-01"}
            ]
        }
    ],
    "filter": {"date": "@globals.date"},
    "dims": {
        "date": "date",
        "type": {"column": "fuelType", "categories": {"DIE": {"name": "Diesel"}, "SUP": {"name": "Benzin"}}},
        "nuts": "nuts2",
        "price": {
            "column": "priceMean",
            "scale": {"type": "sequential", "interpolator": "YlOrRd"},
            "legend": {"format": "$,.2f", "symbol": null},
            "hover": {"format": "$,.3f"},
            "name": "Preis in €/l"
        }
    },
    "marks": [
        {"type": "base", "fill": "#EEE", "stroke": "white"},
        {
            "type": "region",
            "by": "nuts",
            "fill": "@price:scaled",
            "stroke": "white",
            "stroke-width": 1,
            "highlight": {"stroke": "#333", "stroke-width": 2}
        }
    ],
    "facets": {"by": "type", "cols": "=steps(@totalWidth, {0: 1, 700: 2})"},
    "geo": {"data": "../geo/austria.json", "key": "code", "join": "nuts"},
    "hover": {"columns": []}
}
