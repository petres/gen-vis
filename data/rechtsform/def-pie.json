{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Wohnungsbestände nach Rechtsform {year}",
    "subtitle": "Anteile der Wohnungen",
    "source": "<strong>Q:</strong> GWZ/HWZ 1971-2001, RZ 2011, MZ 2020",
    "height": 340,
    "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
    "coord": "polar",
    "globals": {"year": "2020"},
    "controls": [
        {
            "type": "slider",
            "global": "year",
            "name": "Jahr",
            "id": "year",
            "values": {"column": "Jahr"}
        }
    ],
    "filter": {"year": "@globals.year"},
    "dims": {
        "year": {"column": "Jahr", "type": "categorical"},
        "count": {"column": "Anzahl", "scale": {"orientation": "angular"}, "hover": {"format": ",.0f"}},
        "type": {
            "column": "Type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {"x": 2, "y": 2, "width": 12, "height": 12, "fill": "@color"}
                        }
                    ]
                }
            },
            "categories": {
                "Hauseigentum": "#BBD7EE",
                "Wohnungseigentum": "#5BC5F2",
                "GBV Miete": "#559BD5",
                "Gemeinde Miete": "#C7DF71",
                "Private Miete": "#4B9847",
                "Sonstige": "#9CE1F8"
            }
        },
        "geo": {"column": "Geo", "categories": {"Österreich": {}, "Wien": {}}}
    },
    "marks": {
        "type": "arc",
        "by": "type",
        "stack": true,
        "x": "count",
        "stroke": "white",
        "stroke-width": 1,
        "innerRadius": "@radius * 0.55",
        "highlight": {"opacity": 0.8}
    },
    "facets": {"by": "geo", "cols": "=steps(@totalWidth, {0: 1, 600: 2})"}
}
