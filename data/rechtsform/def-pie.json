{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Wohnungsbestände nach Rechtsform {year}",
    "subtitle": "Anteile der Wohnungen",
    "source": "<strong>Q:</strong> GWZ/HWZ 1971-2001, RZ 2011, MZ 2020",
    "height": 340,
    "coord": "polar",
    "globals": { "year": "2020" },
    "controls": [{ "type": "slider", "global": "year", "name": "Jahr", "values": { "column": "Jahr" } }],
    "filter": { "year": "@globals.year" },
    "dims": {
        "year": "Jahr",
        "x": { "column": "Anzahl", "axis": false, "hover": { "format": ",.0f" } },
        "type": { "column": "Type", "legend": {}, "categories": {
            "Hauseigentum": "#BBD7EE", "Wohnungseigentum": "#5BC5F2", "GBV Miete": "#559BD5",
            "Gemeinde Miete": "#C7DF71", "Private Miete": "#4B9847", "Sonstige": "#9CE1F8" } },
        "geo": "Geo"
    },
    "facets": { "by": "geo", "cols": "=steps(@totalWidth, {0: 1, 600: 2})" },
    "marks": { "type": "arc", "by": "type", "stack": true, "stroke": "white", "stroke-width": 1, "innerRadius": "@radius * 0.55", "highlight": { "opacity": 0.8 } }
}
