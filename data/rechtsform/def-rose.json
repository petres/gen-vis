{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Wohnungsbestände nach Rechtsform",
    "subtitle": "Anzahl Wohnungen",
    "source": "<strong>Q:</strong> GWZ/HWZ 1971-2001, RZ 2011, MZ 2020",
    "height": 380,
    "coord": "polar",
    "dims": {
        "x": { "column": "Jahr", "type": "categorical", "scale": { "padding": 0.1 } },
        "y": {
            "column": "Anzahl", "zero": true, "ticks": 4, "grid": true,
            "scale": { "type": "sqrt", "range": [20, "@radius"] }, "axis": { "format": ".2s" }, "hover": { "format": ",.0f" }
        },
        "type": { "column": "Type", "legend": {}, "categories": {
            "Hauseigentum": "#BBD7EE", "Wohnungseigentum": "#5BC5F2", "GBV Miete": "#559BD5",
            "Gemeinde Miete": "#C7DF71", "Private Miete": "#4B9847", "Sonstige": "#9CE1F8" } },
        "geo": "Geo"
    },
    "facets": { "by": "geo", "cols": "=steps(@totalWidth, {0: 1, 700: 2})" },
    "marks": { "type": "arc", "by": "type", "stack": true, "stroke": "white", "stroke-width": 0.5, "highlight": { "opacity": 0.8 } }
}
