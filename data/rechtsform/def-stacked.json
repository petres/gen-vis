{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data.csv",
    "title": "Wohnungsbestände nach Rechtsform",
    "subtitle": "Anzahl Wohnungen",
    "source": "<strong>Q:</strong> GWZ/HWZ 1971-2001, RZ 2011, MZ 2020",
    "height": 400,
    "margins": {"top": 20, "right": 20, "bottom": 50, "left": 76},
    "dims": {
        "xx": {
            "column": "Jahr",
            "format": "c",
            "scale": {"orientation": "horizontal", "domainAbs": [-6, 6]},
            "axis": {"ticks": 6, "rotate": 0, "values": [1971, 1981, 1991, 2001, 2011, 2020]}
        },
        "yy": {
            "column": "Anzahl",
            "format": ",.0f",
            "scale": {"orientation": "vertical", "pad": [0, 0.02]},
            "axis": {"ticks": 8},
            "zero": true,
            "grid": true
        },
        "type": {
            "column": "Type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": "@stroke-width"
                            }
                        },
                        {"type": "circle", "props": {"cx": 8, "cy": 8, "r": "@r", "fill": "@color"}}
                    ]
                }
            },
            "common": {"visible": true, "stroke-width": 3, "r": 4},
            "categories": {
                "Hauseigentum": "#BBD7EE",
                "Wohnungseigentum": "#5BC5F2",
                "GBV Miete": "#559BD5",
                "Gemeinde Miete": "#C7DF71",
                "Private Miete": "#4B9847",
                "Sonstige": "#9CE1F8"
            }
        },
        "geo": {
            "column": "Geo",
            "legend": {"symbol": null},
            "categories": {"Österreich": {"name": "Österreich"}, "Wien": {"name": "Wien"}}
        }
    },
    "marks": [
        {
            "type": "bar",
            "by": "type",
            "stack": true,
            "y": "yy",
            "x": "xx",
            "opacity": 0.7,
            "width": "@innerWidth * 0.1",
            "highlight": {"mode": "row", "opacity": 1, "stroke": "#333", "stroke-width": 1.5}
        }
    ],
    "facets": {"by": "geo", "cols": 2, "scales": "own"}
}
