{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": ["_years.json", "_facets.json"],
    "dims": {
        "y": {"axis": {"format": ",.2f"}, "hover": {"format": ",.3r"}},
        "facet": {
            "column": "variable",
            "categories": {
                "rm7": {"name": "täglich (rollierender 7-Tages Durchschnitt)"},
                "cum": {"name": "kumuliert"}
            }
        }
    },
    "facets": {"cols": "=steps(@totalWidth, {0: 1, 850: 2})"},
    "hover": {"columns": ["x", "year"]}
}
