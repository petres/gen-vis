{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "dims": {
        "x": {
            "column": "date",
            "format": "%b %y",
            "scale": {"domainAbs": [-2000000000, 2000000000]},
            "axis": {"ticks": "@innerWidth * 0.017", "rotate": 35},
            "hover": {}
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "scale": {"pad": [0, 0.1]},
            "axis": {"ticks": 6, "format": ",.0f"},
            "hover": {"format": ",.1f"},
            "zero": true,
            "grid": true
        }
    }
}
