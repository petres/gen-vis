{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "fuel-prices-map.csv",
    "title": "Spritpreise in Europa",
    "subtitle": "Länder der EU, inkl. Steuern, in €/Liter, Stand 28.09.2026",
    "source": "Source: EC Weekly Oil Bulletin; Grenzen: © EuroGeographics",
    "height": 480,
    "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
    "coord": "geo",
    "globals": {"type": "euroSuper95"},
    "controls": [
        {
            "type": "radio",
            "global": "type",
            "name": "Kraftstoff",
            "id": "type",
            "values": [
                {"id": "euroSuper95", "name": "Benzin", "value": "euroSuper95"},
                {"id": "gasOil", "name": "Diesel", "value": "gasOil"},
                {"id": "heatingOil", "name": "Heizöl", "value": "heatingOil"}
            ]
        }
    ],
    "filter": {"type": "@globals.type"},
    "dims": {
        "country": "country",
        "type": "variable",
        "price": {
            "name": "€/Liter",
            "column": "value",
            "scale": {"type": "sequential", "interpolator": "YlOrRd"},
            "legend": {"format": ",.1f", "symbol": null},
            "hover": {"format": "$,.3f"}
        }
    },
    "hover": {"columns": []},
    "marks": [
        {"type": "base", "fill": "#EEE", "stroke": "white", "stroke-width": 0.5},
        {
            "type": "region",
            "by": "country",
            "fill": "@price:scaled",
            "stroke": "white",
            "stroke-width": 0.5,
            "highlight": {"stroke": "#333", "stroke-width": 1.5}
        }
    ],
    "geo": {
        "data": "../../geo/europe.json",
        "key": "id",
        "join": "country",
        "fit": "data",
        "include": [
            "AT",
            "BE",
            "BG",
            "CY",
            "CZ",
            "DE",
            "DK",
            "EE",
            "ES",
            "FI",
            "FR",
            "GR",
            "HR",
            "HU",
            "IE",
            "IT",
            "LT",
            "LU",
            "LV",
            "MT",
            "NL",
            "PL",
            "PT",
            "RO",
            "SE",
            "SI",
            "SK"
        ],
        "projection": {"type": "azimuthalEqualArea", "rotate": [-10, -52]}
    }
}
