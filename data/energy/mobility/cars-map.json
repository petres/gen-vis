{
    "parent": "../_europe-map.json",
    "data": "cars-map.csv",
    "options": {
        "title": "Pkw in Europa",
        "subtitle": "Anteile nach Kraftstoffart bzw. Energiequelle, jährlich",
        "footer": "Quelle: eurostat - road_eqr_carpda (Neuzulassungen), road_eqs_carpda (Bestand)"
    },
    "globals": {
        "series": "registrations",
        "type": "bev"
    },
    "filter": {
        "series": "@series",
        "type": "@type",
        "year": "@year"
    },
    "formElements": [
        {
            "id": "series",
            "name": "Daten",
            "ref": "series",
            "type": "radio",
            "values": [
                { "id": "registrations", "name": "Neuzulassungen", "value": "registrations" },
                { "id": "stock",         "name": "Bestand",        "value": "stock" }
            ]
        },
        {
            "id": "type",
            "name": "Kraftstoff",
            "ref": "type",
            "type": "radio",
            "values": [
                { "id": "bev",    "name": "Elektro",               "value": "bev" },
                { "id": "phev",   "name": "Plug-in-Hybrid",        "value": "phev" },
                { "id": "hybrid", "name": "Hybrid (ohne Plug-in)", "value": "hybrid" },
                { "id": "petrol", "name": "Benzin",                "value": "petrol" },
                { "id": "diesel", "name": "Diesel",                "value": "diesel" },
                { "id": "other",  "name": "Sonstige",              "value": "other" }
            ]
        },
        {
            "id": "year",
            "name": "Jahr",
            "ref": "year",
            "type": "slider",
            "values": { "column": "year" }
        }
    ],
    "mapping": {
        "series": { "column": "series", "type": "categorical" },
        "type": { "column": "type", "type": "categorical" },
        "year": { "column": "year", "type": "categorical" },
        "value": {
            "name": "Anteil",
            "column": "share",
            "type": "numeric",
            "scale": { "type": "sequentialSqrt", "interpolator": "Reds", "domain": [0, null], "nice": true },
            "legend": { "format": ".1~%" },
            "hover": { "format": ".1%" }
        }
    }
}
