{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "../_europe-map.json",
    "data": "cars-map.csv",
    "title": "Pkw in Europa",
    "subtitle": "Anteile nach Kraftstoffart bzw. Energiequelle, jährlich",
    "source": "Quelle: eurostat - road_eqr_carpda (Neuzulassungen), road_eqs_carpda (Bestand)",
    "globals": {"series": "registrations", "type": "bev"},
    "controls": [
        {
            "type": "radio",
            "global": "series",
            "name": "Daten",
            "id": "series",
            "values": [
                {"id": "registrations", "name": "Neuzulassungen", "value": "registrations"},
                {"id": "stock", "name": "Bestand", "value": "stock"}
            ]
        },
        {
            "type": "radio",
            "global": "type",
            "name": "Kraftstoff",
            "id": "type",
            "values": [
                {"id": "bev", "name": "Elektro", "value": "bev"},
                {"id": "phev", "name": "Plug-in-Hybrid", "value": "phev"},
                {"id": "hybrid", "name": "Hybrid (ohne Plug-in)", "value": "hybrid"},
                {"id": "petrol", "name": "Benzin", "value": "petrol"},
                {"id": "diesel", "name": "Diesel", "value": "diesel"},
                {"id": "other", "name": "Sonstige", "value": "other"}
            ]
        },
        {
            "type": "slider",
            "global": "year",
            "name": "Jahr",
            "id": "year",
            "values": {"column": "year"}
        }
    ],
    "filter": {"series": "@globals.series", "type": "@globals.type", "year": "@globals.year"},
    "dims": {
        "series": "series",
        "type": "type",
        "year": {"column": "year", "type": "categorical"},
        "value": {
            "name": "Anteil",
            "column": "share",
            "nice": true,
            "scale": {"type": "sequentialSqrt", "interpolator": "Reds"},
            "legend": {"format": ".1~%", "symbol": null},
            "hover": {"format": ".1%"},
            "zero": true
        }
    }
}
