{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "../_timeline.json",
    "data": "traffic.csv",
    "title": "Verkehrsaufkommen",
    "subtitle": "Autobahnen und Schnellstraßen, durchschnittlicher täglicher Verkehr, monatlich, Index (2025 = 100)",
    "source": "Source: ASFINAG - Dauerzählstellen",
    "height": "=steps(@totalWidth, {0: 220, 550: 250, 600: 280})",
    "margins": {"top": 5, "right": 30, "bottom": 45, "left": 50},
    "dims": {
        "road": {"column": "road", "categories": {"total": {"name": "Österreich"}}},
        "vehicle": {
            "column": "vehicle",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 16,
                                "y1": 8,
                                "y2": 8,
                                "stroke": "@color",
                                "stroke-width": "@stroke-width"
                            }
                        }
                    ]
                }
            },
            "common": {"stroke-width": 2, "highlight-stroke-width": 3},
            "categories": {
                "all": {"color": "#444444", "name": "Gesamt"},
                "light": {"color": "#4A96D4", "name": "Leicht (bis 3,5 t)"},
                "heavy": {"color": "#C3423F", "name": "Schwer (über 3,5 t)"}
            },
            "hover": {}
        }
    },
    "marks": {
        "type": "line",
        "by": ["road", "vehicle"],
        "curve": "monotoneX",
        "stroke-width": "@stroke-width",
        "highlight": {"stroke-width": "@highlight-stroke-width"}
    },
    "hover": {"columns": ["x", "y"]}
}
