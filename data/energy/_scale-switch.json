{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "globals": {"shareScale": ["x"]},
    "controls": [
        {
            "type": "radio",
            "global": "shareScale",
            "name": "Y-Skala",
            "id": "scale",
            "values": [
                {"id": "shareAxisOff", "value": ["x"], "name": "Getrennt"},
                {"id": "shareAxisOn", "value": ["x", "y"], "name": "Geteilt"}
            ],
            "inImage": false
        }
    ],
    "facets": {"scales": "@shareScale"}
}
