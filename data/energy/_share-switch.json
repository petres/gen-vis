{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "globals": {"values": "abs"},
    "controls": [
        {
            "type": "radio",
            "global": "values",
            "name": "Werte",
            "id": "values",
            "values": [
                {"id": "valuesAbs", "value": "abs", "name": "Absolut"},
                {"id": "valuesShare", "value": "share", "name": "Anteil"}
            ]
        }
    ],
    "dims": {
        "y": {
            "column": "=match(@values, {share: 'value.share'})",
            "domain": "=match(@values, {share: literal([0, 1])})",
            "scale": {"pad": "=match(@values, {share: literal([0, 0])})"},
            "axis": {"format": "=match(@values, {share: '.0%'})"},
            "hover": {"format": "=match(@values, {share: '.1%'})"}
        }
    }
}
