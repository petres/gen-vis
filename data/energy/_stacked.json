{
    "parent": "_timeline.json",
    "options": {
        "height": {
            "steps": ["@totalWidth", { "0": 220, "550": 260, "600": 300 }]
        },
        "margins": {"top": 15, "right": 30, "bottom": 45, "left": 50}
    },
    "mapping": {
        "y": {
            "stacked": true
        },
        "type": {
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "rect",
                        "props": {
                            "x": 0, "y": 0, "width": 16, "height": 15,
                            "fill": "@color", "rx": 2
                        }
                    }]
                }
            },
            "hover": {}
        }
    },
    "plot": [
        {
            "type": "bar",
            "by": "type",
            "props": {
                "fill": "@color",
                "opacity": 0.9,
                "y0": "@y:start:scaled",
                "y1": "@y:end:scaled",
                "width": { "*": ["@innerWidth", 0.008] }
            }
        }
    ]
}
