{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "_timeline.json",
    "height": "=steps(@totalWidth, {0: 220, 550: 260, 600: 300})",
    "margins": {"top": 15, "right": 30, "bottom": 45, "left": 50},
    "dims": {
        "y": {},
        "type": {
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {"x": 0, "y": 0, "width": 16, "height": 15, "fill": "@color", "rx": 2}
                        }
                    ]
                }
            }
        }
    },
    "marks": [{"type": "bar", "by": "type", "stack": true, "opacity": 0.9, "width": "@innerWidth * 0.008"}]
}
