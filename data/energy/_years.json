{
    "options": {
        "height": {
            "steps": ["@totalWidth", { "0": 220, "550": 250, "600": 280 }]
        },
        "margins": {"top": 5, "right": 30, "bottom": 30, "left": 50}
    },
    "mapping": {
        "x": {
            "column": "date20",
            "scale": { "domainAbs": [-0.2, 0.2] },
            "axis": {
                "ticks": { "*": ["@innerWidth", 0.017] },
                "rotate": 0,
                "format": "%b"
            },
            "hover": {
                "format": "%e. %b"
            }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "domain": [0, null],
            "scale": { "domainRel": [0, 0.1] },
            "axis": { "ticks": 6, "grid": true, "format": ",.0f" },
            "hover": {
                "format": ",.1f"
            }
        },
        "year": {
            "column": "year",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 16, "y1": 8, "y2": 8,
                            "stroke": "@color", 
                            "stroke-width": "@stroke-width",
                            "opacity": "@opacity"
                        }
                    }]
                }
            },
            "common": {
                "stroke-width": 2,
                "highlight-stroke-width": 3,
                "opacity": 0.6, 
                "highlight-opacity": 1
            },
            "categories": {
                "2019": { "color": "#BBBBBB", "opacity": 0.2},
                "2020": { "color": "#AAAAAA", "opacity": 0.2},
                "2021": { "color": "#cf90f0", "opacity": 0.2},
                "2022": { "color": "#86cae7", "opacity": 0.2},
                "2023": { "color": "#b5c969", "opacity": 0.5},
                "2024": { "color": "#f3d039", "opacity": 0.6},
                "2025": { "color": "#cf8e02", "opacity": 0.7},
                "2026": { "color": "#c3423f", "opacity": 1 }
            },
            "hover": {}
        }
    },
    "plot": {
        "type": "cartesian:line",
        "by": "year",
        "props": {
            "stroke-width": "@stroke-width",
            "fill": "none",
            "opacity": "@opacity",
            "stroke": "@color",
            "d": {
                "x": "@x:scaled",
                "y": "@y:scaled"
            }
        },
        "highlight": { "opacity": "@highlight-opacity", "stroke-width": "@highlight-stroke-width" }
    }
}
