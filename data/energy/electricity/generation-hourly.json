{
    "parent": "_sources.json",
    "data": "generation-hourly.csv",
    "options": {
        "height": 350,
        "margins": {"top": 5, "right": 30, "bottom": 35, "left": 50},
        "title": "Stromproduktion im Tagesverlauf",
        "subtitle": "im Jahr 2021, nach Quellen, in MWh",
        "footer": "Source: ENTSO-E - Aggregated Generation Per Type 16.1.B C"
    },
    "mapping": {
        "x": {
            "column": "hour",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "orientation": "horizontal"
            },
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.017
                },
                "position": "bottom",
                "format": "c"
            },
            "hover": {
                "format": "c"
            }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "scale": {
                "type": "linear",
                "orientation": "vertical",
                "domain": [0, null],
                "domainRel": [0, 0.13]
            },
            "stacked": true,
            "axis": {
                "ticks": 7,
                "position": "left",
                "grid": true,
                "format": ".2f"
            },
            "hover": {
                "format": ".2f"
            }
        },
        "type": {
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "rect",
                        "props": {
                            "x": 0, "y": 0, "width": 16, "height": 15,
                            "fill": "@color", "rx": 2
                        }
                    }]
                }
            },
            "props": {
                "common": {
                    "size": 2
                },
                "manual": {
                    "Waste":  { "color": "#ABD6A9", "name": "Müll" },
                    "Oil":    { "color": "#000",    "name": "Erdöl" },
                    "others": { "color": "#CCC",    "name": "Andere" }
                }
            },
            "hover": {
            }
        }
    },
    "plot": [
        {
            "type": "cartesian:bar",
            "categories": ["type"],
            "props": {
                "fill": "@color",
                "opacity": 0.9,
                "x": "@x:scaled",
                "y0": "@y:start:scaled",
                "y1": "@y:end:scaled",
                "width": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.025
                }
            }
        }
    ]
}
