{
    "parent": "_sources.json",
    "data": "generation-hourly.csv",
    "options": {
        "height": 360,
        "margins": {"top": 18, "right": 20, "bottom": 35, "left": 50},
        "title": "Stromproduktion im Tagesverlauf",
        "subtitle": "im Jahr 2021, nach Quellen, in MWh",
        "footer": "Source: ENTSO-E - Aggregated Generation Per Type 16.1.B C",
        "locale": { "base": "de", "number": { "currency": ["", " Uhr"] } },
        "highlight": { "transition": 120 }
    },
    "mapping": {
        "x": {
            "column": "hour",
            "type": "numeric",
            "scale": { "type": "linear", "orientation": "horizontal", "domain": [0, 23], "domainRel": [0, 0] },
            "axis": {
                "position": "bottom", "format": "$d",
                "values": { "prop": "steps", "ref": "totalWidth", "steps": [{ "cut": 0, "value": [0, 6, 12, 18] }, { "cut": 600, "value": [0, 3, 6, 9, 12, 15, 18, 21] }] }
            },
            "hover": { "format": "$d" }
        },
        "y": {
            "column": "value",
            "type": "numeric",
            "stacked": true,
            "scale": { "type": "linear", "orientation": "vertical", "domain": [0, null], "domainRel": [0, 0.1], "nice": true },
            "axis": { "position": "left", "ticks": 6, "grid": true, "format": ".1f" },
            "hover": { "format": ".2f" }
        },
        "type": {
            "legend": {
                "symbol": { "type": "rect", "size": 14 }
            },
            "props": {
                "categories": {
                    "Hydro":  { "text": "#0B5E80" },
                    "Wind":   { "text": "#2F5F8A" },
                    "Solar":  { "text": "#6B5500" },
                    "Gas":    { "text": "#FFFFFF" },
                    "Coal":   { "text": "#FFFFFF" },
                    "Oil":    { "color": "#000", "name": "Erdöl", "text": "#FFFFFF" },
                    "others": { "color": "#CCC", "name": "Andere", "text": "#444444" }
                }
            },
            "hover": {}
        }
    },
    "annotations": [
        { "type": "line", "x": 12, "label": "Mittag", "above": true, "props": { "stroke": "#333", "stroke-dasharray": "3 3" } }
    ],
    "plot": [
        {
            "id": "areas",
            "type": "cartesian:area",
            "categories": ["type"],
            "curve": "monotoneX",
            "layer": "below",
            "props": {
                "d": { "x": "@x:scaled", "y0": "@y:start:scaled", "y1": "@y:end:scaled" },
                "fill": "@color",
                "fill-opacity": 0.9,
                "stroke": "#FFFFFF",
                "stroke-width": 0.8,
                "highlight-fill-opacity": 1,
                "others-fill-opacity": 0.35
            }
        },
        {
            "id": "names",
            "type": "svg:text",
            "categories": ["type"],
            "select": { "max": "y" },
            "filter": { "y": { "range": [0.075, null] } },
            "layer": "above",
            "props": {
                "x": "@x:scaled", "y": "@y:mid:scaled", "text-anchor": "middle", "dominant-baseline": "central",
                "font-size": 11, "font-weight": "bold", "fill": "@text", "text": "@name",
                "pointer-events": "none", "highlight-opacity": 1, "others-opacity": 0.3
            }
        }
    ]
}
