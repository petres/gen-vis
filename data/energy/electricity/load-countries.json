{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": ["../_years.json", "../_facets.json", "../_scale-switch.json"],
    "data": "load-countries.csv",
    "transform": [
        {"type": "year", "column": "date", "as": "year"},
        {"type": "align", "column": "date", "as": "date20"}
    ],
    "title": "Stromkonsum",
    "subtitle": "täglich (rollierender 7-Tages Durchschnitt), in GWh",
    "source": "Quelle: ENTSO-E - Actual Total Load 6.1.A",
    "height": 190,
    "margins": {"top": 5, "right": 15, "bottom": 35, "left": 45},
    "dims": {
        "y": {"scale": {"pad": [0, 0.15]}, "axis": {"ticks": 4}, "hover": {"format": ".1f"}},
        "facet": {
            "column": "country",
            "categories": {
                "BE": {"name": "Belgien", "visible": false},
                "DE": {"name": "Deutschland", "visible": true},
                "FR": {"name": "Frankreich", "visible": true},
                "IT": {"name": "Italien", "visible": true},
                "NL": {"name": "Niederlande", "visible": false},
                "NO": {"name": "Norwegen", "visible": false},
                "PL": {"name": "Polen", "visible": false},
                "SE": {"name": "Schweden", "visible": false},
                "CH": {"name": "Schweiz", "visible": true},
                "SK": {"name": "Slowakei", "visible": false},
                "SI": {"name": "Slowenien", "visible": false},
                "ES": {"name": "Spanien", "visible": false},
                "CZ": {"name": "Tschechische Republik", "visible": false},
                "HU": {"name": "Ungarn", "visible": true},
                "AT": {"name": "Österreich", "visible": true}
            },
            "legend": {"symbol": null}
        }
    },
    "marks": {"highlight": {"stroke-width": 2.5}},
    "hover": {"columns": ["x", "year"]}
}
