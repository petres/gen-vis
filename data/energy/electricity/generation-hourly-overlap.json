{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "parent": "_sources.json",
    "data": "generation-hourly.csv",
    "title": "Wasser, Wind und Sonne im Tagesverlauf, nicht gestapelt",
    "subtitle": "im Jahr 2021, in MWh, die Namen in ihren Flächen",
    "source": "Source: ENTSO-E - Aggregated Generation Per Type 16.1.B C",
    "height": 300,
    "margins": {"top": 18, "right": 20, "bottom": 35, "left": 50},
    "locale": {"base": "de", "number": {"currency": ["", " Uhr"]}},
    "highlight": {"transition": 120},
    "filter": {"type": ["Hydro", "Wind", "Solar"]},
    "dims": {
        "x": {
            "column": "hour",
            "domain": [0, 23],
            "format": "$d",
            "scale": {"pad": [0, 0]},
            "axis": {
                "values": "=steps(@totalWidth, {0: literal([0, 6, 12, 18]), 600: literal([0, 3, 6, 9, 12, 15, 18, 21])})"
            },
            "hover": {}
        },
        "y": {
            "column": "value",
            "nice": true,
            "scale": {"pad": [0, 0.1]},
            "axis": {"ticks": 6, "format": ".1f"},
            "hover": {"format": ".2f"},
            "zero": true,
            "grid": true
        },
        "type": {
            "legend": {"symbol": {"type": "rect", "size": 14}, "onlyData": true},
            "categories": {
                "Hydro": {"text": "#0B5E80"},
                "Wind": {"text": "#2F5F8A"},
                "Solar": {"text": "#6B5500"},
                "Gas": {"text": "#FFFFFF"},
                "Coal": {"text": "#FFFFFF"},
                "Oil": {"color": "#000", "name": "Erdöl", "text": "#FFFFFF"},
                "others": {"color": "#CCC", "name": "Andere", "text": "#444444"}
            },
            "hover": {}
        }
    },
    "marks": [
        {
            "type": "area",
            "id": "areas",
            "by": "type",
            "curve": "monotoneX",
            "layer": "below",
            "fill-opacity": 0.45,
            "stroke": "@color",
            "stroke-width": 1.5,
            "highlight": {"fill-opacity": 1},
            "others": {"fill-opacity": 0.35}
        },
        {
            "type": "text",
            "id": "names",
            "by": "type",
            "layer": "above",
            "place": {"in": "areas"},
            "halo": true,
            "filter": "=1 <= @x <= 22",
            "font-size": 11,
            "font-weight": "bold",
            "fill": "#1F2328",
            "text": "@name",
            "pointer-events": "none",
            "highlight": {"opacity": 1},
            "others": {"opacity": 0.3}
        }
    ],
    "annotations": []
}
