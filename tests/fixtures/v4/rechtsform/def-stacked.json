{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "data": "data.csv",
    "options": {
        "height": 400,
        "margins": {"top": 20, "right": 20, "bottom": 50, "left": 76},
        "title": "Wohnungsbestände nach Rechtsform",
        "subtitle": "Anzahl Wohnungen",
        "footer": "<strong>Q:</strong> GWZ/HWZ 1971-2001, RZ 2011, MZ 2020"
    },
    "mapping": {
        "xx": {
            "column": "Jahr",
            "format": "c",
            "scale": { "orientation": "horizontal", "domainAbs": [-6, 6] },
            "axis": {
                "ticks": 6,
                "rotate": 0,
                "values": [1971, 1981, 1991, 2001, 2011, 2020]
            },
            "hover": {}
        },
        "yy": {
            "column": "Anzahl",
            "domain": [0, null],
            "format": ",.0f",
            "stacked": true,
            "scale": { "domainRel": [0, 0.02], "orientation": "vertical" },
            "axis": { "ticks": 8, "grid": true },
            "hover": {}
        },
        "type": {
            "column": "Type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 16, "y1": 8, "y2": 8,
                            "stroke": "@color", "stroke-width": "@stroke-width"
                        }
                    }, {
                        "type": "circle",
                        "props": {
                            "cx": 8, "cy": 8, "r": "@r",
                            "fill": "@color"
                        }
                    }]
                }
            },
            "common": {
                "visible": true,
                "stroke-width": 3,
                "r": 4
            },
            "categories": {
                "Hauseigentum":     { "color": "#BBD7EE"},
                "Wohnungseigentum": { "color": "#5BC5F2"},
                "GBV Miete":        { "color": "#559BD5"},
                "Gemeinde Miete":   { "color": "#C7DF71"},
                "Private Miete":    { "color": "#4B9847"},
                "Sonstige":         { "color": "#9CE1F8"}
            },
            "hover": {}
        },
        "geo": {
            "column": "Geo",
            "legend": {},
            "categories": {
                "Österreich": { "name": "Österreich"},
                "Wien": { "name": "Wien"}
            }
        }
    },
    "facets": {
        "dim": "geo",
        "scales": [],
        "cols": 2
    },
    "plot": [
        {
            "type": "bar",
            "by": "type",
            "props": {
                "fill": "@color",
                "opacity": 0.7,
                "x": "@xx:scaled",
                "y0": "@yy:start:scaled",
                "y1": "@yy:end:scaled",
                "width": { "*": ["@innerWidth", 0.1] }
            },
            "highlight": { "mode": "row", "opacity": 1, "stroke": "#333", "stroke-width": 1.5 }
        }
    ]
}
