{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "data": "data.csv",
    "options": {
        "height": { "steps": ["@totalWidth", { "0": 300, "700": 380 }] },
        "margins": {"top": 34, "right": 118, "bottom": 28, "left": 44},
        "title": "Ausstattungsqualität",
        "subtitle": "Anteil der Wohnungen und Häuser mit WC im Wohnungsverband, 1971 bis 2001",
        "footer": "<strong>Q:</strong> Statistik Austria (2021c)"
    },
    "mapping": {
        "x": {
            "column": "Jahr",
            "format": "d",
            "scale": { "domainRel": [0, 0], "inset": [6, 6] },
            "axis": { "values": [1971, 1981, 1991, 2001] },
            "hover": {}
        },
        "y": {
            "column": "Anteil",
            "domain": [0.4, 1],
            "scale": { "domainRel": [0, 0] },
            "axis": { "ticks": 4, "grid": true, "format": ".0%" },
            "hover": { "format": ".1%" }
        },
        "type": {
            "column": "Wohnungssegment",
            "scheme": "Tableau10",
            "common": { "width": 2 },
            "categories": {
                "Hauseigentum": {}, "Wohnungseigentum": {}, "GBV Miete": {}, "Kommunale Miete": {},
                "Private Miete": {}, "Sonstiges": {},
                "Alle Haushalte": { "color": "#111", "width": 3.5 }
            },
            "hover": {}
        },
        "einheit": { "column": "Einheit", "categories": { "Österreich": {}, "Wien": {} } }
    },
    "facets": { "dim": "einheit", "scales": ["y"], "cols": { "steps": ["@totalWidth", { "0": 1, "700": 2 }] } },
    "plot": [
        {
            "id": "lines",
            "type": "line",
            "by": "type",
            "props": { "stroke": "@color", "stroke-width": "@width" },
            "highlight": { "stroke-width": 4 },
            "others": { "stroke-opacity": 0.25 }
        },
        { "id": "points", "type": "point", "by": "type", "props": { "fill": "@color" }, "highlight": { "r": 4.5 }, "others": { "opacity": 0.25 } },
        {
            "id": "labels",
            "type": "text",
            "by": "type",
            "select": "last",
            "dodge": 12,
            "props": {
                "dx": 8,
                "dominant-baseline": "central",
                "font-size": 11,
                "text": "@name"
            },
            "highlight": { "font-weight": "bold" },
            "others": { "opacity": 0.3 }
        }
    ]
}
