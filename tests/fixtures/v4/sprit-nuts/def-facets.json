{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "data": "data.csv",
    "options": {
        "height": 150,
        "margins": {"top": 6, "right": 18, "bottom": 22, "left": 34},
        "title": "Spritpreis",
        "subtitle": "Diesel und Benzin, Durchschnitt der Tankstellen je Bundesland, in €/l",
        "footer": "<strong>Quelle:</strong> Tankstellenpreise <a target='_blank' href='https://spritpreisrechner.at'>spritpreisrechner.at</a>",
        "locale": { "base": "de", "number": { "currency": ["", " €"] } }
    },
    "facets": {
        "dim": "nuts",
        "cols": { "steps": ["@totalWidth", { "0": 2, "700": 3 }] },
        "scales": ["x", "y"]
    },
    "mapping": {
        "x": {
            "column": "date",
            "axis": { "values": ["2021-01-01", "2021-07-01", "2022-01-01"], "format": "%b %y" },
            "hover": { "format": "%e. %b %Y" }
        },
        "y": {
            "column": "priceMean",
            "domain": [0.9, null],
            "nice": true,
            "axis": { "ticks": 3, "grid": true, "format": ".1f" },
            "hover": { "format": "$.3f" }
        },
        "type": {
            "column": "fuelType",
            "legend": { "symbol": "line" },
            "categories": { "DIE": { "name": "Diesel", "color": "#B5432B" }, "SUP": { "name": "Benzin", "color": "#2B6CB5" } },
            "hover": {}
        },
        "nuts": {
            "column": "nuts2",
            "categories": {
                "NA": { "name": "Österreich" }, "W": { "name": "Wien" }, "N": { "name": "Niederösterreich" }, "B": { "name": "Burgenland" },
                "O": { "name": "Oberösterreich" }, "Sa": { "name": "Salzburg" }, "St": { "name": "Steiermark" },
                "K": { "name": "Kärnten" }, "T": { "name": "Tirol" }, "V": { "name": "Vorarlberg" }
            }
        }
    },
    "plot": [
        {
            "id": "lines",
            "type": "line",
            "by": "type",
            "props": { "stroke": "@color", "stroke-width": 1.6 },
            "highlight": { "stroke-width": 2.5 },
            "others": { "stroke-opacity": 0.3 }
        }
    ]
}
