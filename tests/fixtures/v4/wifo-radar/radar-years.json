{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "parent": "_radar.json",
    "options": {
        "title": "Radar der Wettbewerbsfähigkeit: Zeitvergleich",
        "subtitle": "Die Prozentränge von {country} in den Jahren, unter den Ländern der EU, Norwegen, Island, der Schweiz und dem Vereinigten Königreich",
        "hover": {
            "row": "{year}: <b>{y}</b>"
        }
    },
    "globals": {
        "country": "Österreich"
    },
    "filter": {
        "countryName": "@country"
    },
    "formElements": [
        {
            "id": "country",
            "name": "Land",
            "ref": "country",
            "type": "select",
            "values": {
                "column": "countryName"
            }
        }
    ],
    "mapping": {
        "countryName": "countryName",
        "year": {
            "column": "year",
            "hover": {},
            "legend": {
                "position": "bottom",
                "symbol": {
                    "size": 14,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {
                                "x": 1,
                                "y": 1,
                                "width": 12,
                                "height": 12,
                                "fill": "@color"
                            }
                        }
                    ]
                }
            },
            "fromData": true,
            "order": "ascending",
            "scheme": "Tableau10",
            "common": {
                "visible": false
            },
            "categories": {
                "2019": {
                    "visible": true,
                    "color": "#C3423F"
                },
                "2020": {
                    "visible": true,
                    "color": "#559BD5"
                }
            }
        }
    },
    "plot": [
        {
            "id": "areas",
            "type": "area",
            "by": "year",
            "curve": "linearClosed",
            "props": {
                "fill": "@color",
                "d": {
                    "innerRadius": 0
                },
                "fill-opacity": 0.08
            },
            "highlight": { "fill-opacity": 0.2 }
        },
        {
            "id": "lines",
            "type": "line",
            "by": "year",
            "curve": "linearClosed",
            "props": { "stroke": "@color", "stroke-width": 2.5 },
            "highlight": { "stroke-width": 4 }
        },
        {
            "id": "points",
            "type": "point",
            "by": "year",
            "props": { "fill": "@color", "r": 5 },
            "highlight": { "r": 6 }
        }
    ]
}
