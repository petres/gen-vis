{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "options": {
        "height": 150,
        "margins": { "top": 26, "right": 36, "bottom": 24, "left": 62 },
        "locale": { "base": "en", "number": { "currency": ["", " °C"] } },
        "footer": "Source: <a href=\"https://www.ecad.eu/\">ECA&amp;D</a>, the original charts on <a href=\"https://ecad.abteil.org/\">ecad.abteil.org</a>"
    },
    "globals": { "year": "2023" },
    "transform": [
        { "type": "calc", "as": "v", "expr": { "*": [{ "+": ["@value"] }, 0.1] } },
        { "type": "mean", "column": "v", "as": "avg" }
    ],
    "formElements": [
        { "id": "year", "name": "Year", "ref": "year", "type": "slider", "values": { "column": "date" } }
    ],
    "mapping": {
        "x": {
            "column": "date", "format": "d",
            "scale": { "domainRel": [0, 0] },
            "axis": { "position": "top", "ticks": 5, "grid": true },
            "hover": {}
        },
        "y": {
            "column": "v", "format": "$.1f",
            "scale": { "domainRel": [0, 0] },
            "axis": { "ticks": 3, "grid": true },
            "hover": {}
        },
        "avg": { "column": "avg", "scale": { "of": "y" }, "hover": { "format": "$.1f" } }
    },
    "plot": [
        {
            "id": "line", "type": "line",
            "props": { "stroke": "#444", "stroke-width": 1.5 }
        },
        {
            "id": "avg", "type": "line",
            "props": { "stroke": "#9cb806", "stroke-width": 1.5, "stroke-opacity": 0.5, "d": { "y": "@avg:scaled" } }
        }
    ],
    "annotations": [
        { "type": "line", "x": "@year", "label": "{year}", "props": { "stroke": "#444", "stroke-width": 2 } }
    ]
}
