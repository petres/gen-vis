{
    "data": "data.csv",
    "options": {
        "coord": "geo",
        "height": 380,
        "margins": {
            "top": 10,
            "right": 10,
            "bottom": 10,
            "left": 10
        },
        "title": "Bevölkerung",
        "subtitle": "nach Bundesland, die Fläche der Kreise entspricht der Einwohnerzahl",
        "footer": "Q: Statistik Austria; Grenzen: © EuroGeographics"
    },
    "geo": {
        "data": "../geo/austria.json",
        "key": "name",
        "join": "land"
    },
    "globals": {
        "year": "2022"
    },
    "filter": {
        "year": "@year"
    },
    "formElements": [
        {
            "id": "year",
            "name": "Jahr",
            "ref": "year",
            "type": "select",
            "values": [
                {
                    "id": "2002",
                    "name": "2002",
                    "value": "2002"
                },
                {
                    "id": "2007",
                    "name": "2007",
                    "value": "2007"
                },
                {
                    "id": "2012",
                    "name": "2012",
                    "value": "2012"
                },
                {
                    "id": "2017",
                    "name": "2017",
                    "value": "2017"
                },
                {
                    "id": "2022",
                    "name": "2022",
                    "value": "2022"
                }
            ]
        }
    ],
    "mapping": {
        "year": {
            "column": "Jahr",
            "type": "categorical"
        },
        "land": {
            "column": "Bundesland",
            "type": "categorical",
            "props": {
                "categories": {
                    "ÖSTERREICH": {
                        "visible": false
                    },
                    "Wien": {},
                    "Niederösterreich": {},
                    "Burgenland": {},
                    "Oberösterreich": {},
                    "Salzburg": {},
                    "Steiermark": {},
                    "Kärnten": {},
                    "Tirol": {},
                    "Vorarlberg": {}
                }
            }
        },
        "pop": {
            "column": "Einwohner",
            "type": "numeric",
            "scale": {
                "type": "sqrt",
                "domain": [
                    0,
                    2000000
                ],
                "range": [
                    0,
                    34
                ]
            },
            "hover": {
                "format": ",.0f"
            }
        }
    },
    "plot": [
        {
            "type": "geo:base",
            "props": {
                "fill": "#E6EEF4",
                "stroke": "white",
                "stroke-width": 1.5
            }
        },
        {
            "type": "geo:circle",
            "categories": [
                "land"
            ],
            "props": {
                "r": "@pop:scaled",
                "fill": "#1E4F77",
                "fill-opacity": 0.65,
                "stroke": "white",
                "stroke-width": 1,
                "highlight-fill-opacity": 0.9
            }
        },
        {
            "type": "geo:text",
            "categories": [
                "land"
            ],
            "props": {
                "text": "@name",
                "font-size": 11,
                "text-anchor": "middle",
                "dy": "0.35em",
                "fill": "#222",
                "stroke": "white",
                "stroke-width": 3,
                "paint-order": "stroke"
            }
        }
    ]
}
