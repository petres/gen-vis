{
    "parent": "_radar.json",
    "options": {
        "title": "Radar der Wettbewerbsfähigkeit: Ländervergleich",
        "subtitle": "Die Prozentränge der Länder in der EU, Norwegen, Island, der Schweiz und dem Vereinigten Königreich {year}",
        "hover": {
            "row": "{country}: <b>{y}</b>"
        }
    },
    "globals": {
        "year": "2019"
    },
    "filter": {
        "year": "@year"
    },
    "formElements": [
        {
            "id": "year",
            "name": "Jahr",
            "ref": "year",
            "type": "slider",
            "values": {
                "column": "year"
            }
        }
    ],
    "mapping": {
        "country": {
            "column": "countryName",
            "type": "categorical",
            "hover": {},
            "legend": {
                "position": {
                    "prop": "steps",
                    "ref": "totalWidth",
                    "steps": [
                        {
                            "cut": 0,
                            "value": "bottom"
                        },
                        {
                            "cut": 760,
                            "value": "right"
                        }
                    ]
                },
                "orientation": "vertical",
                "symbol": {
                    "size": 14,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {
                                "x": 1,
                                "y": 1,
                                "width": 12,
                                "height": 12,
                                "fill": "@color"
                            }
                        }
                    ]
                }
            },
            "props": {
                "common": {
                    "visible": false
                },
                "categories": {
                    "Österreich": {
                        "color": "#C3423F",
                        "visible": true
                    },
                    "Belgien": {
                        "color": "#72BB6F"
                    },
                    "Bulgarien": {
                        "color": "#F3D039"
                    },
                    "Dänemark": {
                        "color": "#559E8F"
                    },
                    "Deutschland": {
                        "color": "#559BD5",
                        "visible": true
                    },
                    "Estland": {
                        "color": "#12A7E7"
                    },
                    "Finnland": {
                        "color": "#96B428"
                    },
                    "Frankreich": {
                        "color": "#E7B3B1"
                    },
                    "Griechenland": {
                        "color": "#BBD7EE"
                    },
                    "Irland": {
                        "color": "#C7E3C6"
                    },
                    "Island": {
                        "color": "#FAEBAF"
                    },
                    "Italien": {
                        "color": "#B9D9D2"
                    },
                    "Kroatien": {
                        "color": "#9CDCF8"
                    },
                    "Lettland": {
                        "color": "#D9EA9F"
                    },
                    "Litauen": {
                        "color": "#62201E"
                    },
                    "Luxemburg": {
                        "color": "#1E4F77"
                    },
                    "Malta": {
                        "color": "#336530"
                    },
                    "Niederlande": {
                        "color": "#8C7209"
                    },
                    "Norwegen": {
                        "color": "#2B4F47"
                    },
                    "Polen": {
                        "color": "#095373"
                    },
                    "Portugal": {
                        "color": "#4A5A14"
                    },
                    "Rumänien": {
                        "color": "#C3423F"
                    },
                    "Schweden": {
                        "color": "#559BD5"
                    },
                    "Schweiz": {
                        "color": "#72BB6F"
                    },
                    "Slowakei": {
                        "color": "#F3D039"
                    },
                    "Slowenien": {
                        "color": "#559E8F"
                    },
                    "Spanien": {
                        "color": "#12A7E7"
                    },
                    "Tschechien": {
                        "color": "#96B428"
                    },
                    "Ungarn": {
                        "color": "#E7B3B1"
                    },
                    "Vereinigtes Königreich": {
                        "color": "#BBD7EE"
                    },
                    "Zypern": {
                        "color": "#C7E3C6"
                    }
                }
            }
        },
        "year": {
            "column": "year",
            "type": "categorical"
        }
    },
    "plot": [
        {
            "id": "areas",
            "type": "polar:area",
            "categories": [
                "country"
            ],
            "curve": "linearClosed",
            "props": {
                "fill": "@color",
                "fill-opacity": 0.08,
                "d": {
                    "angle": "@x:scaled",
                    "innerRadius": 0,
                    "outerRadius": "@y:scaled"
                },
                "highlight-fill-opacity": 0.2
            }
        },
        {
            "id": "lines",
            "type": "polar:line",
            "categories": [
                "country"
            ],
            "curve": "linearClosed",
            "props": {
                "fill": "none",
                "stroke": "@color",
                "stroke-width": 2.5,
                "d": {
                    "angle": "@x:scaled",
                    "radius": "@y:scaled"
                },
                "highlight-stroke-width": 4
            }
        },
        {
            "id": "points",
            "type": "polar:circle",
            "categories": [
                "country"
            ],
            "props": {
                "fill": "@color",
                "r": 5,
                "angle": "@x:scaled",
                "radius": "@y:scaled",
                "highlight-r": 6
            }
        }
    ]
}
