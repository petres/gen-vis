{
    "parent": "_radar.json",
    "options": {
        "title": "Radar der Wettbewerbsfähigkeit: Zeitvergleich",
        "subtitle": "Die Prozentränge von {country} in den Jahren, unter den Ländern der EU, Norwegen, Island, der Schweiz und dem Vereinigten Königreich",
        "hover": {
            "row": "{year}: <b>{y}</b>"
        }
    },
    "globals": {
        "country": "Österreich"
    },
    "filter": {
        "countryName": "@country"
    },
    "formElements": [
        {
            "id": "country",
            "name": "Land",
            "ref": "country",
            "type": "select",
            "values": {
                "column": "countryName"
            }
        }
    ],
    "mapping": {
        "countryName": {
            "column": "countryName",
            "type": "categorical"
        },
        "year": {
            "column": "year",
            "type": "categorical",
            "hover": {},
            "legend": {
                "position": "bottom",
                "symbol": {
                    "size": 14,
                    "elements": [
                        {
                            "type": "rect",
                            "props": {
                                "x": 1,
                                "y": 1,
                                "width": 12,
                                "height": 12,
                                "fill": "@color"
                            }
                        }
                    ]
                }
            },
            "props": {
                "fromData": true,
                "order": "ascending",
                "scheme": "Tableau10",
                "common": {
                    "visible": false
                },
                "categories": {
                    "2019": {
                        "visible": true,
                        "color": "#C3423F"
                    },
                    "2020": {
                        "visible": true,
                        "color": "#559BD5"
                    }
                }
            }
        }
    },
    "plot": [
        {
            "id": "areas",
            "type": "polar:area",
            "categories": [
                "year"
            ],
            "curve": "linearClosed",
            "props": {
                "fill": "@color",
                "fill-opacity": 0.08,
                "d": {
                    "angle": "@x:scaled",
                    "innerRadius": 0,
                    "outerRadius": "@y:scaled"
                },
                "highlight-fill-opacity": 0.2
            }
        },
        {
            "id": "lines",
            "type": "polar:line",
            "categories": [
                "year"
            ],
            "curve": "linearClosed",
            "props": {
                "fill": "none",
                "stroke": "@color",
                "stroke-width": 2.5,
                "d": {
                    "angle": "@x:scaled",
                    "radius": "@y:scaled"
                },
                "highlight-stroke-width": 4
            }
        },
        {
            "id": "points",
            "type": "polar:circle",
            "categories": [
                "year"
            ],
            "props": {
                "fill": "@color",
                "r": 5,
                "angle": "@x:scaled",
                "radius": "@y:scaled",
                "highlight-r": 6
            }
        }
    ]
}
