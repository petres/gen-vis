{
    "data": "data.csv",
    "options": {
        "coord": "polar",
        "height": 340,
        "margins": {"top": 10, "right": 10, "bottom": 10, "left": 10},
        "title": "Wohnungsbestände nach Rechtsform {year}",
        "subtitle": "Anteile der Wohnungen",
        "footer": "<strong>Q:</strong> GWZ/HWZ 1971-2001, RZ 2011, MZ 2020"
    },
    "globals": { "year": "2020" },
    "filter": { "year": "@year" },
    "formElements": [
        { "id": "year", "name": "Jahr", "ref": "year", "type": "slider", "values": { "column": "Jahr" } }
    ],
    "mapping": {
        "year": { "column": "Jahr", "type": "categorical" },
        "count": {
            "column": "Anzahl",
            "type": "numeric",
            "stacked": true,
            "scale": { "orientation": "angular" },
            "hover": { "format": ",.0f" }
        },
        "type": {
            "column": "Type",
            "type": "categorical",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{ "type": "rect", "props": { "x": 2, "y": 2, "width": 12, "height": 12, "fill": "@color" } }]
                }
            },
            "props": {
                "categories": {
                    "Hauseigentum":     { "color": "#BBD7EE" },
                    "Wohnungseigentum": { "color": "#5BC5F2" },
                    "GBV Miete":        { "color": "#559BD5" },
                    "Gemeinde Miete":   { "color": "#C7DF71" },
                    "Private Miete":    { "color": "#4B9847" },
                    "Sonstige":         { "color": "#9CE1F8" }
                }
            },
            "hover": {}
        },
        "geo": {
            "column": "Geo",
            "type": "categorical",
            "props": { "categories": { "Österreich": {}, "Wien": {} } }
        }
    },
    "facets": {
        "dim": "geo",
        "cols": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [{"cut": 0, "value": 1}, {"cut": 600, "value": 2}]
        }
    },
    "plot": {
        "type": "polar:arc",
        "categories": ["type"],
        "props": {
            "fill": "@color",
            "stroke": "white",
            "stroke-width": 1,
            "startAngle": "@count:start:scaled",
            "endAngle": "@count:end:scaled",
            "innerRadius": { "prop": "relative", "ref": "radius", "ratio": 0.55 },
            "highlight-opacity": 0.8
        }
    }
}
