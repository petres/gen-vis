{
    "parent": "../_timeline.json",
    "data": "price-index.csv",
    "options": {
        "height": {
            "prop": "steps",
            "ref": "totalWidth",
            "steps": [
                {"cut":   0, "value": 250},
                {"cut": 550, "value": 280},
                {"cut": 600, "value": 320}
            ]
        },
        "margins": {"top": 5, "right": 30, "bottom": 30, "left": 50},
        "title": "Preisindex der Energieträger",
        "subtitle": "Preise in €, monatlich, Durchschnitt {base} = 100, logarithmische Skala",
        "footer": "Quelle: cismo (Gas, CEGH), Macrobond, ICE (Brent, Kohle, EUA), ENTSO-E (Strom), Statistik Austria (Brennholz), proPellets Austria (Pellets); Brent und Kohle von $ umgerechnet"
    },
    "globals": {
        "base": "2019"
    },
    "filter": { "base": "@base" },
    "formElements": [{
        "id": "base", "name": "Basisjahr", "ref": "base", "type": "slider", "inImage": false,
        "values": { "column": "base" }
    }],
    "annotations": [
        { "type": "line", "y": 100, "props": { "stroke": "#999", "stroke-dasharray": "3 3" } }
    ],
    "mapping": {
        "x": {
            "axis": {
                "ticks": {
                    "prop": "relative",
                    "ref": "innerWidth",
                    "ratio": 0.014
                },
                "rotate": 0,
                "format": "%Y"
            }
        },
        "y": {
            "scale": { "type": "log", "domain": [null, null], "domainRel": [-0.05, 0.05] },
            "axis": { "values": [2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000] }
        },
        "base": {
            "column": "base"
        },
        "type": {
            "column": "type",
            "legend": {
                "symbol": {
                    "size": 16,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 16, "y1": 8, "y2": 8,
                            "stroke": "@color",
                            "stroke-width": 2,
                            "stroke-dasharray": "@stroke-dasharray",
                            "opacity": "@opacity"
                        }
                    }]
                }
            },
            "props": {
                "common": {
                    "stroke-width": 2,
                    "highlight-stroke-width": 3,
                    "opacity": 0.7,
                    "highlight-opacity": 1,
                    "stroke-dasharray": 0
                },
                "categories": {
                    "gas":         { "color": "#C3423F", "name": "Erdgas" },
                    "oil":         { "color": "#C3423F", "name": "Rohöl (Brent)", "stroke-dasharray": "6, 3" },
                    "coal":        { "color": "#C3423F", "name": "Kohle", "stroke-dasharray": "2, 2" },
                    "firewood":    { "color": "#b5c969", "name": "Brennholz" },
                    "pellets":     { "color": "#b5c969", "name": "Pellets", "stroke-dasharray": "6, 3", "visible": false },
                    "electricity": { "color": "#86cae7", "name": "Strom" },
                    "eua":         { "color": "#F3D039", "name": "CO₂-Zertifikate (EUA)", "stroke-dasharray": "6, 3", "visible": false }
                }
            },
            "hover": {}
        }
    },
    "plot": {
        "type": "cartesian:line",
        "categories": ["type"],
        "curve": "monotoneX",
        "props": {
            "stroke": "@color",
            "stroke-width": "@stroke-width",
            "fill": "none",
            "d": {
                "x": "@x:scaled",
                "y": "@y:scaled"
            },
            "stroke-dasharray": "@stroke-dasharray",
            "opacity": "@opacity",
            "highlight-opacity": "@highlight-opacity",
            "highlight-stroke-width": "@highlight-stroke-width"
        }
    }
}
