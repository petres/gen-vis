{
    "data": "data/electricity.csv",
    "options": {
        "title": "Renewables, country by country",
        "subtitle": "Share of renewables in the electricity generated in {year}, by region, sorted by the share",
        "footer": "Source: ENTSO-E Transparency Platform",
        "class": "renewables",
        "locale": "en",
        "height": 640,
        "margins": {
            "top": 26, "right": 46, "bottom": 4,
            "left": { "prop": "steps", "ref": "totalWidth", "steps": [{ "cut": 0, "value": 104 }, { "cut": 560, "value": 150 }] }
        },
        "transition": 400,
        "hover": { "box": false, "marker": false, "area": "facet" },
        "highlight": { "transition": 120 }
    },
    "transform": [
        { "type": "lookup", "column": "country", "data": "data/countries.csv", "key": "code", "value": "name", "as": "name" },
        { "type": "lookup", "column": "country", "data": "data/countries.csv", "key": "code", "value": "region", "as": "region" }
    ],
    "globals": { "year": "2025" },
    "filter": { "source": "renewable", "year": "@year", "x": { "not": null } },
    "formElements": [
        { "id": "year", "name": "Year", "ref": "year", "type": "slider", "values": { "column": "year" } }
    ],
    "mapping": {
        "x": {
            "column": "share",
            "type": "numeric",
            "scale": { "type": "linear", "orientation": "horizontal", "domain": [0, 1], "domainRel": [0, 0] },
            "axis": { "position": "top", "values": [0, 0.25, 0.5, 0.75, 1], "format": ".0%", "grid": true },
            "hover": { "format": ".0%" }
        },
        "y": {
            "column": "country",
            "type": "categorical",
            "scale": {
                "type": "band", "orientation": "vertical", "range": [0, "@height"], "padding": 0.25,
                "order": { "by": "x", "descending": true },
                "groups": { "by": "region", "padding": 1.6 }
            },
            "axis": {
                "position": "left", "padding": 6,
                "labels": { "props": {
                    "text": "@name",
                    "max-width": { "prop": "steps", "ref": "totalWidth", "steps": [{ "cut": 0, "value": 84 }, { "cut": 560, "value": 138 }] }
                } }
            }
        },
        "name": { "column": "name", "type": "categorical" },
        "region": { "column": "region", "type": "categorical" },
        "source": { "column": "source", "type": "categorical" },
        "year": { "column": "year", "type": "categorical" }
    },
    "annotations": [
        { "type": "line", "x": 0.5, "props": { "stroke": "#1D3557", "stroke-dasharray": "2 3" } }
    ],
    "plot": [
        {
            "id": "bars",
            "type": "cartesian:bar",
            "categories": ["y"],
            "props": {
                "x1": "@x:scaled", "y": "@y:scaled", "fill": "#9CC9B9", "rx": 2,
                "highlight-fill": "#0F766E", "others-opacity": 0.45
            }
        },
        {
            "id": "values",
            "type": "svg:text",
            "categories": ["y"],
            "props": {
                "x": "@x:scaled", "dx": 5, "y": "@y:scaled:center", "dominant-baseline": "central",
                "font-size": 11, "font-weight": "bold", "fill": "#0F766E", "text": "@x:formatted",
                "visibility": "hidden", "highlight-visibility": "visible"
            }
        },
        {
            "id": "regions",
            "type": "svg:text",
            "categories": ["region"],
            "select": "first",
            "props": {
                "x": "@x:scaled:0", "y": "@y:group:start", "dy": -5,
                "font-size": 10, "font-weight": "bold", "letter-spacing": "0.06em",
                "text": "@region", "fill": "#1D3557"
            }
        }
    ]
}
