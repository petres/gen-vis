[
  {
    "name": "the parent of a parent, urls relative to the definition referencing them",
    "url": "http://h/data/bev/def.json",
    "files": {
      "http://h/data/shared/base.json": {
        "parent": "root.json",
        "width": 1,
        "height": 2,
        "marks": [
          {
            "type": "line"
          }
        ]
      },
      "http://h/data/shared/root.json": {
        "width": 0,
        "title": "root"
      }
    },
    "def": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "parent": "../shared/base.json",
      "width": 3,
      "marks": [
        {
          "type": "bar"
        }
      ]
    },
    "result": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "width": 3,
      "title": "root",
      "height": 2,
      "parent": "../shared/base.json",
      "marks": [
        {
          "type": "bar"
        }
      ]
    }
  },
  {
    "name": "mixins in their order, a shared parent once before the first one using it",
    "url": "http://h/data/bev/def.json",
    "files": {
      "http://h/data/root.json": {
        "title": "root",
        "height": 1,
        "width": 1
      },
      "http://h/data/lines.json": {
        "parent": "root.json",
        "height": 2,
        "marks": [
          {
            "type": "line"
          }
        ]
      },
      "http://h/data/facets.json": {
        "parent": "root.json",
        "width": 3,
        "facets": {
          "by": "type"
        }
      }
    },
    "def": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "parent": [
        "../lines.json",
        "../facets.json"
      ],
      "title": "def"
    },
    "result": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "title": "def",
      "height": 2,
      "width": 3,
      "parent": [
        "../lines.json",
        "../facets.json"
      ],
      "marks": [
        {
          "type": "line"
        }
      ],
      "facets": {
        "by": "type"
      }
    }
  },
  {
    "name": "a later mixin overrides an earlier one, marks of ids are merged across mixins",
    "url": "http://h/def.json",
    "files": {
      "http://h/a.json": {
        "marks": [
          {
            "id": "l",
            "type": "line",
            "stroke": "red"
          }
        ]
      },
      "http://h/b.json": {
        "marks": [
          {
            "id": "l",
            "stroke": "blue"
          },
          {
            "id": "p",
            "type": "point"
          }
        ]
      }
    },
    "def": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "parent": [
        "a.json",
        "b.json"
      ],
      "marks": [
        {
          "id": "p",
          "r": 2
        }
      ]
    },
    "result": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "marks": [
        {
          "id": "l",
          "type": "line",
          "stroke": "blue"
        },
        {
          "id": "p",
          "type": "point",
          "r": 2
        }
      ],
      "parent": [
        "a.json",
        "b.json"
      ]
    }
  },
  {
    "name": "a cyclic parent is an error",
    "url": "http://h/a.json",
    "files": {
      "http://h/b.json": {
        "parent": "a.json"
      },
      "http://h/a.json": {
        "parent": "b.json"
      }
    },
    "def": {
      "parent": "b.json"
    },
    "error": "Cyclic parent definition 'http://h/b.json'"
  },
  {
    "name": "a definition of a url declares gen-vis 5 by its $schema, it may be the one of a parent",
    "url": "http://h/def.json",
    "files": {
      "http://h/base.json": {
        "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
        "width": 1
      }
    },
    "def": {
      "parent": "base.json",
      "height": 2
    },
    "result": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "width": 1,
      "height": 2,
      "parent": "base.json"
    }
  },
  {
    "name": "a definition which declares gen-vis 4 by its $schema is an error, also in a parent",
    "url": "http://h/def.json",
    "files": {
      "http://h/base.json": {
        "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
        "width": 1
      }
    },
    "def": {
      "parent": "base.json",
      "height": 2
    },
    "error": "'http://h/base.json' is no definition of gen-vis 5: its $schema is the one of gen-vis 4"
  },
  {
    "name": "a part with keys of the language of gen-vis 4 is an error which names them, also a parent of a definition of 5",
    "url": "http://h/def.json",
    "files": {
      "http://h/base.json": {
        "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
        "options": {
          "width": 1
        },
        "formElements": []
      }
    },
    "def": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "parent": "base.json",
      "dims": {
        "x": "year"
      }
    },
    "error": "'http://h/base.json' is a definition of gen-vis 4 (its \"formElements\", \"options\"): gen-vis 5 reads \"dims\", \"marks\", \"controls\" and the options at the top level"
  },
  {
    "name": "a definition without a url (inline) may have no $schema",
    "files": {},
    "def": {
      "height": 2
    },
    "result": {
      "height": 2
    }
  },
  {
    "name": "a definition of a url without a $schema is an error",
    "url": "http://h/def.json",
    "files": {},
    "def": {
      "height": 2
    },
    "error": "'http://h/def.json' is no definition of gen-vis 5: its $schema is missing"
  },
  {
    "name": "a part with the $schema of another version of gen-vis is an error, also a parent",
    "url": "http://h/def.json",
    "files": {
      "http://h/base.json": {
        "$schema": "https://unpkg.com/@preschen/gen-vis@3/schema.json",
        "width": 1
      }
    },
    "def": {
      "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
      "parent": "base.json"
    },
    "error": "'http://h/base.json' is no definition of gen-vis 5: its $schema is the one of gen-vis 3"
  }
]
