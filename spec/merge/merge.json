[
  {
    "name": "objects are merged deeply, later parts override earlier ones",
    "parts": [
      {
        "options": {
          "width": 1,
          "height": 2,
          "margins": {
            "top": 1,
            "left": 2
          }
        }
      },
      {
        "options": {
          "width": 3,
          "margins": {
            "left": 5
          }
        }
      }
    ],
    "result": {
      "options": {
        "width": 3,
        "height": 2,
        "margins": {
          "top": 1,
          "left": 5
        }
      }
    }
  },
  {
    "name": "arrays are replaced",
    "parts": [
      {
        "plot": [
          {
            "type": "a"
          },
          {
            "type": "b"
          }
        ]
      },
      {
        "plot": [
          {
            "type": "c"
          }
        ]
      }
    ],
    "result": {
      "plot": [
        {
          "type": "c"
        }
      ]
    }
  },
  {
    "name": "arrays of numbers and strings are replaced, also by an empty one",
    "parts": [
      {
        "mapping": {
          "y": {
            "scale": {
              "domain": [
                0,
                100
              ]
            }
          }
        }
      },
      {
        "mapping": {
          "y": {
            "scale": {
              "domain": [
                null
              ]
            }
          }
        }
      },
      {
        "options": {
          "a": [
            "x"
          ]
        }
      },
      {
        "options": {
          "a": []
        }
      }
    ],
    "result": {
      "mapping": {
        "y": {
          "scale": {
            "domain": [
              null
            ]
          }
        }
      },
      "options": {
        "a": []
      }
    }
  },
  {
    "name": "arrays whose entries all have an id are merged by it, new ids are appended",
    "parts": [
      {
        "plot": [
          {
            "id": "line",
            "type": "cartesian:line",
            "props": {
              "stroke": "red",
              "fill": "none"
            }
          },
          {
            "id": "dots",
            "type": "svg:circle"
          }
        ]
      },
      {
        "plot": [
          {
            "id": "label",
            "type": "svg:text"
          },
          {
            "id": "line",
            "props": {
              "stroke": "blue"
            }
          }
        ]
      }
    ],
    "result": {
      "plot": [
        {
          "id": "line",
          "type": "cartesian:line",
          "props": {
            "stroke": "blue",
            "fill": "none"
          }
        },
        {
          "id": "dots",
          "type": "svg:circle"
        },
        {
          "id": "label",
          "type": "svg:text"
        }
      ]
    }
  },
  {
    "name": "arrays of entries with ids are replaced if one entry of either has no id",
    "parts": [
      {
        "plot": [
          {
            "id": "line",
            "type": "a"
          },
          {
            "type": "b"
          }
        ]
      },
      {
        "plot": [
          {
            "id": "line",
            "props": {
              "r": 1
            }
          }
        ]
      },
      {
        "formElements": [
          {
            "id": "a",
            "name": "A"
          }
        ]
      },
      {
        "formElements": [
          {
            "id": "a",
            "name": "B"
          },
          {
            "name": "C"
          }
        ]
      }
    ],
    "result": {
      "plot": [
        {
          "id": "line",
          "props": {
            "r": 1
          }
        }
      ],
      "formElements": [
        {
          "id": "a",
          "name": "B"
        },
        {
          "name": "C"
        }
      ]
    }
  },
  {
    "name": "the entries of entries with ids are merged by their ids as well, e.g. the values of form elements",
    "parts": [
      {
        "formElements": [
          {
            "id": "unit",
            "ref": "unit",
            "values": [
              {
                "id": "twh",
                "name": "TWh"
              },
              {
                "id": "pj",
                "name": "PJ"
              }
            ]
          }
        ]
      },
      {
        "formElements": [
          {
            "id": "unit",
            "values": [
              {
                "id": "pj",
                "patch": {
                  "mapping": {
                    "y": {
                      "column": "pj"
                    }
                  }
                }
              },
              {
                "id": "mtoe",
                "name": "Mtoe"
              }
            ]
          }
        ]
      }
    ],
    "result": {
      "formElements": [
        {
          "id": "unit",
          "ref": "unit",
          "values": [
            {
              "id": "twh",
              "name": "TWh"
            },
            {
              "id": "pj",
              "name": "PJ",
              "patch": {
                "mapping": {
                  "y": {
                    "column": "pj"
                  }
                }
              }
            },
            {
              "id": "mtoe",
              "name": "Mtoe"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "ids are compared as text",
    "parts": [
      {
        "plot": [
          {
            "id": 1,
            "props": {
              "a": 1
            }
          }
        ]
      },
      {
        "plot": [
          {
            "id": "1",
            "props": {
              "b": 2
            }
          }
        ]
      }
    ],
    "result": {
      "plot": [
        {
          "id": "1",
          "props": {
            "a": 1,
            "b": 2
          }
        }
      ]
    }
  },
  {
    "name": "null replaces a value, it is kept in the merged definition",
    "parts": [
      {
        "geo": {
          "data": "map.json"
        },
        "mapping": {
          "y": {
            "hover": {
              "format": ".1f"
            }
          }
        }
      },
      {
        "geo": null,
        "mapping": {
          "y": {
            "hover": null
          }
        }
      }
    ],
    "result": {
      "geo": null,
      "mapping": {
        "y": {
          "hover": null
        }
      }
    }
  },
  {
    "name": "a value replaces an object and an object replaces a value",
    "parts": [
      {
        "options": {
          "message": {
            "a": 1
          },
          "height": 300
        }
      },
      {
        "options": {
          "message": "text",
          "height": {
            "*": [
              "@totalWidth",
              0.5
            ]
          }
        }
      }
    ],
    "result": {
      "options": {
        "message": "text",
        "height": {
          "*": [
            "@totalWidth",
            0.5
          ]
        }
      }
    }
  },
  {
    "name": "an object replaces an array and an array an object",
    "parts": [
      {
        "plot": [
          {
            "type": "a"
          }
        ],
        "transform": {
          "type": "year",
          "column": "d"
        }
      },
      {
        "plot": {
          "type": "b"
        },
        "transform": [
          {
            "type": "year",
            "column": "e"
          }
        ]
      }
    ],
    "result": {
      "plot": {
        "type": "b"
      },
      "transform": [
        {
          "type": "year",
          "column": "e"
        }
      ]
    }
  },
  {
    "name": "a single plot object is merged with a single plot object",
    "parts": [
      {
        "plot": {
          "type": "cartesian:line",
          "props": {
            "stroke": "red"
          }
        }
      },
      {
        "plot": {
          "props": {
            "stroke-width": 2
          }
        }
      }
    ],
    "result": {
      "plot": {
        "type": "cartesian:line",
        "props": {
          "stroke": "red",
          "stroke-width": 2
        }
      }
    }
  },
  {
    "name": "the parts after the first one are not changed by a merge, three parts",
    "parts": [
      {
        "a": 1
      },
      {
        "b": {
          "c": 1
        }
      },
      {
        "b": {
          "d": 2
        }
      }
    ],
    "result": {
      "a": 1,
      "b": {
        "c": 1,
        "d": 2
      }
    }
  },
  {
    "name": "a text of a mapping is the mapping of its column, merged with an object of the same mapping",
    "parts": [
      {
        "mapping": {
          "facet": "group",
          "x": {
            "column": "year",
            "axis": {
              "ticks": 5
            }
          },
          "y": "value"
        }
      },
      {
        "mapping": {
          "facet": {
            "categories": {
              "a": {
                "name": "A"
              }
            }
          },
          "x": "date",
          "y": "share"
        }
      }
    ],
    "result": {
      "mapping": {
        "facet": {
          "column": "group",
          "categories": {
            "a": {
              "name": "A"
            }
          }
        },
        "x": {
          "column": "date",
          "axis": {
            "ticks": 5
          }
        },
        "y": "share"
      }
    }
  },
  {
    "name": "a match of a global without a default is a switch over the value below it, of the string syntax or an operator object",
    "parts": [
      {
        "globals": {
          "values": "abs"
        },
        "dims": {
          "y": {
            "column": "value",
            "format": ",.0f"
          }
        }
      },
      {
        "dims": {
          "y": {
            "column": "=match(@values, {share: 'value.share'})",
            "format": {
              "match": [
                "@values",
                {
                  "share": ".0%"
                }
              ]
            }
          }
        }
      }
    ],
    "result": {
      "globals": {
        "values": "abs"
      },
      "dims": {
        "y": {
          "column": {
            "match": [
              "@values",
              {
                "share": "value.share"
              },
              "value"
            ]
          },
          "format": {
            "match": [
              "@values",
              {
                "share": ".0%"
              },
              ",.0f"
            ]
          }
        }
      }
    }
  },
  {
    "name": "a match without a default over no value stays without one (no value unless a case holds)",
    "parts": [
      {
        "globals": {
          "values": "abs"
        },
        "dims": {
          "y": {}
        }
      },
      {
        "dims": {
          "y": {
            "column": "=match(@values, {share: 'value.share'})"
          }
        }
      }
    ],
    "result": {
      "globals": {
        "values": "abs"
      },
      "dims": {
        "y": {
          "column": "=match(@values, {share: 'value.share'})"
        }
      }
    }
  },
  {
    "name": "two matches of the same global merge their cases, the later ones win, the default of the later one, else of the earlier one",
    "parts": [
      {
        "globals": {
          "kind": "a"
        },
        "title": "=match(@kind, {a: 'A', b: 'B'}, 'none')"
      },
      {
        "title": "=match(@kind, {b: 'Bee', c: 'C'})"
      },
      {
        "subtitle": "=match(@kind, {a: 'a'})"
      },
      {
        "subtitle": "=match(@kind, {b: 'b'}, 'sub')"
      }
    ],
    "result": {
      "globals": {
        "kind": "a"
      },
      "title": {
        "match": [
          "@kind",
          {
            "a": "A",
            "b": "Bee",
            "c": "C"
          },
          "none"
        ]
      },
      "subtitle": {
        "match": [
          "@kind",
          {
            "a": "a",
            "b": "b"
          },
          "sub"
        ]
      }
    }
  },
  {
    "name": "a value merged onto a match of a global becomes its default, with or without one: the switch applies after the merge as a patch of 4.x",
    "parts": [
      {
        "globals": {
          "values": "abs"
        },
        "dims": {
          "y": {
            "column": "=match(@values, {share: 'value.share'})",
            "format": "=match(@values, {share: '.0%'}, ',.1f')"
          }
        }
      },
      {
        "dims": {
          "y": {
            "column": "value",
            "format": ",.0f"
          }
        }
      }
    ],
    "result": {
      "globals": {
        "values": "abs"
      },
      "dims": {
        "y": {
          "column": {
            "match": [
              "@values",
              {
                "share": "value.share"
              },
              "value"
            ]
          },
          "format": {
            "match": [
              "@values",
              {
                "share": ".0%"
              },
              ",.0f"
            ]
          }
        }
      }
    }
  },
  {
    "name": "a match with a default and null replace, a match of another global without a default falls through to the switch below it",
    "parts": [
      {
        "globals": {
          "values": "abs",
          "other": "y"
        },
        "dims": {
          "y": {
            "column": "=match(@values, {share: 'value.share'})",
            "format": "=match(@values, {share: '.0%'})",
            "nice": "=match(@values, {share: true})"
          }
        }
      },
      {
        "dims": {
          "y": {
            "column": "=match(@values, {share: 's'}, 'v')",
            "format": "=match(@other, {x: '.1f'})",
            "nice": null
          }
        }
      }
    ],
    "result": {
      "globals": {
        "values": "abs",
        "other": "y"
      },
      "dims": {
        "y": {
          "column": {
            "match": [
              "@values",
              {
                "share": "s"
              },
              "v"
            ]
          },
          "format": {
            "match": [
              "@other",
              {
                "x": ".1f"
              },
              {
                "match": [
                  "@values",
                  {
                    "share": ".0%"
                  }
                ]
              }
            ]
          },
          "nice": null
        }
      }
    }
  },
  {
    "name": "the attributes of marks and annotations are expressions of the rows, their matches are no switches",
    "parts": [
      {
        "globals": {
          "c": "x"
        },
        "marks": [
          {
            "id": "a",
            "fill": "=match(@c, {x: 'red'})"
          }
        ],
        "annotations": [
          {
            "type": "line",
            "y": "=match(@c, {x: 1})"
          }
        ]
      },
      {
        "marks": [
          {
            "id": "a",
            "fill": "blue"
          }
        ],
        "annotations": [
          {
            "type": "line",
            "y": 2
          }
        ]
      }
    ],
    "result": {
      "globals": {
        "c": "x"
      },
      "marks": [
        {
          "id": "a",
          "fill": "blue"
        }
      ],
      "annotations": [
        {
          "type": "line",
          "y": 2
        }
      ]
    }
  },
  {
    "name": "a part as a whole, e.g. the marks of a global, over the marks of a parent",
    "parts": [
      {
        "globals": {
          "kind": "lines"
        },
        "marks": [
          {
            "type": "line"
          }
        ]
      },
      {
        "marks": "=match(@kind, {map: literal([{type: 'region'}])})"
      }
    ],
    "result": {
      "globals": {
        "kind": "lines"
      },
      "marks": {
        "match": [
          "@kind",
          {
            "map": {
              "literal": [
                {
                  "type": "region"
                }
              ]
            }
          },
          {
            "literal": [
              {
                "type": "line"
              }
            ]
          }
        ]
      }
    }
  },
  {
    "name": "switches of two mixins of different globals nest, a value of a child is the default of the innermost one, so both switches stay",
    "parts": [
      {
        "globals": {
          "values": "abs",
          "unit": "twh"
        },
        "dims": {
          "y": {
            "column": "=match(@values, {share: 'value.share'})"
          }
        }
      },
      {
        "dims": {
          "y": {
            "column": "=match(@unit, {pj: 'value.pj'})"
          }
        }
      },
      {
        "dims": {
          "y": {
            "column": "value"
          }
        }
      }
    ],
    "result": {
      "globals": {
        "values": "abs",
        "unit": "twh"
      },
      "dims": {
        "y": {
          "column": {
            "match": [
              "@unit",
              {
                "pj": "value.pj"
              },
              {
                "match": [
                  "@values",
                  {
                    "share": "value.share"
                  },
                  "value"
                ]
              }
            ]
          }
        }
      }
    }
  },
  {
    "name": "a switch over an object: the object is its default as a literal (it is not evaluated as an expression), a switch below as its object",
    "parts": [
      {
        "globals": {
          "values": "abs"
        },
        "dims": {
          "y": {
            "axis": {
              "format": ",.0f"
            }
          }
        }
      },
      {
        "dims": {
          "y": {
            "axis": "=match(@values, {share: literal({format: '.0%'})})"
          }
        }
      }
    ],
    "result": {
      "globals": {
        "values": "abs"
      },
      "dims": {
        "y": {
          "axis": {
            "match": [
              "@values",
              {
                "share": {
                  "literal": {
                    "format": ".0%"
                  }
                }
              },
              {
                "literal": {
                  "format": ",.0f"
                }
              }
            ]
          }
        }
      }
    }
  },
  {
    "name": "an object merged onto a switch is merged into its default if that is an object, the cases stay whole values; without a default the object is its default",
    "parts": [
      {
        "globals": {
          "s": "lin"
        },
        "dims": {
          "y": {
            "column": "v",
            "scale": {
              "type": "linear"
            }
          }
        }
      },
      {
        "dims": {
          "y": {
            "scale": "=match(@s, {log: literal({type: 'log'})})"
          },
          "x": {
            "axis": {
              "match": [
                "@s",
                {
                  "log": {
                    "literal": {
                      "ticks": 3
                    }
                  }
                }
              ]
            }
          }
        }
      },
      {
        "dims": {
          "y": {
            "scale": {
              "nice": true
            }
          },
          "x": {
            "axis": {
              "grid": true
            }
          }
        }
      }
    ],
    "result": {
      "globals": {
        "s": "lin"
      },
      "dims": {
        "y": {
          "column": "v",
          "scale": {
            "match": [
              "@s",
              {
                "log": {
                  "literal": {
                    "type": "log"
                  }
                }
              },
              {
                "literal": {
                  "type": "linear",
                  "nice": true
                }
              }
            ]
          }
        },
        "x": {
          "axis": {
            "match": [
              "@s",
              {
                "log": {
                  "literal": {
                    "ticks": 3
                  }
                }
              },
              {
                "literal": {
                  "grid": true
                }
              }
            ]
          }
        }
      }
    }
  },
  {
    "name": "only a match of a global is a switch: of a name of the globals or of the global of a control of any part, also as @globals.name or a field @name:field",
    "parts": [
      {
        "controls": [
          {
            "type": "radio",
            "global": "lang",
            "values": [
              "de",
              "en"
            ]
          }
        ],
        "title": "Bevölkerung",
        "subtitle": "Wien",
        "source": "Statistik"
      },
      {
        "globals": {
          "year": "2024"
        },
        "title": "=match(@lang, {en: 'Population'})",
        "subtitle": "=match(@globals.year, {'2025': 'Wien 2025'})",
        "source": "=match(@year:name, {'2025': 'neu'})"
      }
    ],
    "result": {
      "controls": [
        {
          "type": "radio",
          "global": "lang",
          "values": [
            "de",
            "en"
          ]
        }
      ],
      "globals": {
        "year": "2024"
      },
      "title": {
        "match": [
          "@lang",
          {
            "en": "Population"
          },
          "Bevölkerung"
        ]
      },
      "subtitle": {
        "match": [
          "@globals.year",
          {
            "2025": "Wien 2025"
          },
          "Wien"
        ]
      },
      "source": {
        "match": [
          "@year:name",
          {
            "2025": "neu"
          },
          "Statistik"
        ]
      }
    }
  },
  {
    "name": "a match of a name which is no global is a value, e.g. of the categories in the props of a legend or of the rows in stacked: it replaces and is replaced",
    "parts": [
      {
        "globals": {
          "kind": "a"
        },
        "title": "Wien",
        "dims": {
          "land": {
            "legend": {
              "props": {
                "fill": "=match(@land, {W: 'red'})",
                "opacity": {
                  "match": [
                    "@land",
                    {
                      "W": 1
                    },
                    0.5
                  ]
                }
              }
            }
          },
          "y": {
            "stacked": {
              "match": [
                "@type",
                {
                  "a": true
                },
                false
              ]
            }
          }
        }
      },
      {
        "title": "=match(@lang, {en: 'Vienna'})",
        "dims": {
          "land": {
            "legend": {
              "props": {
                "fill": "blue",
                "opacity": {
                  "min": [
                    1,
                    0.8
                  ]
                }
              }
            }
          },
          "y": {
            "stacked": {
