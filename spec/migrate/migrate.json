[
  {
    "name": "the props of 3.x are expressions",
    "def": {
      "options": {
        "height": {
          "prop": "steps",
          "ref": "totalWidth",
          "steps": [
            {
              "cut": 0,
              "value": 300
            },
            {
              "cut": 600,
              "value": 400
            }
          ]
        },
        "margins": {
          "left": {
            "prop": "relative",
            "ref": "totalWidth",
            "ratio": 0.1,
            "offset": 5
          }
        }
      }
    },
    "result": {
      "options": {
        "height": {
          "steps": [
            "@totalWidth",
            {
              "0": 300,
              "600": 400
            }
          ]
        },
        "margins": {
          "left": {
            "+": [
              {
                "*": [
                  "@totalWidth",
                  0.1
                ]
              },
              5
            ]
          }
        }
      }
    }
  },
  {
    "name": "all kinds of props of 3.x, of a reference and of another prop",
    "def": {
      "plot": {
        "type": "svg:text",
        "props": {
          "a": {
            "prop": "ref",
            "ref": "x"
          },
          "b": {
            "prop": "fixed",
            "value": "@x"
          },
          "c": {
            "prop": "fixed",
            "value": 3
          },
          "d": {
            "prop": "relative",
            "ref": "x",
            "ratio": 2
          },
          "e": {
            "prop": "relative",
            "ref": "x",
            "offset": -3
          },
          "f": {
            "prop": "format",
            "ref": "y",
            "format": ",.1f"
          },
          "g": {
            "prop": "match",
            "ref": "level",
            "cases": {
              "header": 4,
              "item": {
                "prop": "ref",
                "ref": "r"
              }
            },
            "default": 0
          },
          "h": {
            "prop": "relative",
            "of": {
              "prop": "steps",
              "ref": "totalWidth",
              "steps": [
                {
                  "cut": 500,
                  "value": 2
                },
                {
                  "cut": 0,
                  "value": 1
                }
              ]
            },
            "ratio": 0.5
          }
        }
      }
    },
    "result": {
      "plot": {
        "type": "svg:text",
        "props": {
          "a": "@x",
          "b": {
            "literal": "@x"
          },
          "c": 3,
          "d": {
            "*": [
              "@x",
              2
            ]
          },
          "e": {
            "+": [
              "@x",
              -3
            ]
          },
          "f": {
            "format": [
              "@y",
              ",.1f"
            ]
          },
          "g": {
            "match": [
              "@level",
              {
                "header": 4,
                "item": "@r"
              },
              0
            ]
          },
          "h": {
            "*": [
              {
                "steps": [
                  "@totalWidth",
                  {
                    "0": 1,
                    "500": 2
                  }
                ]
              },
              0.5
            ]
          }
        }
      }
    }
  },
  {
    "name": "the props of the categories are parts of the mapping, a mapping without a type is categorical",
    "def": {
      "mapping": {
        "land": {
          "column": "Bundesland",
          "props": {
            "fromData": true,
            "scheme": "Tableau10",
            "categories": {
              "ÖSTERREICH": {
                "color": "#000"
              }
            }
          }
        },
        "id": {
          "column": "id"
        }
      }
    },
    "result": {
      "mapping": {
        "land": {
          "column": "Bundesland",
          "fromData": true,
          "scheme": "Tableau10",
          "categories": {
            "ÖSTERREICH": {
              "color": "#000"
            }
          }
        },
        "id": {
          "column": "id",
          "type": "categorical"
        }
      }
    }
  },
  {
    "name": "a mapping of the categories of a plot or of facets needs no type",
    "def": {
      "mapping": {
        "g": {
          "column": "g"
        }
      },
      "plot": {
        "type": "svg:circle",
        "categories": [
          "g"
        ],
        "props": {
          "r": 2
        }
      }
    },
    "result": {
      "mapping": {
        "g": "g"
      },
      "plot": {
        "type": "svg:circle",
        "by": "g",
        "props": {
          "r": 2
        }
      }
    }
  },
  {
    "name": "a scale without a type of 3.x is linear, x and y without a scale or an axis have none, the inferred orientations and positions of axes are left out",
    "def": {
      "mapping": {
        "x": {
          "column": "d",
          "type": "date",
          "scale": {
            "orientation": "horizontal"
          }
        },
        "y": {
          "column": "v",
          "type": "numeric",
          "scale": {
            "orientation": "vertical"
          },
          "axis": {
            "position": "left"
          }
        },
        "r": {
          "column": "r",
          "type": "numeric",
          "scale": {
            "range": [
              1,
              5
            ]
          }
        }
      }
    },
    "options": {
      "legacy": true
    },
    "result": {
      "mapping": {
        "x": {
          "column": "d",
          "type": "date",
          "scale": {
            "type": "linear"
          },
          "axis": false
        },
        "y": {
          "column": "v",
          "type": "numeric"
        },
        "r": {
          "column": "r",
          "type": "numeric",
          "scale": {
            "range": [
              1,
              5
            ]
          }
        }
      }
    }
  },
  {
    "name": "x of polar plots, y without a scale",
    "def": {
      "options": {
        "coord": "polar"
      },
      "mapping": {
        "x": {
          "column": "m",
          "type": "categorical",
          "scale": {
            "type": "point",
            "orientation": "angular"
          },
          "axis": {
            "position": "angular"
          }
        },
        "y": {
          "column": "v",
          "type": "numeric"
        }
      }
    },
    "options": {
      "legacy": true
    },
    "result": {
      "options": {
        "coord": "polar"
      },
      "mapping": {
        "x": {
          "column": "m",
          "type": "categorical"
        },
        "y": {
          "column": "v",
          "type": "numeric",
          "scale": false
        }
      }
    }
  },
  {
    "name": "categories of a plot are by, the props of the highlight and of the others objects",
    "def": {
      "plot": {
        "type": "cartesian:bar",
        "categories": [
          "land"
        ],
        "highlight": "row",
        "props": {
          "fill": "@color",
          "x": "@x:scaled",
          "highlight-fill": "#333",
          "others-opacity": 0.3
        }
      }
    },
    "result": {
      "plot": {
        "type": "cartesian:bar",
        "by": "land",
        "props": {
          "fill": "@color",
          "x": "@x:scaled"
        },
        "highlight": {
          "mode": "row",
          "fill": "#333"
        },
        "others": {
          "opacity": 0.3
        }
      }
    }
  },
  {
    "name": "the props of the highlight are an object, also between other props (the order of the attributes is no change)",
    "def": {
      "plot": {
        "type": "svg:circle",
        "props": {
          "highlight-r": 5,
          "r": 3
        }
      }
    },
    "result": {
      "plot": {
        "type": "svg:circle",
        "props": {
          "r": 3
        },
        "highlight": {
          "r": 5
        }
      }
    }
  },
  {
    "name": "a type without the prefix of the coordinate system if the props contain its defaults, of the props which differ",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:line",
          "categories": [
            "land"
          ],
          "props": {
            "stroke": {
              "prop": "fixed",
              "value": "red"
            },
            "fill": "none",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        },
        {
          "type": "cartesian:line",
          "props": {
            "fill": "none",
            "stroke": "red",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        },
        {
          "type": "cartesian:line",
          "props": {
            "stroke": "red",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        },
        {
          "type": "svg:circle",
          "props": {
            "cx": "@x:scaled",
            "cy": "@y:scaled",
            "r": 5,
            "fill": {
              "or": [
                "@color",
                "currentColor"
              ]
            }
          }
        },
        {
          "type": "cartesian:bar",
          "props": {
            "fill": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "x1": "@x:scaled",
            "y": "@y:scaled",
            "height": 8
          }
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "line",
          "by": "land",
          "props": {
            "stroke": "red"
          }
        },
        {
          "type": "line",
          "props": {
            "stroke": "red"
          }
        },
        {
          "type": "cartesian:line",
          "props": {
            "stroke": "red",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        },
        {
          "type": "point",
          "props": {
            "r": 5
          }
        },
        {
          "type": "bar",
          "props": {
            "x1": "@x:scaled",
            "y": "@y:scaled",
            "height": 8
          }
        }
      ]
    }
  },
  {
    "name": "calc of op and columns is one of an expression",
    "def": {
      "transform": [
        {
          "type": "calc",
          "op": "divide",
          "columns": [
            "value",
            "inno"
          ],
          "scale": 100,
          "as": "rel"
        },
        {
          "type": "calc",
          "op": "max",
          "columns": [
            "a",
            "b"
          ],
          "as": "hi"
        },
        {
          "type": "calc",
          "op": "add",
          "columns": [
            "a"
          ]
        }
      ]
    },
    "result": {
      "transform": [
        {
          "type": "calc",
          "as": "rel",
          "expr": {
            "*": [
              {
                "/": [
                  "@value",
                  "@inno"
                ]
              },
              100
            ]
          }
        },
        {
          "type": "calc",
          "as": "hi",
          "expr": {
            "max": [
              "@a",
              "@b"
            ]
          }
        },
        {
          "type": "calc",
          "as": "a",
          "expr": {
            "+": [
              "@a"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "the patches of form elements",
    "def": {
      "mapping": {
        "y": {
          "column": "v",
          "type": "numeric",
          "scale": {
            "type": "linear",
            "orientation": "vertical"
          },
          "axis": {
            "position": "left"
          }
        }
      },
      "formElements": [
        {
          "id": "s",
          "ref": "s",
          "values": [
            {
              "id": "a",
              "value": "a",
              "patch": {
                "mapping": {
                  "y": {
                    "column": "share",
                    "props": {
                      "scheme": "Blues"
                    }
                  }
                },
                "plot": [
                  {
                    "id": "p",
                    "categories": "c",
                    "props": {
                      "highlight-opacity": 1
                    }
                  }
                ],
                "transform": {
                  "type": "calc",
                  "op": "multiply",
                  "columns": [
                    "a",
                    "b"
                  ],
                  "as": "p"
                }
              }
            }
          ]
        }
      ]
    },
    "result": {
      "mapping": {
        "y": {
          "column": "v",
          "type": "numeric"
        }
      },
      "formElements": [
        {
          "id": "s",
          "ref": "s",
          "values": [
            {
              "id": "a",
              "value": "a",
              "patch": {
                "mapping": {
                  "y": {
                    "column": "share",
                    "scheme": "Blues"
                  }
                },
                "plot": [
                  {
                    "id": "p",
                    "by": "c",
                    "highlight": {
                      "opacity": 1
                    }
                  }
                ],
                "transform": {
                  "type": "calc",
                  "as": "p",
                  "expr": {
                    "*": [
                      "@a",
                      "@b"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  {
    "name": "a definition of 4.0 stays as it is",
    "def": {
      "mapping": {
        "x": "year",
        "y": {
          "column": "value",
          "type": "numeric",
          "domain": [
            0,
            null
          ]
        },
        "land": {
          "column": "land",
          "fromData": true
        }
      },
      "plot": {
        "type": "line",
        "by": "land",
        "highlight": {
          "stroke-width": 3
        }
      }
    },
    "result": {
      "mapping": {
        "x": "year",
        "y": {
          "column": "value",
          "type": "numeric",
          "domain": [
            0,
            null
          ]
        },
        "land": {
          "column": "land",
          "fromData": true
        }
      },
      "plot": {
        "type": "line",
        "by": "land",
        "highlight": {
          "stroke-width": 3
        }
      }
    }
  }
]
