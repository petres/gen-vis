[
  {
    "name": "a plot of a type with its default props, the props given after them",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:line",
          "by": [
            "land"
          ],
          "props": {
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            },
            "stroke-width": 2
          }
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:line",
          "by": [
            "land"
          ],
          "props": {
            "stroke": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "fill": "none",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            },
            "stroke-width": 2
          }
        }
      ]
    }
  },
  {
    "name": "the props are merged into the defaults, null removes one",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:line",
          "props": {
            "fill": null,
            "d": {
              "x": "@date:scaled",
              "y": "@y:scaled"
            },
            "stroke": {
              "if": [
                {
                  ">": [
                    "@y",
                    0
                  ]
                },
                "green",
                "red"
              ]
            }
          }
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:line",
          "props": {
            "stroke": {
              "if": [
                {
                  ">": [
                    "@y",
                    0
                  ]
                },
                "green",
                "red"
              ]
            },
            "d": {
              "x": "@date:scaled",
              "y": "@y:scaled"
            }
          }
        }
      ]
    }
  },
  {
    "name": "highlight and others are objects of props, mode the one of the highlight",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:bar",
          "highlight": {
            "mode": "row",
            "fill": "#333"
          },
          "others": {
            "opacity": 0.3
          },
          "props": {
            "fill": "@color",
            "x": "@x:scaled",
            "y1": "@y:scaled"
          }
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:bar",
          "props": {
            "fill": "@color",
            "x": "@x:scaled",
            "y1": "@y:scaled"
          },
          "highlight": {
            "mode": "row",
            "fill": "#333"
          },
          "others": {
            "opacity": 0.3
          }
        }
      ]
    }
  },
  {
    "name": "a type without the prefix of the coordinate system is the one of the coordinate system, of svg elements otherwise",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "line",
          "props": {
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        },
        {
          "type": "circle",
          "props": {
            "cx": "@x:scaled",
            "cy": "@y:scaled"
          }
        },
        {
          "type": "text",
          "props": {
            "x": "@x:scaled",
            "y": "@y:scaled",
            "text": "@name"
          }
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:line",
          "props": {
            "stroke": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "fill": "none",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        },
        {
          "type": "svg:circle",
          "props": {
            "r": 3,
            "fill": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "cx": "@x:scaled",
            "cy": "@y:scaled"
          }
        },
        {
          "type": "svg:text",
          "props": {
            "fill": "@color",
            "x": "@x:scaled",
            "y": "@y:scaled",
            "text": "@name"
          }
        }
      ]
    }
  },
  {
    "name": "the bars of a bin from x0 to x1 have crisp edges, other bars not",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:bar",
          "props": {
            "x0": "@lo:scaled",
            "x1": "@hi:scaled",
            "y1": "@y:scaled"
          }
        },
        {
          "type": "cartesian:bar",
          "props": {
            "x1": "@v:scaled",
            "y": "@y:scaled"
          }
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "cartesian:bar",
          "props": {
            "fill": {
              "or": [
                "@color",
                "#4269D0"
              ]
            },
            "shape-rendering": "crispEdges",
            "x0": "@lo:scaled",
            "x1": "@hi:scaled",
            "y1": "@y:scaled"
          }
        },
        {
          "type": "cartesian:bar",
          "props": {
            "fill": {
              "or": [
                "@color",
                "#4269D0"
              ]
            },
            "x1": "@v:scaled",
            "y": "@y:scaled"
          }
        }
      ]
    }
  },
  {
    "name": "the types of polar plots",
    "def": {
      "options": {
        "coord": "polar"
      },
      "mapping": {},
      "plot": [
        {
          "type": "polar:line",
          "props": {
            "d": {
              "angle": "@x:scaled",
              "radius": "@y:scaled"
            }
          }
        },
        {
          "type": "polar:circle",
          "props": {
            "angle": "@x:scaled",
            "radius": "@y:scaled"
          }
        },
        {
          "type": "polar:arc",
          "props": {
            "startAngle": "@v:start:scaled"
          }
        }
      ]
    },
    "result": {
      "options": {
        "coord": "polar"
      },
      "mapping": {},
      "plot": [
        {
          "type": "polar:line",
          "props": {
            "stroke": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "fill": "none",
            "d": {
              "angle": "@x:scaled",
              "radius": "@y:scaled"
            }
          }
        },
        {
          "type": "polar:circle",
          "props": {
            "r": 3,
            "fill": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "angle": "@x:scaled",
            "radius": "@y:scaled"
          }
        },
        {
          "type": "polar:arc",
          "props": {
            "fill": {
              "or": [
                "@color",
                "#4269D0"
              ]
            },
            "startAngle": "@v:start:scaled"
          }
        }
      ]
    }
  },
  {
    "name": "the types of maps: the labels centered on their place",
    "def": {
      "options": {
        "coord": "geo"
      },
      "mapping": {},
      "plot": [
        {
          "type": "geo:region",
          "props": {
            "fill": "@value:scaled"
          }
        },
        {
          "type": "geo:mesh"
        },
        {
          "type": "geo:text",
          "props": {
            "text": "@name"
          }
        }
      ]
    },
    "result": {
      "options": {
        "coord": "geo"
      },
      "mapping": {},
      "plot": [
        {
          "type": "geo:region",
          "props": {
            "fill": "@value:scaled"
          }
        },
        {
          "type": "geo:mesh"
        },
        {
          "type": "geo:text",
          "props": {
            "text-anchor": "middle",
            "dominant-baseline": "middle",
            "text": "@name"
          }
        }
      ]
    }
  },
  {
    "name": "an unknown type stays as it is",
    "def": {
      "mapping": {},
      "plot": [
        {
          "type": "dots"
        }
      ]
    },
    "result": {
      "mapping": {},
      "plot": [
        {
          "type": "dots"
        }
      ]
    }
  }
]
