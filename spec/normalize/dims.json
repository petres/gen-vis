          "scale": {
            "orientation": "vertical"
          },
          "axis": {}
        }
      }
    },
    "result": {
      "dims": {
        "c": {
          "column": "c",
          "type": "categorical"
        },
        "y2": {
          "column": "w",
          "type": "numeric",
          "scale": {
            "orientation": "vertical",
            "type": "linear"
          },
          "axis": {
            "position": "left"
          }
        }
      }
    }
  },
  {
