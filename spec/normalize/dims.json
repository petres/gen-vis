[
  {
    "name": "x and y have a scale and an axis of their orientation",
    "def": {
      "dims": {
        "x": {
          "column": "year"
        },
        "y": {
          "column": "value"
        }
      }
    },
    "result": {
      "dims": {
        "x": {
          "column": "year",
          "scale": {
            "orientation": "horizontal"
          },
          "axis": {
            "position": "bottom"
          }
        },
        "y": {
          "column": "value",
          "scale": {
            "orientation": "vertical"
          },
          "axis": {
            "position": "left"
          }
        }
      }
    }
  },
  {
    "name": "the parts of the categories stay at the dim, it is categorical",
    "def": {
      "dims": {
        "land": {
          "column": "Bundesland",
          "scheme": "Tableau10",
          "fromData": true,
          "common": {
            "stroke-width": 2
          },
          "categories": {
            "ÖSTERREICH": {
              "color": "#000"
            }
          },
          "order": "descending",
          "ranks": [
            {
              "opacity": 1
            }
          ]
        }
      }
    },
    "result": {
      "dims": {
        "land": {
          "column": "Bundesland",
          "categories": {
            "ÖSTERREICH": {
              "color": "#000"
            }
          },
          "scheme": "Tableau10",
          "common": {
            "stroke-width": 2
          },
          "fromData": true,
          "ranks": [
            {
              "opacity": 1
            }
          ],
          "order": "descending",
          "type": "categorical"
        }
      }
    }
  },
  {
    "name": "domain and nice at the dim are the ones of the scale",
    "def": {
      "dims": {
        "y": {
          "column": "v",
          "type": "numeric",
          "domain": [
            0,
            null
          ],
          "nice": true,
          "scale": {
            "inset": 4
          }
        }
      }
    },
    "result": {
      "dims": {
        "y": {
          "column": "v",
          "type": "numeric",
          "scale": {
            "orientation": "vertical",
            "inset": 4,
            "domain": [
              0,
              null
            ],
            "nice": true,
            "type": "linear"
          },
          "axis": {
            "position": "left"
          }
        }
      }
    }
  },
  {
    "name": "the format of the dim stays, it is the default of the axis and the hover",
    "def": {
      "dims": {
        "y": {
          "column": "v",
          "type": "numeric",
          "format": ",.0f",
          "hover": {}
        }
      }
    },
    "result": {
      "dims": {
        "y": {
          "column": "v",
          "type": "numeric",
          "format": ",.0f",
          "hover": {},
          "scale": {
            "orientation": "vertical",
            "type": "linear"
          },
          "axis": {
            "position": "left"
          }
        }
      }
    }
  },
  {
    "name": "an explicit orientation and position stay, an axis without a position is the one of the orientation",
    "def": {
      "dims": {
        "x": {
          "column": "n",
          "type": "numeric",
          "scale": {
            "orientation": "vertical"
          }
        },
        "y": {
          "column": "c",
          "type": "categorical",
          "axis": {
            "position": "right"
          }
        }
      }
    },
    "result": {
      "dims": {
        "x": {
          "column": "n",
          "type": "numeric",
          "scale": {
            "orientation": "vertical",
            "type": "linear"
          },
          "axis": {
            "position": "left"
          }
        },
        "y": {
          "column": "c",
          "type": "categorical",
          "axis": {
            "position": "right"
          },
          "scale": {
            "orientation": "vertical",
            "type": "point"
          }
        }
      }
    }
  },
  {
    "name": "false is no scale or axis, an orientation null is none",
    "def": {
      "dims": {
        "x": {
          "column": "a",
          "type": "numeric",
          "axis": false
        },
        "y": {
          "column": "b",
          "type": "numeric",
          "scale": {
            "orientation": null,
            "range": [
              2,
              10
            ]
          }
        },
        "z": {
          "column": "c",
          "scale": false
        }
      }
    },
    "result": {
      "dims": {
        "x": {
          "column": "a",
          "type": "numeric",
          "axis": false,
          "scale": {
            "orientation": "horizontal",
            "type": "linear"
          }
        },
        "y": {
          "column": "b",
          "type": "numeric",
          "scale": {
            "range": [
              2,
              10
            ],
            "type": "linear"
          }
        },
        "z": {
          "column": "c",
          "scale": false
        }
      }
    }
  },
  {
    "name": "other dims have no scale by default, an axis is at the position of the orientation of its scale",
