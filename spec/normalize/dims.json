            ]
          },
          "type": "numeric"
        },
        "u": {
          "column": "u"
        }
      }
    }
  },
  {
    "name": "dims of the facets are categorical, the ones of the categories of marks (by) keep the type of their values",
    "def": {
      "dims": {
        "g": {
          "column": "g"
        },
        "f": {
          "column": "f"
        }
      },
      "facets": {
        "dim": "f"
      },
      "marks": [
        {
          "type": "cartesian:line",
          "by": [
            "g"
          ],
          "props": {
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        }
      ]
    },
    "result": {
      "dims": {
        "g": {
          "column": "g"
        },
        "f": {
          "column": "f",
          "type": "categorical"
        }
      },
      "facets": {
        "dim": "f"
      },
      "marks": [
        {
          "type": "cartesian:line",
          "by": [
            "g"
          ],
          "props": {
            "stroke": {
              "or": [
                "@color",
                "currentColor"
              ]
            },
            "fill": "none",
            "d": {
              "x": "@x:scaled",
              "y": "@y:scaled"
            }
          }
        }
      ]
    }
  },
  {
    "name": "the scale of the type: linear, time, band of the positions of bars, point of other positions, ordinal otherwise",
    "def": {
      "dims": {
        "x": {
          "column": "c",
          "type": "categorical"
        },
        "y": {
          "column": "v",
          "type": "numeric"
        },
        "t": {
          "column": "t",
          "type": "date",
          "scale": {
            "orientation": "horizontal"
          }
        },
        "p": {
          "column": "p",
          "type": "categorical",
          "scale": {
            "orientation": "vertical"
          }
        },
        "k": {
          "column": "k",
          "type": "categorical",
          "scale": {
            "range": [
              "red",
              "blue"
            ]
          }
        }
      },
      "marks": [
        {
          "type": "cartesian:bar",
          "props": {
            "x": "@x:scaled",
            "y1": "@y:scaled"
          }
        }
      ]
    },
    "result": {
      "dims": {
        "x": {
          "column": "c",
          "type": "categorical",
          "scale": {
            "orientation": "horizontal",
            "type": "band"
          },
          "axis": {
            "position": "bottom"
          }
        },
        "y": {
          "column": "v",
          "type": "numeric",
          "scale": {
            "orientation": "vertical",
            "type": "linear"
          },
          "axis": {
            "position": "left"
          }
        },
        "t": {
          "column": "t",
          "type": "date",
          "scale": {
            "orientation": "horizontal",
            "type": "time"
          }
        },
        "p": {
          "column": "p",
          "type": "categorical",
          "scale": {
            "orientation": "vertical",
            "type": "point"
          }
        },
        "k": {
          "column": "k",
          "type": "categorical",
          "scale": {
            "range": [
              "red",
              "blue"
            ],
            "type": "ordinal"
          }
        }
      },
      "marks": [
        {
          "type": "cartesian:bar",
          "props": {
            "fill": {
              "or": [
                "@color",
                "#4269D0"
              ]
            },
            "x": "@x:scaled",
            "y1": "@y:scaled"
          }
        }
      ]
    }
  },
  {
    "name": "polar plots: x and angle are angular, y and radius radial",
    "def": {
      "options": {
        "coord": "polar"
      },
      "dims": {
        "x": {
          "column": "m",
          "type": "categorical"
        },
        "radius": {
          "column": "v",
          "type": "numeric"
        }
      }
    },
    "result": {
      "options": {
        "coord": "polar"
      },
      "dims": {
        "x": {
          "column": "m",
          "type": "categorical",
          "scale": {
            "orientation": "angular",
            "type": "point"
          },
          "axis": {
            "position": "angular"
          }
        },
        "radius": {
          "column": "v",
          "type": "numeric",
          "scale": {
            "orientation": "radial",
            "type": "linear"
          },
          "axis": {
            "position": "radial"
          }
        }
      }
    }
  },
