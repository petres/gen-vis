    "result": {
      "dims": {
        "y": {
          "column": "v",
          "type": "numeric",
          "scale": {
            "orientation": "vertical",
            "type": "linear"
          },
          "axis": {
            "position": "left"
          }
        },
        "y0": {
          "column": "low",
          "type": "numeric",
          "scale": {
            "of": "y"
          }
        }
      }
    }
  },
  {
