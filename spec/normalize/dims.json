          "column": "b",
          "scale": {
            "type": "band"
          },
          "type": "categorical"
        },
        "d": {
          "column": "d",
          "scale": {
            "type": "utc"
          },
          "type": "date"
        },
        "n": {
          "column": "n",
          "scale": {
            "type": "sqrt",
            "range": [
              0,
