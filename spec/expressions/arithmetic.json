[
  { "name": "a ratio of a reference", "scope": { "innerWidth": 500 }, "expr": { "*": ["@innerWidth", 0.013] }, "result": 6.5 },
  { "name": "a position moved by pixels", "scope": { "x:scaled": 100 }, "expr": { "+": ["@x:scaled", -14] }, "result": 86 },
  { "name": "a ratio plus an offset", "scope": { "x": 3 }, "expr": { "+": [{ "*": ["@x", 2] }, 1] }, "result": 7 },
  { "name": "+ of several values", "scope": {}, "expr": { "+": [1, 2, 3] }, "result": 6 },
  { "name": "- of two values", "scope": {}, "expr": { "-": [10, 4] }, "result": 6 },
  { "name": "- of several values from the first one", "scope": {}, "expr": { "-": [10, 4, 1] }, "result": 5 },
  { "name": "- of one value is its negation", "scope": { "x": 3 }, "expr": { "-": "@x" }, "result": -3 },
  { "name": "/ of two values", "scope": {}, "expr": { "/": [10, 4] }, "result": 2.5 },
  { "name": "a division by 0 has no value", "scope": {}, "expr": { "/": [1, 0] }, "result": null },
  { "name": "texts of decimal numbers are numbers", "scope": { "v": " 12 ", "w": "1e1" }, "expr": { "+": ["@v", "@w"] }, "result": 22 },
  { "name": "a missing value has no value", "scope": {}, "expr": { "*": ["@innerWidth", 0.5] }, "result": null },
  { "name": "null has no value", "scope": { "v": null }, "expr": { "+": ["@v", 1] }, "result": null },
  { "name": "a text which is no number has no value", "scope": { "v": "0x10" }, "expr": { "+": ["@v", 1] }, "result": null },
  { "name": "an empty text has no value", "scope": { "v": "" }, "expr": { "*": ["@v", 1] }, "result": null },
  { "name": "booleans are no numbers", "scope": {}, "expr": { "+": [true, 1] }, "result": null },
  { "name": "min", "scope": { "a": 3 }, "expr": { "min": ["@a", 1, 2] }, "result": 1 },
  { "name": "max", "scope": { "a": 3 }, "expr": { "max": ["@a", 1, 2] }, "result": 3 },
  { "name": "max of a missing value has no value", "scope": {}, "expr": { "max": ["@a", 1] }, "result": null },
  { "name": "round to an integer", "scope": {}, "expr": { "round": 2.5 }, "result": 3 },
  { "name": "round halves up, also negative ones", "scope": {}, "expr": { "round": -2.5 }, "result": -2 },
  { "name": "round to digits", "scope": { "v": 3.14159 }, "expr": { "round": ["@v", 2] }, "result": 3.14 },
  { "name": "round to tens", "scope": {}, "expr": { "round": [1234, -1] }, "result": 1230 }
]
