[
  { "name": "== of the same texts", "scope": { "type": "gas" }, "expr": { "==": ["@type", "gas"] }, "result": true },
  { "name": "== of a number and its text", "scope": { "year": 2024 }, "expr": { "==": ["@year", "2024"] }, "result": true },
  { "name": "== of 0 and the empty text is false", "scope": {}, "expr": { "==": [0, ""] }, "result": false },
  { "name": "== of a missing value and null", "scope": {}, "expr": { "==": ["@a", null] }, "result": true },
  { "name": "== of an empty text and a missing value, they are missing", "scope": { "e": "", "w": " " }, "expr": [{ "==": ["@e", null] }, { "==": ["@w", "@a"] }, { "!=": ["@e", null] }, { "==": ["@e", "a"] }], "result": [true, true, false, false] },
  { "name": "!=", "scope": { "type": "gas" }, "expr": { "!=": ["@type", "oil"] }, "result": true },
  { "name": "> of numbers", "scope": { "value": 10 }, "expr": { ">": ["@value", 0] }, "result": true },
  { "name": "< of texts of numbers by their value", "scope": { "a": "9", "b": "10" }, "expr": { "<": ["@a", "@b"] }, "result": true },
  { "name": "< of texts, dates of ISO in their order", "scope": { "d": "2024-06-01" }, "expr": { "<": ["@d", "2024-12-31"] }, "result": true },
  { "name": "<= of the same values", "scope": {}, "expr": { "<=": [2, 2] }, "result": true },
  { "name": ">= of texts", "scope": {}, "expr": { ">=": ["b", "a"] }, "result": true },
  { "name": "a comparison of a missing value is false", "scope": {}, "expr": { ">": ["@value", 0] }, "result": false },
  { "name": "a comparison of a missing value is false, also <", "scope": { "value": null }, "expr": { "<": ["@value", 0] }, "result": false },
  { "name": "an empty text is missing in comparisons, also of whitespace", "scope": { "e": "", "w": " " }, "expr": [{ "<": ["@e", "a"] }, { ">": ["a", "@e"] }, { "<=": ["@w", 0] }, { ">=": ["@e", "@e"] }], "result": [false, false, false, false] },
  { "name": "a chain of < is a value between two", "scope": { "x": 5 }, "expr": { "<": [0, "@x", 10] }, "result": true },
  { "name": "a chain of < outside", "scope": { "x": 15 }, "expr": { "<": [0, "@x", 10] }, "result": false },
  { "name": "if of a condition, then and else", "scope": { "v": 3 }, "expr": { "if": [{ ">": ["@v", 2] }, "big", "small"] }, "result": "big" },
  { "name": "if, the else", "scope": { "v": 1 }, "expr": { "if": [{ ">": ["@v", 2] }, "big", "small"] }, "result": "small" },
  { "name": "if of several conditions, the first one which is true", "scope": { "v": 5 }, "expr": { "if": [{ ">": ["@v", 10] }, "a", { ">": ["@v", 4] }, "b", "c"] }, "result": "b" },
  { "name": "if without an else has no value", "scope": { "v": 1 }, "expr": { "if": [{ ">": ["@v", 2] }, "big"] }, "result": null },
  { "name": "false values of if: 0, the empty text, null, empty lists", "scope": { "z": 0, "e": "", "l": [] }, "expr": [{ "if": ["@z", 1, 2] }, { "if": ["@e", 1, 2] }, { "if": ["@n", 1, 2] }, { "if": ["@l", 1, 2] }, { "if": ["0", 1, 2] }], "result": [2, 2, 2, 2, 1] },
  { "name": "and is the first false value or the last one", "scope": { "a": 1, "b": "x" }, "expr": [{ "and": ["@a", "@b"] }, { "and": ["@a", 0, "@b"] }], "result": ["x", 0] },
  { "name": "or is the first true value or the last one, e.g. a default", "scope": { "color": null }, "expr": [{ "or": ["@color", "black"] }, { "or": [0, ""] }], "result": ["black", ""] },
  { "name": "not", "scope": { "a": 0 }, "expr": [{ "not": "@a" }, { "not": [1] }], "result": [true, false] }
]
