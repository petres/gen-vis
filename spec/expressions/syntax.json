[
  { "name": "a reference", "text": "@a", "expr": "@a", "scope": { "a": "x" }, "result": "x" },
  { "name": "a reference of a name with modifiers, : and . are part of the name", "text": "@x:scaled", "expr": "@x:scaled", "scope": { "x:scaled": 120 }, "result": 120 },
  { "name": "a leading = is left out", "text": "=@a + 1", "expr": { "+": ["@a", 1] }, "scope": { "a": 2 }, "result": 3 },
  { "name": "an expression starting with a reference needs no =", "text": "@a + 1", "expr": { "+": ["@a", 1] }, "scope": { "a": 2 }, "result": 3 },
  { "name": "a number", "text": "=3", "expr": 3, "scope": {}, "result": 3 },
  { "name": "numbers as in JSON, with a fraction and an exponent", "text": "=[0.5, 1e3, 2.5E-2]", "expr": [0.5, 1000, 0.025], "scope": {}, "result": [0.5, 1000, 0.025] },
  { "name": "a negative number", "text": "=-14", "expr": -14, "scope": {}, "result": -14 },
  { "name": "a negative number as an operand", "text": "@x + -14", "expr": { "+": ["@x", -14] }, "scope": { "x": 100 }, "result": 86 },
  { "name": "the unary minus of a reference", "text": "=-@x", "expr": { "-": ["@x"] }, "scope": { "x": 3 }, "result": -3 },
  { "name": "the unary minus of an expression in parentheses, also of a number", "text": "=-(@x * 2) + -(5)", "expr": { "+": [{ "-": [{ "*": ["@x", 2] }] }, { "-": [5] }] }, "scope": { "x": 3 }, "result": -11 },
  { "name": "the unary minus binds tighter than *", "text": "=-@x * 2", "expr": { "*": [{ "-": ["@x"] }, 2] }, "scope": { "x": 3 }, "result": -6 },
  { "name": "a text in single quotes", "text": "='none'", "expr": "none", "scope": {}, "result": "none" },
  { "name": "a text in double quotes", "text": "=\"none\"", "expr": "none", "scope": {}, "result": "none" },
  { "name": "the escapes of texts: quotes, backslash, newline, tab, unicode", "text": "='it\\'s \\\"a\\\" \\\\ \\n\\t\\u00e9'", "expr": "it's \"a\" \\ \n\té", "scope": {}, "result": "it's \"a\" \\ \n\té" },
  { "name": "a text starting with @ is a literal, no reference", "text": "='@a'", "expr": { "literal": "@a" }, "scope": { "a": "x" }, "result": "@a" },
  { "name": "true, false and null", "text": "=[true, false, null]", "expr": [true, false, null], "scope": {}, "result": [true, false, null] },
  { "name": "* before +", "text": "@x * 2 + 1", "expr": { "+": [{ "*": ["@x", 2] }, 1] }, "scope": { "x": 3 }, "result": 7 },
  { "name": "parentheses", "text": "(@x + 1) * 2", "expr": { "*": [{ "+": ["@x", 1] }, 2] }, "scope": { "x": 3 }, "result": 8 },
  { "name": "a run of the same operator is one operator of all operands", "text": "=1 + 2 + 3", "expr": { "+": [1, 2, 3] }, "scope": {}, "result": 6 },
  { "name": "a run of -, the first operand minus the others", "text": "=10 - 4 - 1", "expr": { "-": [10, 4, 1] }, "scope": {}, "result": 5 },
  { "name": "mixed operators of a level nest from the left", "text": "=10 - 4 + 1", "expr": { "+": [{ "-": [10, 4] }, 1] }, "scope": {}, "result": 7 },
  { "name": "/ and * nest from the left", "text": "@a / 2 * 3", "expr": { "*": [{ "/": ["@a", 2] }, 3] }, "scope": { "a": 4 }, "result": 6 },
  { "name": "parentheses around a run keep its nesting", "text": "=(1 + 2) + 3", "expr": { "+": [{ "+": [1, 2] }, 3] }, "scope": {}, "result": 6 },
  { "name": "a - before a letter is part of the name", "text": "@stroke-width + 1", "expr": { "+": ["@stroke-width", 1] }, "scope": { "stroke-width": 2 }, "result": 3 },
  { "name": "a name of several dashes", "text": "@highlight-stroke-width", "expr": "@highlight-stroke-width", "scope": { "highlight-stroke-width": 4 }, "result": 4 },
  { "name": "a - before a digit is a minus", "text": "@a-1", "expr": { "-": ["@a", 1] }, "scope": { "a": 3 }, "result": 2 },
  { "name": "a - before a reference is a minus", "text": "@a-@b", "expr": { "-": ["@a", "@b"] }, "scope": { "a": 3, "b": 1 }, "result": 2 },
  { "name": "a - after a space is a minus", "text": "@a - @b", "expr": { "-": ["@a", "@b"] }, "scope": { "a": 3, "b": 1 }, "result": 2 },
  { "name": "a comparison", "text": "@value > 0", "expr": { ">": ["@value", 0] }, "scope": { "value": 10 }, "result": true },
  { "name": "== and != of texts", "text": "=[@type == 'gas', @type != 'gas']", "expr": [{ "==": ["@type", "gas"] }, { "!=": ["@type", "gas"] }], "scope": { "type": "gas" }, "result": [true, false] },
  { "name": "a chain of the same comparison is one operator of three operands", "text": "=0 < @x < 10", "expr": { "<": [0, "@x", 10] }, "scope": { "x": 5 }, "result": true },
  { "name": "a chain of == compares every pair of neighbours, also the third operand", "text": "=[@a == @b == @c, @a == @b == @a]", "expr": [{ "==": ["@a", "@b", "@c"] }, { "==": ["@a", "@b", "@a"] }], "scope": { "a": 1, "b": 1, "c": 2 }, "result": [false, true] },
  { "name": "a chain of != compares every pair of neighbours", "text": "=[@a != @b != @c, @a != @b != @a]", "expr": [{ "!=": ["@a", "@b", "@c"] }, { "!=": ["@a", "@b", "@a"] }], "scope": { "a": 1, "b": 2, "c": 2 }, "result": [false, true] },
  { "name": "a chain of <=", "text": "=0 <= @x <= 10", "expr": { "<=": [0, "@x", 10] }, "scope": { "x": 10 }, "result": true },
  { "name": "a chain of mixed <, <=, >, >= is the and of its runs, as in mathematics", "text": "=0 < @x <= 10", "expr": { "and": [{ "<": [0, "@x"] }, { "<=": ["@x", 10] }] }, "scope": { "x": 10 }, "result": true },
  { "name": "a mixed chain is false if one of its comparisons is", "text": "=[20 <= @x < 50, 20 <= @y < 50, 20 <= @z < 50]", "expr": [{ "and": [{ "<=": [20, "@x"] }, { "<": ["@x", 50] }] }, { "and": [{ "<=": [20, "@y"] }, { "<": ["@y", 50] }] }, { "and": [{ "<=": [20, "@z"] }, { "<": ["@z", 50] }] }], "scope": { "x": 20, "y": 50, "z": 19 }, "result": [true, false, false] },
  { "name": "a mixed chain keeps the runs of the same operator, the operand between two runs is in both", "text": "=0 < @a < @b <= 10 > @c", "expr": { "and": [{ "<": [0, "@a", "@b"] }, { "<=": ["@b", 10] }, { ">": [10, "@c"] }] }, "scope": { "a": 1, "b": 10, "c": 3 }, "result": true },
  { "name": "the operand between two comparisons of a mixed chain is an expression", "text": "=0 <= @a + @b < 10", "expr": { "and": [{ "<=": [0, { "+": ["@a", "@b"] }] }, { "<": [{ "+": ["@a", "@b"] }, 10] }] }, "scope": { "a": 4, "b": 5 }, "result": true },
  { "name": "a comparison of comparisons in parentheses is no chain", "text": "=(0 < @x) <= 10", "expr": { "<=": [{ "<": [0, "@x"] }, 10] }, "scope": { "x": 5 }, "result": false },
  { "name": "a comparison of a comparison with == in parentheses", "text": "=(@a < @b) == (@c < @d)", "expr": { "==": [{ "<": ["@a", "@b"] }, { "<": ["@c", "@d"] }] }, "scope": { "a": 1, "b": 2, "c": 3, "d": 4 }, "result": true },
  { "name": "comparisons bind looser than arithmetic", "text": "@a + 1 > @b * 2", "expr": { ">": [{ "+": ["@a", 1] }, { "*": ["@b", 2] }] }, "scope": { "a": 5, "b": 2 }, "result": true },
  { "name": "and and or, and binds tighter", "text": "@a and @b or @c", "expr": { "or": [{ "and": ["@a", "@b"] }, "@c"] }, "scope": { "a": 1, "b": 0, "c": "x" }, "result": "x" },
  { "name": "a run of or is one operator", "text": "@a or @b or 'black'", "expr": { "or": ["@a", "@b", "black"] }, "scope": {}, "result": "black" },
  { "name": "or in parentheses before and", "text": "(@a or @b) and @c", "expr": { "and": [{ "or": ["@a", "@b"] }, "@c"] }, "scope": { "a": 1, "c": 2 }, "result": 2 },
  { "name": "not binds tighter than and, looser than a comparison", "text": "not @a == 1 and @b", "expr": { "and": [{ "not": [{ "==": ["@a", 1] }] }, "@b"] }, "scope": { "a": 2, "b": "x" }, "result": "x" },
  { "name": "not of not", "text": "not not @a", "expr": { "not": [{ "not": ["@a"] }] }, "scope": { "a": 0 }, "result": false },
  { "name": "not( without a space is a call", "text": "not(@a) == false", "expr": { "==": [{ "not": ["@a"] }, false] }, "scope": { "a": 1 }, "result": true },
  { "name": "the ternary is an if of three arguments", "text": "@v > 2 ? 'big' : 'small'", "expr": { "if": [{ ">": ["@v", 2] }, "big", "small"] }, "scope": { "v": 3 }, "result": "big" },
  { "name": "the else of a ternary may be another one", "text": "@v > 10 ? 'a' : @v > 4 ? 'b' : 'c'", "expr": { "if": [{ ">": ["@v", 10] }, "a", { "if": [{ ">": ["@v", 4] }, "b", "c"] }] }, "scope": { "v": 5 }, "result": "b" },
  { "name": "the ternary binds loosest", "text": "@a or @b ? 1 + 1 : 0", "expr": { "if": [{ "or": ["@a", "@b"] }, { "+": [1, 1] }, 0] }, "scope": { "a": 0, "b": 1 }, "result": 2 },
  { "name": "if of several conditions is a call", "text": "if(@v > 10, 'a', @v > 4, 'b', 'c')", "expr": { "if": [{ ">": ["@v", 10] }, "a", { ">": ["@v", 4] }, "b", "c"] }, "scope": { "v": 5 }, "result": "b" },
  { "name": "min and max", "text": "min(@a, 1, 2) + max(@a, 1, 2)", "expr": { "+": [{ "min": ["@a", 1, 2] }, { "max": ["@a", 1, 2] }] }, "scope": { "a": 3 }, "result": 4 },
  { "name": "round", "text": "round(@v, 2)", "expr": { "round": ["@v", 2] }, "scope": { "v": 3.14159 }, "result": 3.14 },
  { "name": "cat", "text": "cat(@name, ': ', @v)", "expr": { "cat": ["@name", ": ", "@v"] }, "scope": { "name": "Wien", "v": 3 }, "result": "Wien: 3" },
  { "name": "format", "text": "format(@y, ',.1f')", "expr": { "format": ["@y", ",.1f"] }, "scope": { "y": 1234.567 }, "result": "1,234.6" },
  { "name": "steps of a table, the keys are numbers", "text": "steps(@totalWidth, {0: 220, 550: 250})", "expr": { "steps": ["@totalWidth", { "0": 220, "550": 250 }] }, "scope": { "totalWidth": 600 }, "result": 250 },
  { "name": "the keys of a table may be negative and decimal", "text": "steps(@v, {-1: 'a', 0.5: 'b', 10: 'c'})", "expr": { "steps": ["@v", { "-1": "a", "0.5": "b", "10": "c" }] }, "scope": { "v": 0.7 }, "result": "b" },
  { "name": "match of a table of words and a default, the values are expressions", "text": "match(@level, {header: 4.5, item: @r * 2}, 0)", "expr": { "match": ["@level", { "header": 4.5, "item": { "*": ["@r", 2] } }, 0] }, "scope": { "level": "item", "r": 2 }, "result": 4 },
  { "name": "the keys of a table may be quoted", "text": "match(@lang, {'de': 'Quelle', \"en\": 'Source'})", "expr": { "match": ["@lang", { "de": "Quelle", "en": "Source" }] }, "scope": { "lang": "de" }, "result": "Quelle" },
  { "name": "var of a name and a default", "text": "var('a', 0)", "expr": { "var": ["a", 0] }, "scope": {}, "result": 0 },
  { "name": "var of a name which is no name of the syntax", "text": "var('a b')", "expr": { "var": ["a b"] }, "scope": { "a b": 1 }, "result": 1 },
  { "name": "the first argument of var is a name, also starting with @", "text": "var('@a')", "expr": { "var": ["@a"] }, "scope": { "@a": 1 }, "result": 1 },
  { "name": "literal of an object of an operator, its argument is data", "text": "literal({'*': [1, 2]})", "expr": { "literal": { "*": [1, 2] } }, "scope": {}, "result": { "*": [1, 2] } },
  { "name": "in literal a text starting with @ is a text", "text": "literal(['@a', 'b'])", "expr": { "literal": ["@a", "b"] }, "scope": { "a": 1 }, "result": ["@a", "b"] },
  { "name": "a list of expressions", "text": "=[0, @height]", "expr": [0, "@height"], "scope": { "height": 300 }, "result": [0, 300] },
  { "name": "an empty list and an empty object", "text": "=[[], {}]", "expr": [[], {}], "scope": {}, "result": [[], {}] },
  { "name": "an object is a nested prop", "text": "={d: {x: @a, y: 2}, fill: 'red'}", "expr": { "d": { "x": "@a", "y": 2 }, "fill": "red" }, "scope": { "a": 1 }, "result": { "d": { "x": 1, "y": 2 }, "fill": "red" } },
  { "name": "an object of one key which is an operator is that operator, as in JSON", "text": "={min: [@a, 1]}", "expr": { "min": ["@a", 1] }, "scope": { "a": 3 }, "result": 1 },
  { "name": "and and or as calls", "text": "and(@a, or(@b, 'x'))", "expr": { "and": ["@a", { "or": ["@b", "x"]}] }, "scope": { "a": 1 }, "result": "x" },
  { "name": "whitespace, also newlines, between the tokens", "text": "=\n  @a\t+ 1\n", "expr": { "+": ["@a", 1] }, "scope": { "a": 1 }, "result": 2 },
  { "name": "a name of other scripts", "text": "@größe + @値", "expr": { "+": ["@größe", "@値"] }, "scope": { "größe": 1, "値": 2 }, "result": 3 },
  { "name": "error: an operator without its right operand", "text": "@a +", "error": "expression \"@a +\": unexpected end at 4" },
  { "name": "error: an empty expression", "text": "=", "error": "expression \"=\": unexpected end at 1" },
  { "name": "error: text after the expression", "text": "@a @b", "error": "expression \"@a @b\": unexpected \"@b\" at 3" },
  { "name": "error: a word is no reference", "text": "=a + 1", "error": "expression \"=a + 1\": unknown word \"a\", a reference is \"@a\" at 1" },
  { "name": "error: == in a chain of other comparisons", "text": "=@a == @b < 3", "error": "expression \"=@a == @b < 3\": \"<\" after \"==\" is no chain, write \"and\" or parentheses at 10" },
  { "name": "error: != after another comparison", "text": "=1 < @a != @b", "error": "expression \"=1 < @a != @b\": \"!=\" after \"<\" is no chain, write \"and\" or parentheses at 8" },
  { "name": "error: an unknown function", "text": "=abs(@a)", "error": "expression \"=abs(@a)\": unknown function \"abs\" at 1" },
  { "name": "error: a parenthesis is not closed", "text": "=(@a + 1", "error": "expression \"=(@a + 1\": unexpected end at 8" },
  { "name": "error: a missing comma", "text": "min(1 2)", "error": "expression \"min(1 2)\": expected \")\", not \"2\" at 6" },
  { "name": "error: @ without a name", "text": "=@ + 1", "error": "expression \"=@ + 1\": expected a name after \"@\" at 2" },
  { "name": "error: a text is not closed", "text": "='abc", "error": "expression \"='abc\": unterminated text at 1" },
  { "name": "error: an unknown escape", "text": "='a\\x'", "error": "expression \"='a\\\\x'\": unknown escape \"\\x\" at 3" },
  { "name": "error: a ternary without its else", "text": "@a ? 1", "error": "expression \"@a ? 1\": unexpected end at 6" },
  { "name": "error: + is no function", "text": "=+(1, 2)", "error": "expression \"=+(1, 2)\": unexpected \"+\" at 1" },
  { "name": "error: literal takes one argument", "text": "literal(1, 2)", "error": "expression \"literal(1, 2)\": expected one argument of literal at 0" },
  { "name": "error: an unexpected character", "text": "@a § 1", "error": "expression \"@a § 1\": unexpected character \"§\" at 3" }
]
