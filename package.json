{
  "name": "@preschen/gen-vis",
  "version": "2.0.0-alpha.1",
  "description": "A declarative d3 visualisation library",
  "type": "module",
  "main": "dist/gen-vis.js",
  "module": "dist/gen-vis.js",
  "exports": {
    ".": "./dist/gen-vis.js",
    "./check": "./dist/check.js",
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "lib": "vite build --mode lib",
    "site": "npm run build && vite --config site/vite.config.js",
    "site:build": "npm run build && vite build --config site/vite.config.js",
    "test": "vitest run",
    "upload": "[ -f .env ] && . ./.env; rsync -arv dist-lib/ \"${GEN_VIS_UPLOAD:?set GEN_VIS_UPLOAD=user@host:/path in .env}\"",
    "deploy": "npm run lib && npm run upload",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petres/gen-vis.git"
  },
  "license": "MIT",
  "author": {
    "name": "Peter Reschenhofer",
    "email": "peter@abteil.org"
  },
  "bugs": {
    "url": "https://github.com/petres/gen-vis/issues"
  },
  "homepage": "https://github.com/petres/gen-vis",
  "peerDependencies": {
    "vue": "^3"
  },
  "dependencies": {
    "d3-array": "^3",
    "d3-axis": "^3",
    "d3-dsv": "^3",
    "d3-format": "^3",
    "d3-geo": "^3",
    "d3-scale": "^4",
    "d3-scale-chromatic": "^3",
    "d3-selection": "^3",
    "d3-shape": "^3",
    "d3-time": "^3",
    "d3-time-format": "^4",
    "d3-transition": "^3",
    "deepmerge": "^4",
    "hyparquet": "^1",
    "hyparquet-compressors": "^1",
    "modern-screenshot": "^4.7.0",
    "topojson-client": "^3"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@vitejs/plugin-vue": "^6.0.9",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "hyparquet-writer": "^0.16.10",
    "jsdom": "^30.1.1",
    "sass": "^1.105.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  }
}
