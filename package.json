{
  "name": "@preschen/gen-vis",
  "version": "0.5.0",
  "description": "A declarative d3 visualisation library",
  "type": "module",
  "main": "dist/gen-vis.js",
  "module": "dist/gen-vis.js",
  "exports": {
    ".": "./dist/gen-vis.js",
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "lib": "vite build --mode lib",
    "test": "vitest run",
    "upload": "rsync -arv dist-lib/ preschen@hades.wsr.ac.at:/usr/local/www/datascience/htdocs/gen-vis",
    "deploy": "npm run lib && npm run upload",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petres/gen-vis.git"
  },
  "author": {
    "name": "Peter Reschenhofer",
    "email": "peter@abteil.org"
  },
  "bugs": {
    "url": "https://github.com/petres/gen-vis/issues"
  },
  "homepage": "https://github.com/petres/gen-vis",
  "peerDependencies": {
    "vue": "^3"
  },
  "dependencies": {
    "d3": "^7",
    "deepmerge": "^4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.1",
    "sass": "^1.105.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  }
}
