{
  "name": "@preschen/gen-vis",
  "version": "5.0.0-alpha.2",
  "description": "A declarative d3 visualisation library: a JSON definition and a data file describe a chart",
  "type": "module",
  "main": "dist/gen-vis.js",
  "module": "dist/gen-vis.js",
  "types": "./types/index.d.ts",
  "unpkg": "dist-lib/esm/gen-vis.js",
  "jsdelivr": "dist-lib/esm/gen-vis.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/gen-vis.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./check": {
      "types": "./types/check.d.ts",
      "default": "./dist/check.js"
    },
    "./schema.json": "./schema.json",
    "./esm": {
      "types": "./types/esm.d.ts",
      "default": "./dist-lib/esm/gen-vis.js"
    },
    "./export.html": "./dist-lib/export.html",
    "./inter.css": "./dist-lib/esm/chunks/fonts/inter.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "gen-vis": "bin/gen-vis.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-lib/esm",
    "dist-lib/export.html",
    "types",
    "schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "lib": "vite build --mode module",
    "site": "npm run build && npm run lib && vite --config site/vite.config.js",
    "site:build": "npm run build && npm run lib && vite build --config site/vite.config.js",
    "test": "vitest run",
    "test:png": "vitest run tests/png.test.js",
    "schema": "node scripts/schema.js && node scripts/types.js && node scripts/reference.js",
    "types": "node scripts/types.js",
    "upload": "[ -f .env ] && . ./.env; node scripts/compress.js && rsync -arv dist-lib/ \"${GEN_VIS_UPLOAD:?set GEN_VIS_UPLOAD=user@host:/path in .env}\"",
    "deploy": "npm run lib && npm run upload",
    "prepublishOnly": "npm test && npm run build && npm run lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petres/gen-vis.git"
  },
  "keywords": [
    "d3",
    "vue",
    "chart",
    "charts",
    "visualization",
    "declarative",
    "json",
    "svg",
    "map",
    "choropleth",
    "polar",
    "radar",
    "parquet"
  ],
  "license": "MIT",
  "author": {
    "name": "Peter Reschenhofer",
    "email": "peter@abteil.org"
  },
  "bugs": {
    "url": "https://github.com/petres/gen-vis/issues"
  },
  "homepage": "https://petres.github.io/gen-vis/",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "d3-array": "^3",
    "d3-dsv": "^3",
    "d3-format": "^3",
    "d3-geo": "^3",
    "d3-interpolate": "^3",
    "d3-scale": "^4",
    "d3-scale-chromatic": "^3",
    "d3-shape": "^3",
    "d3-time": "^3",
    "d3-time-format": "^4",
    "fzstd": "^0.1.1",
    "hyparquet": "^1",
    "hyparquet-compressors": "^1",
    "topojson-client": "^3"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@fontsource/inter": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "hyparquet-writer": "^0.16.10",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  }
}
