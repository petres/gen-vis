{
    "data": "data/fuel-prices.csv",
    "options": {
        "title": "Fuel prices in Austria nearly doubled in 18 months",
        "subtitle": "Average pump price, weekly, in euros per litre",
        "footer": "Source: spritpreisrechner.at, weekly means of the daily prices",
        "locale": { "base": "en", "number": { "currency": ["€", ""] } },
        "height": 340,
        "margins": { "top": 16, "right": 64, "bottom": 32, "left": 44 }
    },
    "mapping": {
        "x": {
            "column": "week",
            "type": "date",
            "scale": { "type": "utc", "orientation": "horizontal" },
            "axis": { "position": "bottom", "ticks": { "prop": "relative", "ref": "innerWidth", "ratio": 0.009 }, "format": "%b %Y" },
            "hover": { "format": "%b %-d, %Y" }
        },
        "y": {
            "column": "price",
            "type": "numeric",
            "scale": { "type": "linear", "orientation": "vertical", "domain": [0.8, 2.2] },
            "axis": { "position": "left", "ticks": 7, "grid": true, "format": "$.2f" },
            "hover": { "format": "$.3f" }
        },
        "fuel": {
            "column": "fuel",
            "type": "categorical",
            "legend": {
                "symbol": {
                    "size": 18,
                    "elements": [{ "type": "line", "props": { "x1": 0, "x2": 18, "y1": 9, "y2": 9, "stroke": "@color", "stroke-width": 3 } }]
                }
            },
            "props": {
                "categories": {
                    "diesel": { "name": "Diesel", "color": "#C0392B" },
                    "petrol": { "name": "Petrol", "color": "#2563A8" }
                }
            },
            "hover": {}
        }
    },
    "annotations": [
        { "type": "band", "x": ["2022-02-24", null], "label": "War in Ukraine", "props": { "fill": "#F3EFE6" } },
        { "type": "line", "y": 2, "props": { "stroke": "#121212", "stroke-dasharray": "2 3" } },
        { "type": "text", "x": "2021-01-15", "y": 2, "text": "€2 per litre", "props": { "dy": -6, "font-size": 12, "font-style": "italic" } }
    ],
    "plot": [
        {
            "type": "cartesian:line",
            "categories": ["fuel"],
            "curve": "monotoneX",
            "props": {
                "d": { "x": "@x:scaled", "y": "@y:scaled" },
                "stroke": "@color",
                "stroke-width": 2.5,
                "fill": "none",
                "highlight-stroke-width": 3.5
            }
        },
        {
            "type": "svg:circle",
            "categories": ["fuel"],
            "select": "last",
            "props": { "cx": "@x:scaled", "cy": "@y:scaled", "r": 4, "fill": "@color", "stroke": "white", "stroke-width": 2 }
        },
        {
            "type": "svg:text",
            "categories": ["fuel"],
            "select": "last",
            "dodge": 16,
            "layer": "above",
            "props": {
                "x": "@x:scaled", "y": "@y:scaled", "dx": 9, "dominant-baseline": "middle",
                "text": "@name", "fill": "@color", "font-size": 13, "font-weight": "bold"
            }
        }
    ]
}
