{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data/fuel-prices.csv",
    "title": "Fuel prices in Austria nearly doubled in 18 months",
    "subtitle": "Average pump price, weekly, in euros per litre",
    "source": "Source: spritpreisrechner.at, weekly means of the daily prices",
    "height": 340,
    "margins": {"right": 64},
    "locale": {"base": "en", "number": {"currency": ["€", ""]}},
    "dims": {
        "x": {
            "column": "week",
            "scale": {"type": "utc"},
            "axis": {"ticks": "@innerWidth * 0.009", "format": "%b %Y"},
            "hover": {"format": "%b %-d, %Y"}
        },
        "y": {
            "column": "price",
            "nice": true,
            "scale": {"include": 2},
            "axis": {"ticks": 7, "format": "$.2f"},
            "hover": {"format": "$.3f"},
            "grid": true
        },
        "fuel": {
            "column": "fuel",
            "legend": {
                "symbol": {
                    "size": 18,
                    "elements": [
                        {
                            "type": "line",
                            "props": {
                                "x1": 0,
                                "x2": 18,
                                "y1": 9,
                                "y2": 9,
                                "stroke": "@color",
                                "stroke-width": 3
                            }
                        }
                    ]
                }
            },
            "categories": {
                "diesel": {"name": "Diesel", "color": "#C0392B"},
                "petrol": {"name": "Petrol", "color": "#2563A8"}
            },
            "hover": {}
        }
    },
    "marks": [
        {
            "type": "line",
            "by": "fuel",
            "curve": "monotoneX",
            "stroke-width": 2.5,
            "highlight": {"stroke-width": 3.5},
            "others": {"stroke-opacity": 0.25}
        },
        {
            "type": "point",
            "by": "fuel",
            "select": "last",
            "r": 4,
            "fill": "@color",
            "stroke": "white",
            "stroke-width": 2,
            "highlight": {"r": 5},
            "others": {"opacity": 0.25}
        },
        {
            "type": "text",
            "by": "fuel",
            "select": "last",
            "dodge": 16,
            "layer": "above",
            "dx": 9,
            "dominant-baseline": "middle",
            "text": "@name",
            "font-size": 13,
            "font-weight": "bold",
            "highlight": {"font-size": 14},
            "others": {"opacity": 0.25}
        }
    ],
    "annotations": [
        {
            "type": "band",
            "x": ["2022-02-24", null],
            "label": "War in Ukraine",
            "props": {"fill": "#F3EFE6"}
        },
        {"type": "line", "y": 2, "props": {"stroke": "#121212", "stroke-dasharray": "2 3"}},
        {
            "type": "text",
            "x": "2021-01-15",
            "y": 2,
            "text": "€2 per litre",
            "props": {"dy": -6, "font-size": 12, "font-style": "italic"}
        }
    ]
}
