{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data/electricity.csv",
    "title": "Where Europe's electricity comes from",
    "subtitle": "Share of a source in the electricity generated in each country, by year (2026: year to date)",
    "source": "Source: ENTSO-E Transparency Platform · Boundaries © EuroGeographics",
    "height": "=steps(@totalWidth, {0: 380, 560: 500})",
    "coord": "geo",
    "locale": "en",
    "transition": 400,
    "hover": {"position": "pointer", "side": "above", "offset": [0, -4]},
    "globals": {"source": "renewable", "year": "2025"},
    "controls": [
        {
            "type": "radio",
            "global": "source",
            "name": "Source",
            "id": "source",
            "values": [
                {"id": "renewable", "name": "Renewables", "value": "renewable"},
                {"id": "nuclear", "name": "Nuclear", "value": "nuclear"},
                {"id": "fossil", "name": "Fossil", "value": "non-renewable"}
            ]
        },
        {
            "type": "slider",
            "global": "year",
            "name": "Year",
            "id": "year",
            "values": {"column": "year"}
        }
    ],
    "filter": {"source": "@globals.source", "year": "@globals.year"},
    "dims": {
        "country": "country",
        "source": "source",
        "year": {"column": "year", "type": "categorical"},
        "share": {
            "name": "Share of {source:name}",
            "column": "share",
            "domain": [0.2, 0.4, 0.6, 0.8],
            "scale": {
                "type": "threshold",
                "range": "=match(@source, {nuclear: literal(['#E4DDF4', '#B8A6E3', '#8C70CC', '#6247AD', '#3B2A7C']), 'non-renewable': literal(['#EEDCC4', '#D6AE80', '#B07A47', '#875529', '#5C3714'])}, literal(['#D5EBC6', '#9ED08F', '#5FAF6E', '#2A7D55', '#11573C']))"
            },
            "legend": {
                "format": ".0%",
                "orientation": "=steps(@totalWidth, {0: 'horizontal', 560: 'vertical'})",
                "position": "=steps(@totalWidth, {0: 'top', 560: 'right'})",
                "size": 180,
                "missing": {"name": "No data", "color": "#E9E4DA"},
                "symbol": null
            },
            "hover": {"format": ".1%"}
        }
    },
    "marks": [
        {"type": "base", "fill": "#E9E4DA", "stroke": "#FFFFFF", "stroke-width": 0.6},
        {
            "type": "region",
            "by": "country",
            "fill": "@share:scaled",
            "stroke": "#FFFFFF",
            "stroke-width": 0.6,
            "highlight": {"stroke": "#0B2B26", "stroke-width": 1.6}
        }
    ],
    "geo": {
        "data": "data/europe.json",
        "key": "id",
        "join": "country",
        "fit": "data",
        "projection": {"type": "azimuthalEqualArea", "rotate": [-10, -52]}
    }
}
