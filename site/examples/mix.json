{
    "$schema": "https://unpkg.com/@preschen/gen-vis@5/schema.json",
    "data": "data/electricity.csv",
    "transform": [
        {
            "type": "lookup",
            "column": "country",
            "data": "data/countries.csv",
            "key": "code",
            "value": "name",
            "as": "name"
        },
        {
            "type": "lookup",
            "column": "country",
            "data": "data/countries.csv",
            "key": "code",
            "value": "region",
            "as": "region"
        }
    ],
    "title": "Where the electricity comes from",
    "subtitle": "Share of the generation of electricity per country, by region and source",
    "source": "Source: Ember, yearly electricity data",
    "height": 118,
    "locale": "en",
    "dims": {
        "x": {
            "column": "year",
            "type": "numeric",
            "format": "d",
            "scale": {"pad": 0},
            "axis": {"values": [2019, 2022, 2025], "tickMarks": false}
        },
        "y": {
            "column": "share",
            "type": "numeric",
            "format": ".0%",
            "domain": [0, 1],
            "axis": {"values": [0, 0.5, 1]},
            "hover": {},
            "grid": true
        },
        "country": {"column": "name", "name": "Country", "fromData": true, "hover": {}},
        "source": {
            "column": "source",
            "categories": {
                "renewable": {"name": "Renewable", "color": "#2F855A"},
                "nuclear": {"name": "Nuclear", "color": "#B7791F"},
                "non-renewable": {"name": "Fossil and other", "color": "#4A5568"}
            }
        },
        "region": {
            "column": "region",
            "categories": {
                "Northern Europe": {},
                "Western Europe": {},
                "Southern Europe": {},
                "Eastern Europe": {},
                "Western Balkans": {}
            }
        }
    },
    "marks": [
        {
            "type": "line",
            "id": "countries",
            "by": ["country", "source"],
            "stroke-width": 1.2,
            "opacity": 0.55,
            "highlight": {"opacity": 1, "stroke-width": 2.6},
            "others": {"opacity": 0.12}
        }
    ],
    "facets": {
        "by": {"rows": "region", "cols": "source"},
        "scales": {"x": "all", "y": "all"},
        "rowHeaders": {"side": "left", "vertical": true},
        "axisTitles": "outer",
        "title": {"props": {"color": "@color"}}
    }
}
