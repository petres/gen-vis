{
    "$schema": "https://unpkg.com/@preschen/gen-vis@4/schema.json",
    "data": "data/temperature.csv",
    "options": {
        "coord": "polar",
        "language": "@lang",
        "title": { "de": "Ein Jahr im Kreis", "en": "A year in a circle" },
        "subtitle": {
            "de": "Temperatur in Österreich, gewichtet nach Bevölkerung, gleitender 4-Wochen-Durchschnitt, in °C",
            "en": "Temperature in Austria, weighted by population, rolling 4-week mean, in °C"
        },
        "footer": { "de": "Quelle: ERA5, Copernicus Climate Change Service", "en": "Source: ERA5, Copernicus Climate Change Service" },
        "height": 470,
        "margins": { "top": 34, "right": 34, "bottom": 34, "left": 34 }
    },
    "globals": { "lang": "de" },
    "formElements": [
        {
            "id": "lang",
            "name": "Sprache · Language",
            "ref": "lang",
            "type": "radio",
            "inImage": false,
            "values": [
                { "id": "de", "name": "Deutsch", "value": "de" },
                { "id": "en", "name": "English", "value": "en" }
            ]
        }
    ],
    "mapping": {
        "x": {
            "column": "day",
            "domain": ["2020-01-01", "2021-01-01"],
            "scale": { "type": "utc" },
            "axis": { "ticks": 12, "format": "%b", "grid": true },
            "hover": { "format": { "de": "%-d. %B", "en": "%B %-d" } }
        },
        "y": {
            "column": "temperature",
            "domain": [-5, 25],
            "scale": { "range": [28, "@radius"] },
            "axis": { "angle": 20, "values": [10, 20], "grid": true, "format": "d" },
            "hover": { "format": ",.1f" }
        },
        "year": {
            "column": "year",
            "name": { "de": "Jahr", "en": "Year" },
            "legend": {
                "symbol": {
                    "size": 18,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 18, "y1": 9, "y2": 9,
                            "stroke": "@color", "stroke-width": 3, "opacity": "@opacity", "stroke-dasharray": "@dash"
                        }
                    }]
                }
            },
            "common": { "color": "#0078BF", "width": 1.5 },
            "categories": {
                "2019": { "opacity": 0.25 },
                "2020": { "opacity": 0.3 },
                "2021": { "opacity": 0.35 },
                "2022": { "opacity": 0.45 },
                "2023": { "opacity": 0.55 },
                "2024": { "opacity": 0.65 },
                "2025": { "opacity": 0.75 },
                "2026": { "color": "#E4572E", "opacity": 1, "width": 3.5 },
                "1991–2020": { "name": { "de": "Ø 1991–2020", "en": "Mean 1991–2020" }, "color": "#1B1B1B", "dash": "4 3", "opacity": 1, "width": 2 }
            },
            "hover": {}
        }
    },
    "annotations": [
        { "type": "band", "x": ["2020-06-01", "2020-09-01"], "label": { "de": "Sommer", "en": "Summer" }, "props": { "fill": "#FFE36E", "opacity": 0.45 } },
        { "type": "line", "y": 0, "label": "0 °C", "props": { "stroke": "#0078BF", "stroke-dasharray": "1 3" } }
    ],
    "plot": {
        "type": "line",
        "by": "year",
        "props": {
            "stroke": "@color",
            "stroke-width": "@width",
            "stroke-dasharray": "@dash",
            "opacity": "@opacity",
            "stroke-linecap": "round"
        },
        "highlight": { "opacity": 1, "stroke-width": 3.5 },
        "others": { "opacity": 0.1 }
    }
}
