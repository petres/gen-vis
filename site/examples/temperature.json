{
    "data": "data/temperature.csv",
    "options": {
        "coord": "polar",
        "title": "Ein Jahr im Kreis",
        "subtitle": "Temperatur in Österreich, gewichtet nach Bevölkerung, gleitender 4-Wochen-Durchschnitt, in °C",
        "footer": "Quelle: ERA5, Copernicus Climate Change Service",
        "locale": "de",
        "height": 470,
        "margins": { "top": 34, "right": 34, "bottom": 34, "left": 34 }
    },
    "globals": { "lang": "de", "summer": "Sommer" },
    "formElements": [
        {
            "id": "lang",
            "name": "Sprache · Language",
            "ref": "lang",
            "type": "radio",
            "inImage": false,
            "values": [
                { "id": "de", "name": "Deutsch", "value": "de", "globals": { "summer": "Sommer" } },
                {
                    "id": "en",
                    "name": "English",
                    "value": "en",
                    "globals": { "summer": "Summer" },
                    "patch": {
                        "options": {
                            "title": "A year in a circle",
                            "subtitle": "Temperature in Austria, weighted by population, rolling 4-week mean, in °C",
                            "footer": "Source: ERA5, Copernicus Climate Change Service",
                            "locale": "en"
                        },
                        "mapping": {
                            "x": { "hover": { "format": "%B %-d" } },
                            "year": { "name": "Year", "categories": { "1991–2020": { "name": "Mean 1991–2020" } } }
                        }
                    }
                }
            ]
        }
    ],
    "mapping": {
        "x": {
            "column": "day",
            "type": "date",
            "scale": { "type": "utc", "orientation": "angular", "domain": ["2020-01-01", "2021-01-01"] },
            "axis": { "position": "angular", "ticks": 12, "format": "%b", "grid": true },
            "hover": { "format": "%-d. %B" }
        },
        "y": {
            "column": "temperature",
            "type": "numeric",
            "scale": { "type": "linear", "orientation": "radial", "domain": [-5, 25], "range": [28, "@radius"] },
            "axis": { "position": "radial", "angle": 20, "values": [10, 20], "grid": true, "format": "d" },
            "hover": { "format": ",.1f" }
        },
        "year": {
            "column": "year",
            "type": "categorical",
            "name": "Jahr",
            "legend": {
                "symbol": {
                    "size": 18,
                    "elements": [{
                        "type": "line",
                        "props": {
                            "x1": 0, "x2": 18, "y1": 9, "y2": 9,
                            "stroke": "@color", "stroke-width": 3, "opacity": "@opacity", "stroke-dasharray": "@dash"
                        }
                    }]
                }
            },
            "common": { "color": "#0078BF", "width": 1.5 },
            "categories": {
                "2019": { "opacity": 0.25 },
                "2020": { "opacity": 0.3 },
                "2021": { "opacity": 0.35 },
                "2022": { "opacity": 0.45 },
                "2023": { "opacity": 0.55 },
                "2024": { "opacity": 0.65 },
                "2025": { "opacity": 0.75 },
                "2026": { "color": "#E4572E", "opacity": 1, "width": 3.5 },
                "1991–2020": { "name": "Ø 1991–2020", "color": "#1B1B1B", "dash": "4 3", "opacity": 1, "width": 2 }
            },
            "hover": {}
        }
    },
    "annotations": [
        { "type": "band", "x": ["2020-06-01", "2020-09-01"], "label": "{summer}", "props": { "fill": "#FFE36E", "opacity": 0.45 } },
        { "type": "line", "y": 0, "label": "0 °C", "props": { "stroke": "#0078BF", "stroke-dasharray": "1 3" } }
    ],
    "plot": {
        "type": "polar:line",
        "by": "year",
        "props": {
            "d": { "angle": "@x:scaled", "radius": "@y:scaled" },
            "stroke": "@color",
            "stroke-width": "@width",
            "stroke-dasharray": "@dash",
            "opacity": "@opacity",
            "fill": "none",
            "stroke-linecap": "round"
        },
        "highlight": { "opacity": 1, "stroke-width": 3.5 },
        "others": { "opacity": 0.1 }
    }
}
