{
    "data": "../data/fossil.csv",
    "options": {
        "title": "The seasons of fossil fuels",
        "subtitle": "Monthly sales in Austria in {unit:name}, a line per year",
        "footer": "Source: Eurostat, calculations of the WIFO energy dashboard",
        "locale": "en",
        "height": { "steps": ["@totalWidth", { "0": 170, "500": 230 }] },
        "margins": { "top": 8, "right": 12, "bottom": 26, "left": 36 },
        "transition": 300
    },
    "transform": [
        { "type": "year", "column": "date", "as": "year" },
        { "type": "align", "column": "date", "as": "month" }
    ],
    "globals": { "unit": "twh", "scales": ["x"] },
    "formElements": [
        {
            "id": "unit", "name": "Unit", "ref": "unit", "type": "radio",
            "values": [
                { "id": "twh", "name": "TWh", "value": "twh" },
                { "id": "co2", "name": "Mt CO₂", "value": "mt.co2" }
            ]
        },
        {
            "id": "scales", "name": "Scale", "ref": "scales", "type": "radio", "inImage": false,
            "values": [
                { "id": "own", "name": "Per product", "value": ["x"] },
                { "id": "shared", "name": "Shared", "value": ["x", "y"] }
            ]
        }
    ],
    "facets": {
        "dim": "product",
        "cols": { "steps": ["@totalWidth", { "0": 1, "500": 3 }] },
        "scales": "@scales"
    },
    "mapping": {
        "x": {
            "column": "month", "type": "date",
            "scale": { "type": "utc", "orientation": "horizontal", "domain": ["2020-01-01", "2020-12-01"], "inset": 4 },
            "axis": { "position": "bottom", "values": ["2020-01-01", "2020-04-01", "2020-07-01", "2020-10-01"], "format": "%b" },
            "hover": { "format": "%B" }
        },
        "y": {
            "column": "{unit}", "type": "numeric",
            "scale": { "type": "linear", "orientation": "vertical", "include": 0, "nice": true },
            "axis": { "position": "left", "ticks": 4, "grid": true, "format": ",.0f" },
            "hover": { "format": ",.2f" }
        },
        "product": { "column": "product", "type": "categorical", "categories": { "oil": { "name": "Oil" }, "gas": { "name": "Gas" }, "coal": { "name": "Coal" } } },
        "year": {
            "column": "year",
            "type": "categorical",
            "name": "Year",
            "legend": { "symbol": "line" },
            "hover": {},
            "fromData": true,
            "order": "descending",
            "ranks": [
                { "color": "#C2410C", "width": 3, "label": "visible" },
                { "color": "#0F766E", "width": 2, "label": "hidden" },
                { "color": "#94A3B8", "width": 1.2, "label": "hidden" }
            ]
        }
    },
    "plot": [
        {
            "id": "lines",
            "type": "cartesian:line",
            "by": "year",
            "curve": "monotoneX",
            "props": {
                "d": { "x": "@x:scaled", "y": "@y:scaled" },
                "stroke": "@color",
                "stroke-width": "@width",
                "fill": "none"
            },
            "highlight": { "stroke-width": 3.5 },
            "others": { "stroke-opacity": 0.25 }
        },
        {
            "id": "labels",
            "type": "svg:text",
            "by": "year",
            "select": "last",
            "props": {
                "x": "@x:scaled", "y": "@y:scaled", "dy": -8, "text-anchor": "end", "font-size": 11, "font-weight": "bold",
                "fill": "@color", "text": "@year", "visibility": "@label"
            }
        }
    ]
}
